{
  "name": "hireriv",
  "version": "1.0.0",
  "description": "Hireriv - tech-driven staffing & recruitment solutions website",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:env": "node --env-file=.env server.js",
    "test": "node --test test/*.test.js",
    "pg:migrate": "node --env-file-if-exists=.env db/postgres/migrate.js",
    "check:config": "node --env-file-if-exists=.env config-check.js",
    "backup:restore-test": "node --env-file-if-exists=.env backups.js",
    "backup:restore-uploads": "node --env-file-if-exists=.env backups.js restore-uploads",
    "sms:test": "node --env-file-if-exists=.env sms.js",
    "load:test": "node scripts/load-test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@resvg/resvg-wasm": "2.6.2",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4"
  }
}
