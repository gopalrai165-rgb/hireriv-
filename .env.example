# Copy to .env and fill in, then run: npm run start:env
# (or set these in your host's dashboard). Never commit the real .env.
# Check it with `npm run check:config`: with NODE_ENV=production the server
# refuses to start while a blocking problem is listed (docs/LAUNCH.md).

# Your live address, with https://
SITE_URL=https://hireriv.com
PORT=3004
NODE_ENV=production

# Admin panel login (username defaults to "admin")
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-long-password
# Only if the owner lost both their authenticator phone and recovery codes:
# set to 1 for one start to remove the owner's two-step sign-in, then remove it.
# RESET_OWNER_2FA=1

# Email (e.g. Gmail with an App Password, Zoho, Resend SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
MAIL_FROM="Hireriv" <jobs@hireriv.com>
NOTIFY_EMAIL=recruiters@hireriv.com

# Optional: delivery reports from your email provider (delivered, bounced,
# complaints) POSTed to /webhooks/email, signed with this secret (see README).
# Leave unset to turn the webhook off.
# EMAIL_WEBHOOK_SECRET=a-long-random-string
# Set to "off" to stop this server sending queued notification emails (e.g. a
# second copy of the app that shares the database). Leave unset normally.
# NOTIFY_WORKER=off

# Set to 1 when running behind a reverse proxy / load balancer (Nginx, Render, etc.)
TRUST_PROXY=1

# Optional: where the database and resumes are stored (use a persistent disk)
# DB_FILE=/var/lib/hireriv/hireriv.db
# UPLOADS_DIR=/var/lib/hireriv/uploads
# BACKUP_DIR=/mnt/backup-disk/hireriv   (daily database backups; defaults to a "backups" folder next to the database)

# Monitoring: a heartbeat URL from an outside monitor (Healthchecks.io, Better Stack,
# Cronitor...). The server pings it every HEARTBEAT_MINUTES (default 5) while its
# database answers; the monitor alerts when the pings stop.
# HEARTBEAT_URL=https://hc-ping.com/your-check-id
# HEARTBEAT_MINUTES=5
# One JSON line per request and error on stdout, for the host's log drain or a log store
# (route patterns and cleaned messages only: no URLs, query strings, emails or ids).
# LOG_FORMAT=json

# Staging copy only (README → Staging): password in front of every page, no indexing,
# a banner, and messages only to the team. Leave unset on the live site.
# SITE_ENV=staging
# STAGING_PASSWORD=a-long-staging-password
# STAGING_EMAIL_ALLOW=@hireriv.com,tester@gmail.com
# STAGING_SMS_ALLOW=+919800000000

# Optional: PostgreSQL copy of the jobs data (jobs, places, categories, skills,
# applications and saved jobs). The site copies every change there and the jobs
# API searches it; everything else stays in SQLite. Leave unset to not use it.
# DATABASE_URL=postgres://hireriv:password@localhost:5432/hireriv
# PG_POOL_MAX=5

# Optional: text messages (6-digit codes for mobile sign-in, mobile sign-up and
# employer mobile checks). Choose msg91, twilio or webhook; see "Text messages"
# in the README for DLT registration in India. Leave unset to save messages to
# the outbox folder as .sms.txt files (mobile sign-in and sign-up are then hidden
# on the live site). Test with: npm run sms:test -- 9876543210
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_CODE_VAR=OTP              (the variable in your template, ##OTP##)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=                    (or TWILIO_MESSAGING_SERVICE_SID=)
# SMS_PROVIDER=webhook            (your own relay: POSTs JSON {"to", "message"})
# SMS_WEBHOOK_URL=https://sms-relay.example.com/send
# SMS_WEBHOOK_TOKEN=

# How often daily and weekly saved-search summaries are checked, in
# milliseconds (default: every hour).
# SAVED_SEARCH_SCAN_MS=3600000

# Optional: phone notifications. The VAPID key pair signs pushes to browser
# push services (base64url, raw P-256). Leave unset and a pair is created once
# and kept in the database. VAPID_SUBJECT is a mailto: or https: contact for
# push services (defaults to SITE_URL).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@hireriv.com

# Encryption at rest for uploaded files (vault.js): 32 bytes as 64 hex
# characters, e.g. from `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Keep it outside the database and its backups (a secret store). Without it a
# key is created once and kept in the database. After a rotation, list the old
# keys (comma-separated) until the daily sweep has re-sealed every file.
# FILE_ENCRYPTION_KEY=
# FILE_ENCRYPTION_KEYS_OLD=

# Security alerts (security.js): documents opened or bulk exports by one person
# in an hour before an alert is raised.
# SECURITY_DOWNLOAD_ALERT=40
# SECURITY_EXPORT_ALERT=5

# Online payments (payment-gateway.js, billing-routes.js). Razorpay test-mode
# keys (rzp_test_...) are the sandbox; switch to live keys only after the
# checks in docs/BILLING.md. The key secret and webhook secret never leave the
# server. Webhook URL to set in the Razorpay dashboard:
#   https://<your site>/api/webhooks/payments/razorpay
# with the events payment.captured, payment.failed, order.paid,
# refund.processed, refund.failed and payment.dispute.*.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---------- Languages and voice (Step 67, docs/I18N.md) ----------
# Interface languages offered, from the locale files in locales/. English is
# always the fallback. Have a native speaker review a language before offering it.
# LANGUAGES=en,hi
# Voice typing in the browser (the microphone button). 0 turns it off and the
# site then refuses the microphone through Permissions-Policy.
# VOICE_INPUT=1

# ---------- AI assistant (Step 66, docs/AI.md) ----------
# Without a key every AI feature answers with its rules-based version. The key
# stays on the server; never put it in the browser or the repository.
# AI_PROVIDER=anthropic        # anthropic | off (mock is for tests and refused in production)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ---------- Public API and webhooks (Step 65, docs/API.md) ----------
# API_RATE_LIVE=600            # requests a minute per live integration
# API_RATE_SANDBOX=120
# WEBHOOK_TICK_MS=5000         # how often due webhook deliveries are sent
