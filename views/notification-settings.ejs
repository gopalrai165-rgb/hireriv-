<%- include('partials/head') %>

<section class="section admin portal">
  <div class="container narrow">
    <div class="admin-head">
      <div>
        <span class="eyebrow"><%= viewer.label %></span>
        <h1>Notification settings</h1>
        <p class="muted"><a href="/notifications<%= viewers.length > 1 ? '?as=' + viewer.as : '' %>">Back to notifications</a></p>
      </div>
    </div>
    <% if (viewers.length > 1) { %>
      <nav class="account-tabs" aria-label="Account">
        <% viewers.forEach(function (v) { %><a href="/notifications/settings?as=<%= v.as %>"<%- v.as === viewer.as ? ' aria-current="page" class="active"' : '' %>><%= v.label %></a><% }) %>
      </nav>
    <% } %>
    <% if (msg) { %><p class="notice" role="status"><%= msg %></p><% } %>

    <form class="form dash-card" method="post" action="/notifications/settings">
      <% if (viewers.length > 1) { %><input type="hidden" name="as" value="<%= viewer.as %>"><% } %>
      <h2>What to send</h2>
      <p class="muted small">Everything also appears in your notifications here, whatever you choose. Phone notifications reach only the devices where you turned them on (below).</p>
      <% prefs.categories.forEach(function (c) { %>
        <fieldset class="pref-list pref-row">
          <legend><b><%= c.label %></b> <span class="muted small"><%= c.text %></span></legend>
          <label class="check-row"><input type="checkbox" name="email_<%= c.key %>" value="1"<%= c.on ? ' checked' : '' %>> <span>Email</span></label>
          <label class="check-row"><input type="checkbox" name="push_<%= c.key %>" value="1"<%= c.push ? ' checked' : '' %>> <span>Phone notification</span></label>
        </fieldset>
      <% }) %>
      <% if (viewer.as === 'candidate') { %>
        <fieldset class="pref-list pref-row">
          <legend><b>News and career tips</b> <span class="muted small">Occasional emails from <%= site.name %> about hiring events and job-search advice. Off unless you turn it on, and every one of these emails has an unsubscribe link.</span></legend>
          <label class="check-row"><input type="checkbox" name="marketing" value="1"<%= prefs.marketing.email ? ' checked' : '' %>> <span>Yes, send me these</span></label>
          <% if (prefs.marketing.at) { %><p class="muted small"><%= prefs.marketing.email ? 'You agreed' : 'You turned this off' %> on <%= formatDate(prefs.marketing.at) %>.</p><% } %>
        </fieldset>
      <% } %>
      <button class="btn btn-primary btn-lg" type="submit">Save settings</button>
    </form>

    <section class="dash-card">
      <h2>Always sent</h2>
      <p class="muted small">These are part of something you asked for, so they can't be switched off.</p>
      <ul><% prefs.essential.forEach(function (t) { %><li><%= t %></li><% }) %></ul>
    </section>

    <section class="dash-card" id="devices">
      <h2>Phone notifications</h2>
      <p class="muted small">A short alert on your phone or computer when something new arrives, such as "New applications update". It never shows the details: they open after you sign in. Signing out turns them off on that device.</p>
      <div class="push-box" data-push data-key="<%= pushKey %>"<%- viewers.length > 1 ? ' data-as="' + viewer.as + '"' : '' %>>
        <p data-push-status class="small" role="status">Turning on phone notifications needs JavaScript.</p>
        <button type="button" class="btn btn-primary btn-lg" data-push-on hidden>Turn on for this device</button>
        <button type="button" class="btn btn-outline" data-push-off hidden>Turn off for this device</button>
      </div>
      <% if (devices.length) { %>
        <h3>Devices with notifications on</h3>
        <ul class="device-list">
          <% devices.forEach(function (d) { %>
            <li>
              <span><b><%= d.device %></b><%= d.thisSession ? ' (this sign-in)' : '' %><br><span class="muted small">Since <%= formatDate(d.createdAt) %><%= d.lastSentAt ? ', last alert ' + formatDate(d.lastSentAt) : '' %></span></span>
              <form method="post" action="/notifications/devices/<%= d.id %>/delete">
                <% if (viewers.length > 1) { %><input type="hidden" name="as" value="<%= viewer.as %>"><% } %>
                <button class="btn btn-outline btn-sm" type="submit">Turn off</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <p class="muted small"><b>Text message and WhatsApp:</b> not used for notifications yet. <% if (viewer.as === 'candidate') { %>Whether recruiters may contact you this way is under <a href="/account/settings">Account settings</a>.<% } %></p>
      <p><button type="button" class="btn btn-outline btn-sm" data-install-app hidden>Install the <%= site.name %> app</button></p>
    </section>

    <% if (viewer.as === 'candidate') { %>
      <section class="dash-card">
        <div class="dash-head"><h2>Your job alerts</h2><a class="small" href="/account#alerts">Add or remove alerts</a></div>
        <% if (!alerts.length) { %>
          <p class="muted">No job alerts yet.</p>
        <% } else { %>
          <ul><% alerts.forEach(function (s) { %><li><%= s.category || 'All' %> jobs<%= s.location ? ' in ' + s.location : '' %></li><% }) %></ul>
          <p class="muted small">You get at most one email per job, however many alerts it matches, and at most 10 job emails a day.</p>
        <% } %>
      </section>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
