<%- include('partials/head') %>

<section class="section">
  <div class="container narrow">
    <h1>Your report</h1>
    <% if (!track) { %>
      <p class="lead">This tracking link is not valid. Use the link you were given when you sent the report.</p>
    <% } else { %>
      <div class="form-card">
        <p><b>Reference:</b> <%= track.reference %></p>
        <p><b>What you reported:</b> <%= track.category %></p>
        <p><b>Status:</b> <span class="pill <%= track.status === 'Resolved' ? 'st-hired' : track.status === 'Action required' ? 'st-rejected' : 'st-screening' %>"><%= track.status %></span></p>
        <% if (track.status === 'Action required') { %><p class="notice" role="status">We emailed you a question. Please reply to that email so we can finish looking into it.</p><% } %>
        <h2>What has happened</h2>
        <ol class="plain-list">
          <% track.steps.forEach(function (s) { %><li><%= new Date(s.at).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium' }) %>: <%= s.label %></li><% }) %>
        </ol>
        <p class="muted small">To protect everyone involved, we do not share who reviewed the report or what action was taken against an account.</p>
      </div>
    <% } %>
    <p class="notice"><%= help %></p>
    <p class="muted small">Keep this link private: anyone with it can see this page. Need help? <a href="/contact">Contact us</a>.</p>
  </div>
</section>

<%- include('partials/foot') %>
