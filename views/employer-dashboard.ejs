<%- include('partials/head') %>

<section class="section admin portal">
  <div class="container">
    <div class="admin-head">
      <div>
        <span class="eyebrow">Client portal</span>
        <h1><%= employer.company %></h1>
        <p class="muted">Signed in as <%= employer.name %> · <%= employer.email %></p>
      </div>
      <form method="post" action="/employer/logout"><button class="btn btn-outline btn-sm" type="submit">Log out</button></form>
    </div>
    <% if (welcome) { %><p class="notice" role="status">Your account is ready. Welcome aboard!</p><% } %>
    <% if (msg) { %><p class="notice" role="status"><%= msg %></p><% } %>

    <div class="dash-grid">
      <section class="dash-card dash-wide">
        <div class="dash-head"><h2>Your open roles</h2><span class="muted small"><%= myJobs.length %> <%= myJobs.length === 1 ? 'role' : 'roles' %></span></div>
        <% if (!myJobs.length) { %>
          <p class="muted dash-empty">No roles linked to your account yet. Send a requirement below and your account manager will set it up.</p>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Role</th><th>Applicants</th><% stages.forEach(function (s) { %><th><%= s %></th><% }) %></tr></thead>
              <tbody>
                <% myJobs.forEach(function (j) { %>
                  <tr>
                    <td><b><%= j.title %></b><br><span class="muted small"><%= j.location %> · <%= j.status === 'open' ? 'Open' : 'Closed' %></span></td>
                    <td><b><%= j.total %></b></td>
                    <% stages.forEach(function (s) { %><td><%= j.stages[s] || '·' %></td><% }) %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <p class="muted small">Your account manager screens every applicant and shares the strongest profiles with you.</p>
        <% } %>
      </section>

      <section class="dash-card dash-wide" id="shortlist">
        <div class="dash-head"><h2>Shortlisted candidates</h2><span class="muted small"><%= shortlist.length %> shared with you</span></div>
        <% if (!shortlist.length) { %>
          <p class="muted dash-empty">When your account manager shortlists candidates for your roles, they appear here for your review.</p>
        <% } else { %>
          <div class="shortlist">
            <% shortlist.forEach(function (c) { %>
              <article class="cand-card<%= c.feedback ? ' has-feedback' : '' %>">
                <div class="cand-top">
                  <div><h3><%= c.name %></h3><p class="muted small"><%= c.jobTitle %> · shared <%= formatDate(c.sharedAt) %></p></div>
                  <% if (c.match) { %><%- include('partials/match-chip', { match: c.match }) %><% } %>
                </div>
                <ul class="job-meta">
                  <li><svg class="i"><use href="#i-briefcase"/></svg><%= c.experience || '—' %></li>
                  <li><svg class="i"><use href="#i-pin"/></svg><%= c.location || '—' %></li>
                  <li><svg class="i"><use href="#i-clock"/></svg>Notice: <%= c.noticePeriod || '—' %></li>
                </ul>
                <% if (c.skills) { %><div class="chips"><% c.skills.split(',').map(function (s) { return s.trim(); }).filter(Boolean).slice(0, 8).forEach(function (s) { %><span class="chip"><%= s %></span><% }) %></div><% } %>
                <% if (c.summary) { %><p class="cand-note"><b>Recruiter's note:</b> <%= c.summary %></p><% } %>
                <% if (c.hasResume) { %><a class="small cand-resume" href="<%= signedLink('/employer/resume/' + c.id) %>">Download resume</a><% } %>
                <form class="form cand-feedback" method="post" action="/employer/candidates/<%= c.id %>/feedback">
                  <div class="decision-row" role="radiogroup" aria-label="Your decision on <%= c.name %>">
                    <% decisions.forEach(function (d) { %><label class="decision decision-<%= d.toLowerCase().split(' ').join('-') %>"><input type="radio" name="decision" value="<%= d %>" required<%= c.feedback && c.feedback.decision === d ? ' checked' : '' %>><span><%= d %></span></label><% }) %>
                  </div>
                  <textarea name="comment" rows="2" maxlength="1000" placeholder="Comment for your account manager (optional)"><%= c.feedback ? c.feedback.comment : '' %></textarea>
                  <button class="btn btn-primary btn-sm" type="submit"><%= c.feedback ? 'Update feedback' : 'Send feedback' %></button>
                  <% if (c.feedback) { %><span class="muted small">Sent <%= formatDate(c.feedback.at) %> by <%= c.feedback.by %></span><% } %>
                </form>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <% if (timesheets.length) { %>
        <section class="dash-card dash-wide" id="timesheets">
          <div class="dash-head"><h2>Timesheets to approve</h2><span class="muted small"><%= timesheets.length %> waiting</span></div>
          <p class="muted small">Approved days are what we bill for that month. Send a week back with a note if something needs correcting.</p>
          <% timesheets.forEach(function (t) { %>
            <article class="cand-card ts-review">
              <div class="cand-top"><div><h3><%= t.p.candidateName %></h3><p class="muted small"><%= t.p.jobTitle %> · <%= t.label %> · <b><%= t.total %> day<%= t.total === 1 ? '' : 's' %></b></p></div></div>
              <ul class="ts-grid">
                <% t.dates.forEach(function (d) { const v = Number(t.ts.days[d] || 0); %>
                  <li class="<%= v ? '' : 'is-off' %>"><span><%= new Date(d + 'T00:00:00Z').toLocaleDateString('en-IN', { weekday: 'short', timeZone: 'UTC' }) %></span><b><%= v === 1 ? 'Full' : v === 0.5 ? 'Half' : 'Off' %></b></li>
                <% }) %>
              </ul>
              <% if (t.ts.note) { %><p class="cand-note"><b>Note:</b> <%= t.ts.note %></p><% } %>
              <div class="ts-actions">
                <form method="post" action="/employer/timesheets/<%= t.p.id %>/<%= t.ts.id %>/approve"><button class="btn btn-primary btn-sm">Approve</button></form>
                <form class="form ts-reject" method="post" action="/employer/timesheets/<%= t.p.id %>/<%= t.ts.id %>/reject">
                  <input name="note" maxlength="300" required placeholder="What needs changing?" aria-label="Reason for sending back">
                  <button class="btn btn-outline btn-sm">Send back</button>
                </form>
              </div>
            </article>
          <% }) %>
        </section>
      <% } %>

      <% if (placements.length) { %>
        <section class="dash-card dash-wide" id="billing">
          <div class="dash-head"><h2>Placements &amp; invoices</h2><span class="muted small"><%= placements.length %> hired through us</span></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Candidate</th><th>Joining</th><th>Replacement guarantee</th><th>Invoice</th></tr></thead>
              <tbody>
                <% placements.forEach(function (p) { %>
                  <tr>
                    <td><b><%= p.candidateName %></b><br><span class="muted small"><%= p.jobTitle %></span></td>
                    <td><%= formatDate(p.joiningDate) %><br><span class="muted small"><%= p.status %></span></td>
                    <td><% if (p.monthly) { %><span class="muted"><%= p.contractEnd ? 'Contract to ' + formatDate(p.contractEnd) : 'Contract' %></span><% } else if (p.inGuarantee) { %>Until <%= formatDate(p.guaranteeEnds) %><% } else if (p.status === 'Joined') { %><span class="muted">Ended <%= formatDate(p.guaranteeEnds) %></span><% } else { %><span class="muted">—</span><% } %></td>
                    <td>
                      <% if (!p.invoices.length) { %><span class="muted small"><%= p.monthly ? 'Billed monthly' : 'Not invoiced yet' %></span><% } %>
                      <% p.invoices.slice(0, 6).forEach(function (i) { %>
                        <div class="month-inv">
                          <a href="/employer/invoices/<%= p.id %><%= i.key === 'main' ? '' : '?inv=' + i.key %>"><b><%= i.number %></b></a><%= i.month ? ' · ' + i.month : '' %> · <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(i.total) %><br>
                          <% if (i.status === 'Paid') { %><span class="pill st-hired">Paid</span><% } else if (i.status === 'Credited') { %><span class="pill st-new">Credited</span><% } else if (i.overdue) { %><span class="pill st-rejected">Overdue</span><% } else { %><span class="pill st-screening">Due <%= formatDate(i.dueDate) %></span><% } %>
                          <% if (['Unpaid', 'Part paid'].includes(i.status) && i.balance !== i.total) { %><span class="muted small">Balance <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(i.balance) %></span><% } %>
                          <% if (i.refundDue) { %><br><span class="muted small">Refund due to you: <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(i.refundDue) %></span><% } %>
                          <% i.creditNotes.forEach(function (c) { %><br><a class="small" href="/employer/invoices/<%= p.id %>/credit-notes/<%= c.id %>">Credit note <%= c.number %></a><% }) %>
                        </div>
                      <% }) %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <p class="muted small">If a candidate leaves during the guarantee period, tell your account manager and we'll find a replacement.</p>
        </section>
      <% } %>

      <section class="dash-card" id="new-requirement">
        <div class="dash-head"><h2>Send a new requirement</h2></div>
        <form class="form" method="post" action="/employer/requirements">
          <div class="form-grid">
            <label class="span-2">Role(s) needed*<input name="roles" required maxlength="300" placeholder="e.g. 2 Senior Java developers"></label>
            <label>Headcount<input name="headcount" inputmode="numeric" maxlength="10" placeholder="e.g. 2"></label>
            <label>Hiring type
              <select name="hiringType"><option>Permanent</option><option>Contract</option><option>Contract-to-hire</option><option>Bulk / RPO</option></select>
            </label>
            <label>Location<input name="location" maxlength="120" placeholder="City or Remote"></label>
            <label>Start by
              <select name="timeline"><option>Immediately</option><option>Within 2 weeks</option><option>Within a month</option><option>1–3 months</option></select>
            </label>
            <label class="span-2">Budget <span class="muted small">(optional)</span><input name="budget" maxlength="120" placeholder="e.g. ₹18–24 LPA"></label>
            <label class="span-2">Details<textarea name="message" rows="3" placeholder="Skills, experience, team, interview process…"></textarea></label>
          </div>
          <button class="btn btn-primary" type="submit">Send requirement</button>
        </form>
      </section>

      <section class="dash-card">
        <div class="dash-head"><h2>Your requirements</h2></div>
        <% if (!requirements.length) { %><p class="muted dash-empty">Nothing sent yet.</p>
        <% } else { %>
          <ul class="activity">
            <% requirements.forEach(function (r) { %>
              <li><span class="activity-row"><span class="pill"><%= r.status || 'Received' %></span><span class="activity-text"><%= r.roles %><%= r.headcount ? ' × ' + r.headcount : '' %></span><span class="muted small"><%= formatDate(r.createdAt) %></span></span></li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
