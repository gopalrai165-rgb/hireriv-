<%- include('partials/head') %>

<section class="page-hero">
  <span class="deco deco-spark" aria-hidden="true"></span>
  <div class="container split">
    <div>
      <span class="eyebrow">Contact</span>
      <h1>Let's <span class="grad">talk</span></h1>
      <p class="lead">Questions about hiring, a role, or partnering with us? We usually reply within a few hours.</p>
      <p class="brand-line"><%= brandLine(site) %></p>
      <% const real = realContact(site); %>
      <div class="hero-ctas">
        <% if (real.phone) { %><a href="tel:<%= real.phone.replace(/\s/g, '') %>" class="btn btn-primary btn-lg"><svg class="i"><use href="#i-phone"/></svg> Call <%= real.phone %></a><% } %>
        <% if (real.whatsapp) { %><a href="https://wa.me/<%= real.whatsapp %>" class="btn btn-outline btn-lg" target="_blank" rel="noopener"><svg class="i"><use href="#i-whatsapp"/></svg> WhatsApp</a><% } %>
        <% if (!real.phone && !real.whatsapp) { %><a href="mailto:<%= site.email %>" class="btn btn-primary btn-lg"><svg class="i"><use href="#i-mail"/></svg> Email <%= site.email %></a><% } %>
      </div>
    </div>
    <div class="hero-media" aria-hidden="true">
      <span class="deco deco-ring"></span>
      <figure class="photo-arch"><img src="/img/photos/contact.webp" alt="" width="900" height="700"></figure>
      <div class="float-card fc-small"><svg class="i ok"><use href="#i-clock"/></svg><div><b>Quick replies</b><span class="muted small"><%= site.hours %></span></div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div class="contact-cards">
      <% if (real.phone) { %><a class="contact-card" href="tel:<%= real.phone.replace(/\s/g, '') %>"><span class="service-icon"><svg class="i"><use href="#i-phone"/></svg></span><div><b>Call us</b><span><%= real.phone %></span></div></a><% } %>
      <a class="contact-card" href="mailto:<%= site.email %>"><span class="service-icon"><svg class="i"><use href="#i-mail"/></svg></span><div><b>Email</b><span><%= site.email %></span></div></a>
      <% if (real.whatsapp) { %><a class="contact-card" href="https://wa.me/<%= real.whatsapp %>" target="_blank" rel="noopener"><span class="service-icon"><svg class="i"><use href="#i-whatsapp"/></svg></span><div><b>WhatsApp</b><span>Book a quick consultation</span></div></a><% } %>
      <% if (real.address) { %><div class="contact-card"><span class="service-icon"><svg class="i"><use href="#i-pin"/></svg></span><div><b>Visit us</b><span><%= real.address %></span><span class="muted small"><%= site.hours %></span></div></div><% } %>
    </div>
    <div class="form-card">
      <h2>Send us a message</h2>
      <form class="form js-form" action="/api/contact" method="post">
  <%- include('partials/honeypot') %>
        <input type="hidden" name="source" value="" data-source>
        <div class="form-grid">
          <label>Name*<input name="name" required autocomplete="name"></label>
          <label>Email*<input type="email" name="email" required autocomplete="email"></label>
          <label>Subject*
            <select name="subject" required><option value="">Choose one</option><option>I want to hire</option><option>I'm looking for a job</option><option>Partnership</option><option>Other</option></select>
          </label>
          <label>Phone <span class="muted small">(needed if you are hiring)</span><input type="tel" name="phone" autocomplete="tel"></label>
          <label class="span-2">Company <span class="muted small">(if you are hiring)</span><input name="company" maxlength="160" autocomplete="organization"></label>
          <label class="span-2">Message*<textarea name="message" rows="5" required></textarea></label>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Send message</button>
        <p class="muted small form-note">We use these details only to reply to you. See our <a href="/privacy">Privacy Policy</a>. Looking for a job? <a href="/job-seekers#resume">Send your resume</a> instead, so recruiters can match you.</p>
      </form>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
