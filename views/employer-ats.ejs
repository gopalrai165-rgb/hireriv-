<%- include('partials/head') %>

<section class="section admin portal">
  <div class="container">
    <%- include('partials/employer-nav', { heading: 'Hiring pipeline', tab: 'ats' }) %>

    <div class="kpis">
      <a class="kpi" href="/employer/jobs?status=open"><span class="kpi-label">Active vacancies</span><span class="kpi-value"><%= m.activeVacancies %></span></a>
      <a class="kpi" href="/employer/ats?view=table&stage=New"><span class="kpi-label">New applications</span><span class="kpi-value"><%= m.newApplications %></span><span class="kpi-note"><%= m.awaitingReview %> awaiting review</span></a>
      <a class="kpi" href="/employer/ats?view=table&stage=Shortlisted"><span class="kpi-label">Shortlisted</span><span class="kpi-value"><%= m.shortlisted %></span></a>
      <a class="kpi" href="/employer/interviews"><span class="kpi-label">Interviews scheduled</span><span class="kpi-value"><%= m.interviewsScheduled %></span></a>
      <a class="kpi" href="/employer/ats?view=table&stage=Offered"><span class="kpi-label">Offers issued</span><span class="kpi-value"><%= m.offersIssued %></span></a>
      <a class="kpi" href="/employer/ats?view=table&stage=Hired"><span class="kpi-label">Hired</span><span class="kpi-value"><%= m.hires %></span><span class="kpi-note"><%= m.timeToHireDays === null ? 'No hires yet' : 'Median ' + m.timeToHireDays + ' days to hire' %></span></a>
    </div>

    <form class="form filter-bar" method="get" action="/employer/ats">
      <input type="hidden" name="view" value="<%= view %>">
      <label>Job<select name="job"><option value="">All jobs</option><% jobs.forEach(function (j) { %><option value="<%= j.id %>"<%= f.job === j.id ? ' selected' : '' %>><%= j.title %> · <%= j.location %></option><% }) %></select></label>
      <% if (view === 'table') { %><label>Stage<select name="stage"><option value="">Any</option><% stages.concat(['Withdrawn']).forEach(function (s) { %><option value="<%= s %>"<%= f.stage === s ? ' selected' : '' %>><%= label(s) %></option><% }) %></select></label><% } %>
      <label>Skills<input name="skills" value="<%= f.skills %>" placeholder="e.g. forklift, sql"></label>
      <label>Experience<input name="experience" value="<%= f.experience %>" placeholder="e.g. 2-4"></label>
      <label>Location<input name="location" value="<%= f.location %>" placeholder="e.g. Pune"></label>
      <label class="check-row small"><input type="checkbox" name="mine" value="1"<%= f.mine ? ' checked' : '' %>> <span>Assigned to me</span></label>
      <button class="btn btn-outline btn-sm" type="submit">Filter</button>
    </form>

    <div class="dash-head">
      <nav class="filter-chips" aria-label="View">
        <a class="chip<%= view === 'board' ? ' is-active' : '' %>" href="/employer/ats?<%= query({ view: 'board', stage: '' }) %>">Board</a>
        <a class="chip<%= view === 'table' ? ' is-active' : '' %>" href="/employer/ats?<%= query({ view: 'table' }) %>">Table</a>
      </nav>
      <a class="btn btn-outline btn-sm" href="/employer/ats/reports">Reports</a>
    </div>

    <% if (!jobs.length) { %>
      <p class="muted dash-empty">People who apply to the jobs you post appear here. <% if (can('jobs.create')) { %><a href="/employer/jobs/new">Post a job</a>.<% } %></p>
    <% } else if (view === 'board') { %>
      <div class="kanban" role="list">
        <% columns.forEach(function (col) { const cards = rows.filter(function (v) { return v.status === col; }); %>
          <section class="kanban-col" role="listitem" aria-label="<%= label(col) %>">
            <h2 class="kanban-head"><span class="pill <%= stageClass(col) %>"><%= label(col) %></span> <span class="muted small"><%= cards.length %></span></h2>
            <% cards.forEach(function (v) { %>
              <article class="kanban-card">
                <a href="/employer/applicants/<%= v.id %>"><b><%= v.name %></b></a>
                <p class="muted small"><%= v.jobTitle %><%= v.experience ? ' · ' + v.experience : '' %><%= v.location ? ' · ' + v.location : '' %></p>
                <% if (v.match) { %><%- include('partials/match-chip', { match: v.match }) %><% } %>
                <p class="muted small"><%= v.assignedTo ? 'With ' + v.assignedTo.name : 'Not assigned' %> · applied <%= formatDate(v.appliedAt) %></p>
                <% if (v.allowedMoves.length) { %>
                  <form class="form kanban-move" method="post" action="/employer/applicants/<%= v.id %>/status">
                    <input type="hidden" name="back" value="ats">
                    <select name="status" aria-label="Move <%= v.name %> to"><% v.allowedMoves.forEach(function (s) { %><option value="<%= s %>"><%= label(s) %></option><% }) %></select>
                    <button class="btn btn-outline btn-sm" type="submit">Move</button>
                  </form>
                <% } %>
              </article>
            <% }) %>
          </section>
        <% }) %>
      </div>
      <p class="muted small">Not on the board: <a href="/employer/ats?<%= query({ view: 'table', stage: 'Rejected' }) %>"><%= m.rejected %> rejected</a> · <a href="/employer/ats?<%= query({ view: 'table', stage: 'Withdrawn' }) %>"><%= m.withdrawn %> withdrawn</a>. Moving to Interview books nothing: schedule interviews from the applicant's page. Offer and Hired follow an approved offer and the candidate's answer.</p>
    <% } else if (!rows.length) { %>
      <p class="muted dash-empty">No applicants match.</p>
    <% } else { %>
      <div class="table-wrap dash-card">
        <table>
          <thead><tr><th>Applicant</th><th>Job</th><th>Stage</th><th>Assigned</th><th>Applied</th></tr></thead>
          <tbody>
            <% rows.forEach(function (v) { %>
              <tr>
                <td><a href="/employer/applicants/<%= v.id %>"><b><%= v.name %></b></a><br><span class="muted small"><%= [v.experience, v.location].filter(Boolean).join(' · ') || '—' %></span><% if (v.match) { %> <%- include('partials/match-chip', { match: v.match }) %><% } %></td>
                <td><%= v.jobTitle %></td>
                <td><span class="pill <%= stageClass(v.status) %>"><%= label(v.status) %></span></td>
                <td class="small"><%= v.assignedTo ? v.assignedTo.name : '—' %></td>
                <td class="muted small"><%= formatDate(v.appliedAt) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
    <p class="muted small">Skill matches help you sort applicants; they never reject anyone. Every decision is made by a person on your team.</p>
  </div>
</section>

<%- include('partials/foot') %>
