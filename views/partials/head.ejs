<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= site.name %></title>
  <meta name="description" content="<%= metaDescription %>">
  <% if (noindex) { %><meta name="robots" content="noindex, nofollow">
  <% } else { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= site.name %>">
  <meta property="og:title" content="<%= title %> | <%= site.name %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= ogImageAlt %>">
  <meta name="twitter:card" content="summary_large_image">
  <% if (jsonLd) { %><script type="application/ld+json"><%- toJsonLd(jsonLd) %></script><% } %>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
</head>
<body class="page-<%= page || 'misc' %>"<%- typeof candidateSignedIn !== 'undefined' && candidateSignedIn ? ' data-account="1"' : '' %>>
<a class="skip-link" href="#main">Skip to content</a>
<%- include('icons') %>
<header class="site-header" id="top">
  <div class="container nav-wrap">
    <a href="/" class="logo" aria-label="<%= site.name %> home">
      <img src="/img/logo.svg" alt="" width="36" height="36">
      <span class="logo-text"><span>Hire<b>riv</b></span><small>by Raigozen</small></span>
    </a>
    <nav class="main-nav" id="main-nav" aria-label="Main">
      <a href="/jobs" class="<%= page === 'jobs' ? 'active' : '' %>">Find Jobs</a>
      <a href="/categories" class="<%= page === 'categories' ? 'active' : '' %>">Job Categories</a>
      <a href="/services" class="<%= page === 'services' || page === 'industries' ? 'active' : '' %>">Staffing Solutions</a>
      <a href="/hire" class="<%= page === 'hire' ? 'active' : '' %>">Employers</a>
      <a href="/blog" class="<%= page === 'blog' ? 'active' : '' %>">Career Resources</a>
      <a href="/saved" class="nav-saved <%= page === 'saved' ? 'active' : '' %>"><svg class="i"><use href="#i-bookmark"/></svg>Saved<span class="saved-count" hidden></span></a>
      <details class="nav-login">
        <summary>Login</summary>
        <div class="nav-login-menu">
          <a href="/account/login"><b>Job seekers</b><span>Your profile, applications and alerts</span></a>
          <a href="/employer/login"><b>Employers</b><span>Your roles, candidates and invoices</span></a>
        </div>
      </details>
      <% if (typeof candidateSignedIn !== 'undefined' && candidateSignedIn) { %><a href="/account" class="nav-register <%= page === 'account' ? 'active' : '' %>">My account</a><% } else { %><a href="/account/register" class="nav-register <%= page === 'account' ? 'active' : '' %>">Register</a><% } %>
      <a href="/post-a-job" class="btn btn-primary btn-sm nav-cta">Post a Job</a>
    </nav>
    <a href="/saved" class="mobile-saved" aria-label="Saved jobs"><svg class="i"><use href="#i-bookmark"/></svg><span class="saved-count" hidden></span></a>
    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav">
      <svg class="i"><use href="#i-menu"/></svg>
    </button>
  </div>
</header>
<main id="main" tabindex="-1">
