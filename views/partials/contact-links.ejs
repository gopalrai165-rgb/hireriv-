<%# A candidate's email (when they gave one), phone and a WhatsApp chat link. %>
<% const em = realEmail(person.email); %><% if (em) { %><br><a href="mailto:<%= em %>"><%= em %></a><% } else { %><br><span class="muted small">No email (contact by phone)</span><% } %>
<br><a href="tel:<%= person.phone %>"><%= person.phone %></a><% const wa = waLink(person.phone); if (wa) { %> · <a href="<%= wa %>" target="_blank" rel="noopener">WhatsApp</a><% } %>
