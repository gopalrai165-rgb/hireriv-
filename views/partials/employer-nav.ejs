<%# Header, company switcher and tabs shared by the employer portal pages. %>
<div class="admin-head">
  <div>
    <span class="eyebrow">Employer portal · <%= roleLabel %></span>
    <h1><%= heading %></h1>
    <p class="muted"><%= employer.company %> · signed in as <%= employerUser.name %> (<%= employerUser.email %>)</p>
  </div>
  <div class="row-actions">
    <% if (myCompanies.length > 1) { %>
      <form class="form company-switch" method="post" action="/employer/switch">
        <label class="sr-only" for="switch-company">Company</label>
        <select id="switch-company" name="employerId">
          <% myCompanies.forEach(function (x) { %><option value="<%= x.employer.id %>"<%= x.employer.id === employer.id ? ' selected' : '' %>><%= x.employer.company %></option><% }) %>
        </select>
        <button class="btn btn-outline btn-sm" type="submit">Switch</button>
      </form>
    <% } %>
    <%- include('notification-bell', { as: 'employer', bellQuery: '?as=employer', bellClass: 'btn btn-outline btn-sm' }) %>
    <form method="post" action="/employer/logout"><button class="btn btn-outline btn-sm" type="submit">Log out</button></form>
  </div>
</div>
<nav class="account-tabs" aria-label="Employer portal">
  <% var navTabs = [['dashboard', '/employer', 'Dashboard'], ['jobs', '/employer/jobs', 'Jobs'], ['ats', '/employer/ats', 'Pipeline'], ['applicants', '/employer/applicants', 'Applicants'], ['interviews', '/employer/interviews', 'Interviews'], ['requisitions', '/employer/requisitions', 'Requisitions'], ['workforce', '/employer/workforce', 'Workforce'], ['contracts', '/employer/contracts', 'Contracts'], ['billing', '/employer/billing', 'Billing'], ['invoices', '/employer/invoices', 'Staffing invoices'], ['reports', '/employer/reports', 'Reports'], ['analytics', '/employer/analytics', 'Analytics'], ['candidates', '/employer/candidates', 'Find candidates'], ['team', '/employer/team', 'Team'], ['company', '/employer/company', 'Company'], ['integrations', '/employer/integrations', 'Integrations'], ['settings', '/employer/settings', 'Settings']]; %>
  <%# Site supervisors only work with the workers they supervise. %>
  <%# Billing administrators only work on billing. %>
  <% if (member.role === 'supervisor') navTabs = navTabs.filter(function (t) { return ['workforce', 'settings'].includes(t[0]); }); else if (member.role === 'billing') navTabs = navTabs.filter(function (t) { return ['billing', 'invoices', 'settings'].includes(t[0]); }); else navTabs = navTabs.filter(function (t) { var need = ({ workforce: 'workforce.view', contracts: 'contracts.view', billing: 'billing.view', invoices: 'billing.view', reports: 'reports.view', analytics: 'analytics.view', integrations: 'integrations.manage' })[t[0]]; return need ? can(need) : true; }); %>
  <% navTabs.forEach(function (t) { %>
    <a href="<%= t[1] %>"<%- tab === t[0] ? ' aria-current="page" class="active"' : '' %>><%= t[2] %></a>
  <% }) %>
</nav>
<% if (typeof msg !== 'undefined' && msg) { %><p class="notice" role="status"><%= msg %></p><% } %>
<% if (typeof errors !== 'undefined' && errors.length) { %><div class="notice notice-err" role="alert"><% errors.forEach(function (e) { %><p><%= e %></p><% }) %></div><% } %>
