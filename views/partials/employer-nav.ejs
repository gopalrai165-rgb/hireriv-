<%# Shared by the employer portal pages: a sidebar with the company, the sections in groups and the account tools (a scrolling row on phones), then the page title. The page's own content follows beside it. %>
<% var navTabs = [['dashboard', '/employer', 'Dashboard'], ['jobs', '/employer/jobs', 'Jobs'], ['ats', '/employer/ats', 'Pipeline'], ['applicants', '/employer/applicants', 'Applicants'], ['interviews', '/employer/interviews', 'Interviews'], ['requisitions', '/employer/requisitions', 'Requisitions'], ['workforce', '/employer/workforce', 'Workforce'], ['contracts', '/employer/contracts', 'Contracts'], ['billing', '/employer/billing', 'Billing'], ['invoices', '/employer/invoices', 'Staffing invoices'], ['reports', '/employer/reports', 'Reports'], ['analytics', '/employer/analytics', 'Analytics'], ['candidates', '/employer/candidates', 'Find candidates'], ['invitations', '/employer/invitations', 'Invitations'], ['team', '/employer/team', 'Team'], ['company', '/employer/company', 'Company'], ['integrations', '/employer/integrations', 'Integrations'], ['settings', '/employer/settings', 'Settings']]; %>
<%# Site supervisors only work with the workers they supervise. %>
<%# Billing administrators only work on billing. %>
<% if (member.role === 'supervisor') navTabs = navTabs.filter(function (t) { return ['workforce', 'settings'].includes(t[0]); }); else if (member.role === 'billing') navTabs = navTabs.filter(function (t) { return ['billing', 'invoices', 'settings'].includes(t[0]); }); else navTabs = navTabs.filter(function (t) { var need = ({ workforce: 'workforce.view', contracts: 'contracts.view', billing: 'billing.view', invoices: 'billing.view', reports: 'reports.view', analytics: 'analytics.view', integrations: 'integrations.manage' })[t[0]]; return need ? can(need) : true; }); %>
<% var navGroups = [['Overview', ['dashboard', 'reports', 'analytics']], ['Hiring', ['jobs', 'ats', 'applicants', 'interviews', 'candidates', 'invitations']], ['Staffing', ['requisitions', 'workforce', 'contracts']], ['Billing', ['billing', 'invoices']], ['Company', ['company', 'team', 'integrations', 'settings']]]; %>
<% var navIcons = { dashboard: 'i-home', reports: 'i-chart', analytics: 'i-spark', jobs: 'i-briefcase', ats: 'i-target', applicants: 'i-users', interviews: 'i-clock', candidates: 'i-search', invitations: 'i-mail', requisitions: 'i-box', workforce: 'i-hardhat', contracts: 'i-shield', billing: 'i-wallet', invoices: 'i-finance', company: 'i-bank', team: 'i-users', integrations: 'i-link', settings: 'i-gear' }; %>
<% var openTab = typeof tab !== 'undefined' ? tab : ''; %>
<% var openGroup = (navGroups.find(function (g) { return g[1].includes(openTab); }) || [''])[0]; %>
<aside class="admin-side emp-side" aria-label="Employer portal menu">
  <div class="admin-me">
    <span class="admin-avatar" aria-hidden="true"><%= String(employer.company || '?').trim().charAt(0).toUpperCase() %></span>
    <span class="admin-me-text"><b><%= employer.company %></b><span><%= roleLabel %></span></span>
    <%- include('notification-bell', { as: 'employer', bellQuery: '?as=employer', bellClass: 'admin-me-bell' }) %>
  </div>
  <nav class="admin-nav" aria-label="Employer portal">
    <% navGroups.forEach(function (g) { var items = navTabs.filter(function (t) { return g[1].includes(t[0]); }); if (!items.length) return; %>
      <div class="admin-nav-group">
        <span class="admin-nav-label"><%= g[0] %></span>
        <div class="admin-nav-tabs">
          <% items.forEach(function (t) { %>
            <a class="tab<%= openTab === t[0] ? ' active' : '' %>" href="<%= t[1] %>"<%- openTab === t[0] ? ' aria-current="page"' : '' %>><svg class="i" aria-hidden="true"><use href="#<%= navIcons[t[0]] || 'i-arrow' %>"/></svg><span class="tab-name"><%= t[2] %></span></a>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </nav>
  <details class="admin-tools" open>
    <summary class="admin-tools-label">Account</summary>
    <div class="admin-userbar">
      <span class="emp-who"><%= employerUser.name %><br><span class="muted"><%= employerUser.email %></span></span>
      <% if (myCompanies.length > 1) { %>
        <form class="form company-switch" method="post" action="/employer/switch">
          <label class="sr-only" for="switch-company">Company</label>
          <select id="switch-company" name="employerId">
            <% myCompanies.forEach(function (x) { %><option value="<%= x.employer.id %>"<%= x.employer.id === employer.id ? ' selected' : '' %>><%= x.employer.company %></option><% }) %>
          </select>
          <button class="btn btn-outline btn-sm" type="submit">Switch</button>
        </form>
      <% } %>
      <a class="small" href="/notifications?as=employer">Notifications</a>
      <a class="small" href="/employer/settings">Your settings</a>
      <form method="post" action="/employer/logout"><button class="link-btn small" type="submit">Log out</button></form>
    </div>
  </details>
</aside>
<div class="admin-head">
  <div class="admin-title">
    <span class="admin-crumb">Employer portal<%= openGroup ? ' · ' + openGroup : '' %></span>
    <h1><%= heading %></h1>
    <p class="muted"><%= employer.company %> · signed in as <%= employerUser.name %> (<%= employerUser.email %>) · <%= roleLabel %></p>
  </div>
</div>
<% if (typeof msg !== 'undefined' && msg) { %><p class="notice" role="status"><%= msg %></p><% } %>
<% if (typeof errors !== 'undefined' && errors.length) { %><div class="notice notice-err" role="alert"><% errors.forEach(function (e) { %><p><%= e %></p><% }) %></div><% } %>
