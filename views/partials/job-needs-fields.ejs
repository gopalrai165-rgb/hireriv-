<%# English needed and walk-in interview details (job-needs.js), shared by the team's and employers' job forms. %>
<% const englishLabels = { None: 'No English needed', Basic: 'Basic English (understands simple words)', Good: 'Good English (talks with customers)', Fluent: 'Fluent English' }; %>
<label>English needed <span class="muted small">(job seekers filter by this)</span>
  <select name="english"><option value="">Not specified</option><% ['None', 'Basic', 'Good', 'Fluent'].forEach(function (l) { %><option value="<%= l %>"<%= job.english === l ? ' selected' : '' %>><%= englishLabels[l] %></option><% }) %></select>
</label>
<% const jn = jobExtras; %>
<label>Minimum education <span class="muted small">(job seekers filter by this)</span>
  <select name="minEducation"><option value="">Not specified</option><% jn.EDUCATION.forEach(function (e) { %><option value="<%= e.key %>"<%= job.minEducation === e.key ? ' selected' : '' %>><%= e.label %></option><% }) %></select>
</label>
<fieldset class="span-2 check-set"><legend>Perks the job gives <span class="muted small">(tick all that apply; job seekers filter by these)</span></legend>
  <div class="check-grid"><% jn.PERKS.forEach(function (p) { %><label class="check-row"><input type="checkbox" name="perks" value="<%= p.key %>"<%= (job.perks || []).includes(p.key) ? ' checked' : '' %>> <span><%= p.label %></span></label><% }) %></div>
</fieldset>
<fieldset class="span-2 check-set"><legend>The worker must have <span class="muted small">(only what the job can't be done without; job seekers who don't have it can hide the job)</span></legend>
  <div class="check-grid"><% jn.ITEMS.forEach(function (i) { %><label class="check-row"><input type="checkbox" name="bring" value="<%= i.key %>"<%= (job.bring || []).includes(i.key) ? ' checked' : '' %>> <span><%= i.label %></span></label><% }) %></div>
</fieldset>
<label class="span-2 check-row"><input type="checkbox" name="walkIn" value="1"<%= job.walkIn ? ' checked' : '' %>> <span>Walk-in interviews at this address</span></label>
<fieldset class="span-2 pay-fields walkin-fields">
  <legend>Walk-in details <span class="muted small">(optional)</span></legend>
  <label>First day<input type="date" name="walkInFrom" value="<%= job.walkInFrom || '' %>"></label>
  <label>Last day<input type="date" name="walkInTo" value="<%= job.walkInTo || '' %>"></label>
  <label>Time<input name="walkInTime" maxlength="60" value="<%= job.walkInTime || '' %>" placeholder="e.g. 10 am – 4 pm, Mon–Sat"></label>
  <label>Ask for<input name="walkInContact" maxlength="80" value="<%= job.walkInContact || '' %>" placeholder="e.g. Priya, HR desk, gate 2"></label>
</fieldset>
