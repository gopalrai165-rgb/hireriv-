<% const jt = jobTitleIn(job); const pay = payLabel(job); %>
<article class="job-card<%= job.status === 'closed' ? ' is-closed' : '' %>">
  <div class="job-card-top">
    <span class="job-logo" aria-hidden="true"><%= (job.company || job.title).trim().charAt(0).toUpperCase() %></span>
    <span class="job-card-side">
      <% if (isSample(job)) { %><span class="pill pill-sample" title="<%= t('card.sampleTitle') %>"><%= t('card.sample') %></span><% } else if (job.status === 'closed') { %><span class="pill st-rejected"><%= t('card.closed') %></span><% } else if (closingSoon(job)) { %><span class="pill st-screening"><%= closingSoon(job) %></span><% } else { %><span class="muted small"><%= daysAgo(job.posted) %></span><% } %>
      <button type="button" class="save-btn" data-save-job="<%= job.id %>" aria-pressed="false" aria-label="<%= t('card.save', { title: jt.text }) %>" title="<%= t('card.saveTitle') %>"><svg class="i" aria-hidden="true"><use href="#i-bookmark"/></svg></button>
    </span>
  </div>
  <h3><a href="<%= jobPath(job) %>"<%- jt.lang ? ' lang="' + jt.lang + '"' : '' %>><%= jt.text %></a></h3>
  <p class="muted small"><%= job.company %> · <%= tv('category', job.category) %></p>
  <span class="tag tag-<%= job.mode.toLowerCase().replace(/[^a-z]+/g, '-') %>"><%= tv('mode', job.mode) %></span>
  <% const cardWalkIn = walkInOf(job); %>
  <% if (cardWalkIn && cardWalkIn.state !== 'over') { %><span class="tag tag-walkin"><%= t('needs.walkInBadge') %><%= walkInDays(cardWalkIn) ? ': ' + walkInDays(cardWalkIn) : '' %></span><% } %>
  <% if (job.english) { %><span class="tag tag-english"><%= t('needs.english' + job.english) %></span><% } %>
  <% if (job.status === 'open' && startsNow(job)) { %><span class="tag tag-walkin"><%= t('needs.immediateTag') %></span><% } %>
  <% const cardItems = itemsOf(job).filter(function (k) { return k === 'bike' || k === 'laptop'; }); %>
  <% cardItems.forEach(function (k) { %><span class="tag tag-item"><%= t('needs.itemTag', { item: t('needs.item_' + k) }) %></span><% }) %>
  <% const cardPerks = perksOf(job).filter(function (p) { return ['food', 'stay', 'transport', 'pf'].includes(p); }).slice(0, 3); %>
  <% if (cardPerks.length) { %><span class="perk-tags"><% cardPerks.forEach(function (p) { %><span class="tag tag-perk"><%= t('needs.perk_' + p) %></span><% }) %></span><% } %>
  <ul class="job-meta">
    <li><svg class="i" aria-hidden="true"><use href="#i-pin"/></svg><span class="sr-only"><%= t('card.location') %> </span><%= areaLabel(job) ? areaLabel(job) + ', ' : '' %><%= job.location %></li>
    <li><svg class="i" aria-hidden="true"><use href="#i-clock"/></svg><span class="sr-only"><%= t('card.type') %> </span><%= tv('type', job.type) %></li>
    <% if (job.experience) { %><li><svg class="i" aria-hidden="true"><use href="#i-briefcase"/></svg><span class="sr-only"><%= t('card.experience') %> </span><%= tv('experience', job.experience) %></li><% } %>
    <% if (pay) { %><li class="job-pay"><svg class="i" aria-hidden="true"><use href="#i-wallet"/></svg><span class="sr-only"><%= t('card.salary') %> </span><%= pay %></li><% } %>
    <% const cardApplied = appliedCount(job); %>
    <% if (job.openings > 1 || cardApplied >= 5) { %><li class="job-activity"><svg class="i" aria-hidden="true"><use href="#i-users"/></svg><%= [job.openings > 1 ? t('card.openings', { n: job.openings }) : '', cardApplied >= 5 ? t('card.appliedCount', { n: cardApplied >= 100 ? '100+' : cardApplied }) : ''].filter(Boolean).join(' · ') %></li><% } %>
    <% const km = typeof distances !== 'undefined' && distances ? distances[job.id] : undefined; %>
    <% if (km !== undefined) { %><li class="job-distance"><svg class="i" aria-hidden="true"><use href="#i-pin"/></svg><% const exact = typeof nearPrecise !== 'undefined' && nearPrecise && nearPrecise[job.id]; %><%= exact ? (km < 1 ? t('near.underOneKm') : t('near.away', { km: km < 20 ? km : Math.round(km / 5) * 5 })) : km < 3 ? t('near.inYourCity') : t('near.away', { km: km < 20 ? km : Math.round(km / 5) * 5 }) %></li><% } %>
  </ul>
  <div class="chips"><% job.skills.slice(0, 4).forEach(function (s) { %><span class="chip"><%= s %></span><% }) %></div>
  <% const tap = typeof oneTap !== 'undefined' && oneTap && job.status === 'open' && !isSample(job) ? oneTap : null; %>
  <div class="job-card-actions">
    <a class="card-link" href="<%= jobPath(job) %>"><%= isSample(job) ? t('card.viewExample') : t('card.viewApply') %><span class="sr-only">: <%= jt.text %></span> <svg class="i" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    <% if (tap && tap.applied.includes(job.id)) { %><span class="pill st-hired"><svg class="i" aria-hidden="true"><use href="#i-check"/></svg> <%= t('card.applied') %></span>
    <% } else if (tap && tap.ready && (tap.hasResume || !resumeNeeded(job))) { %>
      <form method="post" action="/account/apply/<%= job.id %>" class="one-tap"><input type="hidden" name="from" value="card"><button class="btn btn-primary btn-sm" type="submit"><%= t('card.oneTap') %><span class="sr-only">: <%= jt.text %></span></button></form>
    <% } %>
  </div>
</article>
