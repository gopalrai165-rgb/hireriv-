<% if (errors.length) { %><p class="notice notice-err" role="alert">Please fix: <%= errors.join(', ') %></p><% } %>
<form class="form settings-form" method="post" action="/admin/settings">
  <section class="form-card">
    <h2>Contact details</h2>
    <p class="muted small">Shown in the header, footer, contact page, WhatsApp button and emails.</p>
    <div class="form-grid">
      <label>Phone*<input name="phone" required value="<%= form.phone %>" placeholder="+91 98765 43210"></label>
      <label>WhatsApp number* <span class="muted small">(country code, digits only)</span><input name="whatsapp" required inputmode="numeric" value="<%= form.whatsapp %>" placeholder="919876543210"></label>
      <label>Email*<input type="email" name="email" required value="<%= form.email %>"></label>
      <label>Office hours<input name="hours" value="<%= form.hours %>" placeholder="Mon – Sat, 9:30 AM – 7:00 PM"></label>
      <label class="span-2">Office address<input name="address" value="<%= form.address %>"></label>
      <label class="span-2">Tagline<input name="tagline" maxlength="160" value="<%= form.tagline %>"></label>
    </div>
  </section>

  <section class="form-card">
    <h2>Social links</h2>
    <p class="muted small">Paste the full profile address, starting with https://. Leave empty to hide the link target.</p>
    <div class="form-grid">
      <% social.forEach(function (k) { %>
        <label><%= k === 'x' ? 'X (Twitter)' : k === 'linkedin' ? 'LinkedIn' : k.charAt(0).toUpperCase() + k.slice(1) %><input type="url" name="social_<%= k %>" value="<%= form.social[k] === '#' ? '' : form.social[k] %>" placeholder="https://"></label>
      <% }) %>
    </div>
  </section>

  <section class="form-card">
    <h2>Homepage numbers</h2>
    <p class="muted small">The animated stats on the home and About pages. Leave a label empty to hide that stat.</p>
    <div class="stat-edit-grid">
      <% for (var i = 0; i < 4; i++) { var s = form.stats[i] || { value: '', suffix: '', label: '' }; %>
        <fieldset class="stat-edit">
          <legend>Stat <%= i + 1 %></legend>
          <label>Number<input type="number" min="0" name="stat_value_<%= i %>" value="<%= s.value %>"></label>
          <label>Suffix<input name="stat_suffix_<%= i %>" maxlength="3" value="<%= s.suffix %>" placeholder="+ or %"></label>
          <label class="span-2">Label<input name="stat_label_<%= i %>" maxlength="40" value="<%= s.label %>"></label>
        </fieldset>
      <% } %>
    </div>
  </section>

  <section class="form-card" id="job-categories">
    <h2>Job categories</h2>
    <p class="muted small">One per line. Used on the job form, the Find Work filter and job alerts. Renaming one here doesn't change jobs that already use the old name.</p>
    <textarea name="jobCategories" rows="10" aria-label="Job categories, one per line"><%= (form.jobCategories || []).join('\n') %></textarea>
  </section>

  <section class="form-card" id="job-locations">
    <h2>Job locations</h2>
    <p class="muted small">One city per line. Used on the job form, the Find Work filter and job alerts, and shown A–Z with Remote first.</p>
    <textarea name="jobLocations" rows="10" aria-label="Job locations, one per line"><%= (form.jobLocations || []).join('\n') %></textarea>
  </section>

  <section class="form-card" id="testimonials">
    <h2>Homepage testimonials</h2>
    <% const realTestimonials = Array.isArray(form.testimonials) ? form.testimonials : []; %>
    <% if (!Array.isArray(form.testimonials)) { %><p class="notice">The homepage is showing <b>sample</b> testimonials. Add real ones from clients or placed candidates (with their permission), or tick "Hide" below.</p><% } %>
    <p class="muted small">Up to <%= maxTestimonials %>. Use a role and company type ("HR Manager, logistics company") if the person prefers not to be named. Leave a row empty to skip it.</p>
    <% for (let i = 0; i < maxTestimonials; i++) { const t = realTestimonials[i] || {}; %>
      <fieldset class="testimonial-edit">
        <legend>Testimonial <%= i + 1 %></legend>
        <label class="span-2">Quote<textarea name="testimonial_quote_<%= i %>" rows="2" maxlength="400"><%= t.quote || '' %></textarea></label>
        <label>Name or role<input name="testimonial_name_<%= i %>" maxlength="80" value="<%= t.name || '' %>" placeholder="e.g. Head of Engineering"></label>
        <label>Company or context<input name="testimonial_detail_<%= i %>" maxlength="80" value="<%= t.detail || '' %>" placeholder="e.g. Fintech startup"></label>
        <label>Rating
          <select name="testimonial_rating_<%= i %>"><% [5, 4, 3, 2, 1].forEach(function (r) { %><option value="<%= r %>"<%= (t.rating || 5) === r ? ' selected' : '' %>><%= r %> star<%= r === 1 ? '' : 's' %></option><% }) %></select>
        </label>
      </fieldset>
    <% } %>
    <label class="notify-line"><input type="checkbox" name="testimonials_hide" value="1"<%= Array.isArray(form.testimonials) && !form.testimonials.length ? ' checked' : '' %>> Hide the testimonials section on the homepage</label>
  </section>

  <section class="form-card" id="data-retention">
    <h2>Data retention</h2>
    <p class="muted small">Automatically delete candidates who have had no activity for a while: their applications, resumes and sign-in links. Contact messages and hiring requests older than the same period are deleted too, and job alerts never confirmed within 30 days. Placements and invoices are always kept, and so are candidates with an active placement or an upcoming interview. The check runs daily, and deletions can't be undone. The activity log records each clean-up.</p>
    <% const keep = Number(form.retentionMonths) || 0; %>
    <label>Delete candidate data after
      <select name="retentionMonths">
        <option value="0"<%= keep === 0 ? ' selected' : '' %>>Never (keep until deleted by hand)</option>
        <% [12, 24, 36].forEach(function (m) { const p = retentionPreview[m]; %>
          <option value="<%= m %>"<%= keep === m ? ' selected' : '' %>><%= m %> months without activity<%= keep === m ? '' : ' · would delete ' + p.candidates + ' candidate' + (p.candidates === 1 ? '' : 's') + ' now' %></option>
        <% }) %>
      </select>
    </label>
    <% if (keep) { %><p class="muted small">On: candidates are deleted <%= keep %> months after their last activity. The Privacy Policy says so automatically.</p><% } %>
  </section>

  <section class="form-card" id="backups">
    <h2>Backups</h2>
    <% const bs = backups.status; %>
    <p class="muted small">The database is backed up automatically once a day and the newest <%= backups.keep %> copies are kept in <code><%= backups.dir %></code>. Each copy is checked after it's written. Resumes are files in the uploads folder, so back that folder up separately. For protection against a failed disk, set <code>BACKUP_DIR</code> to another disk or a synced folder.</p>
    <% if (!bs) { %><p class="notice notice-err">No backup has run yet.</p>
    <% } else if (!bs.ok) { %><p class="notice notice-err">The last backup failed (<%= new Date(bs.at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) %>): <%= bs.error %></p>
    <% } else { %><p>Last backup: <b><%= new Date(bs.at).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Kolkata' }) %></b> · <%= (bs.size / 1024).toFixed(0) %> KB</p><% } %>
    <% if (backups.list.length) { %>
      <details class="table-toggle"><summary><%= backups.list.length %> saved cop<%= backups.list.length === 1 ? 'y' : 'ies' %></summary>
        <ul class="backup-list"><% backups.list.forEach(function (b) { %><li><a href="/admin/backups/<%= b.name %>"><%= b.name %></a> <span class="muted small"><%= (b.size / 1024).toFixed(0) %> KB</span></li><% }) %></ul>
      </details>
    <% } %>
    <p><button class="btn btn-outline btn-sm" type="submit" formaction="/admin/backups/run" formmethod="post" formnovalidate>Back up now</button></p>
  </section>

  <section class="form-card">
    <h2>Billing &amp; invoices</h2>
    <p class="muted small">Printed on every invoice you issue from Placements. Already-issued invoices keep the details they were issued with.</p>
    <div class="form-grid">
      <label>Legal business name<input name="billing_legalName" maxlength="160" value="<%= billingForm.legalName %>" placeholder="<%= form.name %> Staffing Pvt Ltd"></label>
      <label>Your state<input name="billing_stateName" maxlength="60" value="<%= billingForm.stateName %>" placeholder="e.g. Karnataka"></label>
      <label>GSTIN<input name="billing_gstin" maxlength="15" value="<%= billingForm.gstin %>" placeholder="29ABCDE1234F1Z5"></label>
      <label>PAN<input name="billing_pan" maxlength="10" value="<%= billingForm.pan %>" placeholder="ABCDE1234F"></label>
      <label class="span-2">Bank details for payment<textarea name="billing_bank" rows="3" maxlength="400" placeholder="Bank, account name, account number, IFSC, UPI ID"><%= billingForm.bank %></textarea></label>
      <label>Default fee (% of annual CTC)*<input name="billing_feePercent" inputmode="decimal" required value="<%= billingForm.feePercent %>"></label>
      <label>Default replacement guarantee (days)*<input type="number" min="0" max="365" name="billing_guaranteeDays" required value="<%= billingForm.guaranteeDays %>"></label>
      <label>GST rate
        <select name="billing_gstPercent"><% [18, 12, 5, 28, 0].forEach(function (r) { %><option value="<%= r %>"<%= r === Number(billingForm.gstPercent) ? ' selected' : '' %>><%= r %>%<%= r === 0 ? ' (not GST registered)' : '' %></option><% }) %></select>
      </label>
      <label>Payment terms (days)*<input type="number" min="0" max="180" name="billing_paymentDays" required value="<%= billingForm.paymentDays %>"></label>
      <label>Usual TDS clients deduct
        <select name="billing_tdsPercent"><% [10, 2, 1, 5, 0].forEach(function (r) { %><option value="<%= r %>"<%= r === Number(billingForm.tdsPercent) ? ' selected' : '' %>><%= r %>%<%= r === 10 ? ' (194J professional fees)' : r === 2 ? ' (194J technical / 194C)' : r === 0 ? ' (none)' : '' %></option><% }) %></select>
        <span class="muted small">Pre-fills the TDS box when you record a payment. You can change it per payment.</span>
      </label>
      <label class="span-2 notify-line"><input type="checkbox" name="billing_autoReminders" value="1"<%= billingForm.autoReminders ? ' checked' : '' %>> Email overdue payment reminders automatically: once a week, up to 4 per invoice, to client-portal contacts only</label>
    </div>
  </section>

  <div class="settings-actions"><button class="btn btn-primary" type="submit">Save settings</button> <a class="btn btn-outline" href="/admin/backup">Download database backup</a></div>
</form>
