<%# Header and links shared by the trust & safety pages; each link shows only to roles that may open it. %>
<div class="admin-userbar">
  <span>Signed in as <b><%= admin.name %></b> · <%= roleLabel %></span>
  <% if (admin.role === 'Admin' || !['Verification Reviewer', 'Job Moderator', 'Support Agent', 'Trust & Safety Manager', 'Operations Admin', 'Auditor'].includes(admin.role)) { %><a class="small" href="/admin">Back to admin</a><% } %>
  <% if (!strong) { %><a class="small" href="/admin/security">Turn on two-step sign-in</a><% } %>
  <form method="post" action="/admin/logout"><button class="link-btn small" type="submit">Sign out</button></form>
</div>
<div class="admin-head">
  <div>
    <span class="eyebrow">Trust &amp; safety</span>
    <h1><%= heading %></h1>
  </div>
</div>
<nav class="account-tabs" aria-label="Trust and safety">
  <% [['overview', '/admin/overview', 'Overview', 'trust.overview'], ['verifications', '/admin/verifications', 'Verification', 'verify.review'], ['moderation', '/admin/job-moderation', 'Job moderation', 'jobs.review'], ['cases', '/admin/reports', 'Reports & cases', 'cases.view'], ['appeals', '/admin/appeals', 'Appeals', 'cases.view'], ['audit', '/admin/audit-logs', 'Audit history', 'audit.platform'], ['health', '/admin/system-health', 'System health', 'ops.health'], ['access', '/admin/access-control', 'Access control', 'access.view'], ['security', '/admin/security-events', 'Security alerts', 'security.view'], ['incidents', '/admin/incidents', 'Incidents', 'incidents.view'], ['requests', '/admin/data-requests', 'Data requests', 'privacy.requests'], ['retention', '/admin/retention', 'Retention', 'retention.view'], ['integrations', '/admin/integrations', 'Integrations', 'integrations.view'], ['ai', '/admin/ai', 'AI assistant', 'ai.view']].filter(function (t) { return can(t[3]); }).forEach(function (t) { %>
    <a href="<%= t[1] %>"<%- tab === t[0] ? ' aria-current="page" class="active"' : '' %>><%= t[2] %></a>
  <% }) %>
</nav>
<% if (typeof msg !== 'undefined' && msg) { %><p class="notice<%= /^Not /.test(msg) ? ' notice-err' : '' %>" role="status"><%= msg %></p><% } %>
<% if (typeof errors !== 'undefined' && errors.length) { %><div class="notice notice-err" role="alert"><p>Please fix:</p><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div><% } %>
