<%- include('partials/head') %>

<section class="section auth-section">
  <div class="container auth-wrap">
    <div class="form-card auth-card">
      <span class="eyebrow">Job-seeker account</span>
      <% if (typeof deleted !== 'undefined' && deleted) { %>
        <h1>Your data is deleted</h1>
        <p class="muted">We've removed your account, applications, resumes, job alerts, saved jobs and newsletter subscription. Thanks for considering <%= site.name %>.</p>
        <a class="btn btn-primary btn-block" href="/jobs">Browse jobs</a>
      <% } else if (sent) { %>
        <h1>Check your email</h1>
        <p class="notice" role="status">If you have an account or have applied with that address, a sign-in link is on its way. It works once and expires in 30 minutes.</p>
        <p class="small auth-links">Didn't get it? Check spam, or <a href="/account/login">try again</a>.</p>
      <% } else { %>
        <h1>Sign in to your account</h1>
        <% if (errors.length) { %><p class="notice notice-err" role="alert"><%= errors.join(' ') %></p><% } %>
        <form class="form" method="post" action="/account/login">
          <% if (next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
          <div class="form-grid">
            <label class="span-2">Email<input type="email" name="email" required autocomplete="email" value="<%= email %>"></label>
            <label class="span-2">Password<input type="password" name="password" autocomplete="current-password" maxlength="200"></label>
          </div>
          <button class="btn btn-primary btn-block" type="submit">Sign in</button>
          <p class="small muted form-note">No password yet? Leave it blank and we'll email you a one-time sign-in link instead. <a href="/account/forgot">Forgot password?</a></p>
        </form>
        <p class="small auth-links">New here? <a href="/account/register<%= next ? '?next=' + encodeURIComponent(next) : '' %>">Create a free account</a> · <a href="/jobs">Browse jobs</a></p>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
