<%- include('partials/head') %>

<section class="section admin">
  <div class="container">
    <div class="admin-userbar">
      <span>Signed in as <b><%= admin.name %></b> · <%= admin.role %></span>
      <form method="post" action="/admin/logout"><button class="link-btn small" type="submit">Sign out</button></form>
    </div>
    <div class="admin-head">
      <h1>Admin</h1>
      <div class="admin-actions">
        <% if (tab === 'jobs') { %><a class="btn btn-primary btn-sm" href="/admin/jobs/new">+ Post a job</a><% } %>
        <% if (tab === 'blog') { %><a class="btn btn-primary btn-sm" href="/admin/blog/new">+ Write an article</a><% } %>
        <% if (rows.length && !['blog', 'interviews', 'clients', 'team'].includes(tab) && (isAdmin || !['placements', 'activity'].includes(tab))) { %><a class="btn btn-outline btn-sm" href="/admin/export/<%= tab %>.csv">Export CSV</a><% } %>
      </div>
    </div>
    <% if (msg) { %><p class="notice" role="status"><%= msg %></p><% } %>
    <div class="tabs">
      <% tabs.forEach(function (t) { %>
        <a class="tab<%= t === tab ? ' active' : '' %>" href="/admin?tab=<%= t %>"><%= t.replace('-', ' ') %><% if (counts[t] !== '' && counts[t] !== undefined) { %> <span class="count"><%= counts[t] %></span><% } %></a>
      <% }) %>
    </div>

    <% const ownerQs = typeof owner !== 'undefined' && owner ? '&owner=' + owner : ''; %>
    <% if (tab === 'jobs' || tab === 'applications') { %>
      <div class="pipeline owner-filter">
        <span class="muted small">Owner:</span>
        <% [['', 'Everyone'], ['me', 'Mine'], ['none', 'Unassigned']].concat(members.filter(function (u) { return u.id !== admin.id; }).map(function (u) { return [u.id, u.name]; })).forEach(function (o) { %>
          <a class="pill<%= o[0] === (owner || '') ? ' active' : '' %>" href="/admin?tab=<%= tab %><%= o[0] ? '&owner=' + o[0] : '' %>"><%= o[1] %></a>
        <% }) %>
      </div>
    <% } %>

    <% if (tab === 'applications') { %>
      <div class="pipeline">
        <a class="pill<%= !status ? ' active' : '' %>" href="/admin?tab=applications<%= ownerQs %>">All <b><%= counts.applications %></b></a>
        <% statuses.forEach(function (s) { %>
          <a class="pill st-<%= s.toLowerCase() %><%= s === status ? ' active' : '' %>" href="/admin?tab=applications&status=<%= s %><%= sort ? '&sort=match' : '' %><%= ownerQs %>"><%= s %> <b><%= statusCounts[s] %></b></a>
        <% }) %>
        <span class="pipeline-sort">Sort:
          <a class="<%= !sort ? 'active' : '' %>" href="/admin?tab=applications<%= status ? '&status=' + status : '' %>">Newest</a> ·
          <a class="<%= sort ? 'active' : '' %>" href="/admin?tab=applications<%= status ? '&status=' + status : '' %>&sort=match">Best skill match</a>
        </span>
      </div>
    <% } %>

    <% if (tab === 'dashboard') { %>
      <%- include('partials/admin-dashboard', { dash: dash }) %>

    <% } else if (tab === 'clients') { %>
      <%- include('partials/admin-clients') %>

    <% } else if (tab === 'interviews') { %>
      <%- include('partials/admin-interviews') %>

    <% } else if (tab === 'placements') { %>
      <%- include('partials/admin-placements') %>

    <% } else if (tab === 'team') { %>
      <%- include('partials/admin-team') %>

    <% } else if (tab === 'activity') { %>
      <%- include('partials/admin-activity') %>

    <% } else if (!rows.length && tab !== 'talent' && tab !== 'settings') { %>
      <div class="empty"><p>No <%= status ? status.toLowerCase() + ' ' : '' %><%= tab.replace('-', ' ') %> yet.</p></div>

    <% } else if (tab === 'settings') { %>
      <%- include('partials/admin-settings') %>

    <% } else if (tab === 'blog') { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Article</th><th>Category</th><th>Date</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% rows.forEach(function (p) { %>
              <tr>
                <td><b><%= p.title %></b><br><span class="muted">/blog/<%= p.slug %></span></td>
                <td><%= p.category %></td>
                <td><%= formatDate(p.date) %></td>
                <td><span class="pill st-<%= p.status === 'draft' ? 'screening' : 'hired' %>"><%= p.status === 'draft' ? 'Draft' : 'Published' %></span></td>
                <td class="row-actions">
                  <% if (p.status !== 'draft') { %><a class="btn btn-outline btn-sm" href="/blog/<%= p.slug %>" target="_blank" rel="noopener">View</a><% } %>
                  <a class="btn btn-outline btn-sm" href="/admin/blog/<%= p.slug %>/edit">Edit</a>
                  <% if (isAdmin) { %><form method="post" action="/admin/blog/<%= p.slug %>/delete" data-confirm="Delete this article permanently?"><button class="btn btn-sm btn-danger">Delete</button></form><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } else if (tab === 'talent') { %>
      <%- include('partials/admin-talent') %>

    <% } else if (tab === 'jobs') { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Job</th><th>Location</th><th>Owner</th><th>Posted</th><th>Applicants</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% rows.forEach(function (j) { %>
              <tr>
                <td><a href="/jobs/<%= j.id %>" target="_blank" rel="noopener"><b><%= j.title %></b></a><br><span class="muted"><%= j.company %> · <%= j.category %> · <%= j.id %></span></td>
                <td><%= j.location %><br><span class="muted"><%= j.mode %> · <%= j.type %></span></td>
                <td><%= j.ownerId ? (memberName[j.ownerId] || 'Former member') : '—' %></td>
                <td><%= formatDate(j.posted) %></td>
                <td><a href="/admin?tab=applications"><%= applicants[j.id] || 0 %></a></td>
                <td><span class="pill st-<%= j.status === 'open' ? 'hired' : 'rejected' %>"><%= j.status === 'open' ? 'Open' : 'Closed' %></span></td>
                <td class="row-actions">
                  <a class="btn btn-outline btn-sm" href="/admin/jobs/<%= j.id %>/edit">Edit</a>
                  <form method="post" action="/admin/jobs/<%= j.id %>/toggle"><button class="btn btn-outline btn-sm"><%= j.status === 'open' ? 'Close' : 'Reopen' %></button></form>
                  <% if (isAdmin) { %><form method="post" action="/admin/jobs/<%= j.id %>/delete" data-confirm="Delete this job permanently? Existing applications are kept."><button class="btn btn-sm btn-danger">Delete</button></form><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } else if (tab === 'applications') { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Candidate</th><th>Job</th><th>Profile</th><th>Received</th><th>Pipeline</th><th></th></tr></thead>
          <tbody>
            <% rows.forEach(function (r) { %>
              <tr>
                <td><b><%= r.name %></b><% if (r.withdrawnAt) { %> <span class="pill st-rejected" title="Withdrawn <%= formatDate(r.withdrawnAt) %>">Withdrawn</span><% } %><br><a href="mailto:<%= r.email %>"><%= r.email %></a><br><%= r.phone %>
                  <% if (r.linkedin) { %><br><a href="<%= /^https?:\/\//i.test(r.linkedin) ? r.linkedin : '#' %>" target="_blank" rel="noopener noreferrer">LinkedIn / portfolio</a><% } %>
                  <% if (r.resume) { %><br><a href="/admin/resume/<%= encodeURIComponent(r.resume) %>">Download resume</a><% } %>
                </td>
                <td><%= r.jobTitle %><% if (r.match) { %><br><%- include('partials/match-chip', { match: r.match }) %><% } %><% if (r.skills) { %><br><span class="muted small">Skills: <%= r.skills %></span><% } %></td>
                <td><%= r.experience %><br><span class="muted"><%= r.location || '—' %> · notice <%= r.noticePeriod %></span>
                  <% if (r.message) { %><details><summary>Message</summary><%= r.message %></details><% } %>
                </td>
                <td><%= new Date(r.createdAt).toLocaleString('en-IN') %></td>
                <td>
                  <form class="form status-form" method="post" action="/admin/applications/<%= r.id %>/status">
                    <input type="hidden" name="filter" value="<%= status %>">
                    <select name="status" aria-label="Status for <%= r.name %>">
                      <% statuses.forEach(function (s) { %><option<%= s === (r.status || 'New') ? ' selected' : '' %>><%= s %></option><% }) %>
                    </select>
                    <select name="ownerId" aria-label="Owner for <%= r.name %>">
                      <option value="job">Owner: job's recruiter<%= r.owner && !r.ownerId ? ' (' + (memberName[r.owner] || '—') + ')' : '' %></option>
                      <% members.forEach(function (u) { %><option value="<%= u.id %>"<%= r.ownerId === u.id ? ' selected' : '' %>>Owner: <%= u.name %></option><% }) %>
                    </select>
                    <textarea name="notes" rows="2" placeholder="Recruiter notes" aria-label="Notes for <%= r.name %>"><%= r.notes || '' %></textarea>
                    <label class="notify"><input type="checkbox" name="notify" value="1" checked> Email candidate on Interview / Offered / Hired / Rejected</label>
                    <% if (r.lastEmailedStatus) { %><span class="muted small">Last emailed: <%= r.lastEmailedStatus %></span><% } %>
                    <button class="btn btn-primary btn-sm">Save</button>
                  </form>
                  <% const nextIv = (r.interviews || []).filter(function (iv) { return iv.status === 'scheduled' && new Date(iv.at) > new Date(); }).sort(function (x, y) { return x.at.localeCompare(y.at); })[0]; %>
                  <% if (nextIv) { %><p class="iv-next">Interview: <b><%= formatIst(nextIv.at) %></b></p><% } %>
                  <a class="small iv-link" href="/admin/applications/<%= r.id %>/interview">+ Schedule interview</a>
                  <% if (placedApps.has(r.id)) { %><br><a class="small iv-link" href="/admin?tab=placements">✓ Placement recorded</a>
                  <% } else if (['Offered', 'Hired'].includes(r.status)) { %><br><a class="small iv-link" href="/admin/applications/<%= r.id %>/placement">+ Record placement</a><% } %>
                  <% const sharedClient = r.shared ? clientOptions.find(function (c) { return c.id === r.shared.employerId; }) : null; %>
                  <% if (r.shared) { %>
                    <div class="share-status">
                      Shared with <b><%= sharedClient ? sharedClient.company : 'a client' %></b>
                      <% if (r.shared.feedback) { %><br><span class="pill fb-<%= r.shared.feedback.decision.toLowerCase().split(' ').join('-') %>"><%= r.shared.feedback.decision %></span><% if (r.shared.feedback.comment) { %> <span class="muted small">“<%= r.shared.feedback.comment %>”</span><% } %>
                      <% } else { %><br><span class="muted small">Awaiting client feedback</span><% } %>
                      <form method="post" action="/admin/applications/<%= r.id %>/unshare" data-confirm="Stop sharing this candidate with the client?"><button class="link-btn small">Stop sharing</button></form>
                    </div>
                  <% } %>
                  <% if (clientOptions.length) { %>
                    <details class="share-client"><summary class="small"><%= r.shared ? 'Edit shared note' : '+ Share with client' %></summary>
                      <form class="form" method="post" action="/admin/applications/<%= r.id %>/share">
                        <select name="employerId" aria-label="Client"><% clientOptions.forEach(function (c) { %><option value="<%= c.id %>"<%= c.id === (r.shared ? r.shared.employerId : jobClient[r.jobId]) ? ' selected' : '' %>><%= c.company %></option><% }) %></select>
                        <textarea name="summary" rows="2" maxlength="1000" placeholder="Why this candidate fits (the client sees this)"><%= r.shared ? r.shared.summary : '' %></textarea>
                        <button class="btn btn-outline btn-sm"><%= r.shared ? 'Save' : 'Share' %></button>
                      </form>
                    </details>
                  <% } %>
                </td>
                <td><% if (isAdmin) { %><form method="post" action="/admin/applications/<%= r.id %>/delete" data-confirm="Delete this application and its resume?"><button class="btn btn-sm btn-danger">Delete</button></form><% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } else { %>
      <% const cols = [...new Set(rows.flatMap(function (r) { return Object.keys(r); }))].filter(function (k) { return k !== 'id' && k !== 'token'; }); %>
      <div class="table-wrap">
        <table>
          <thead><tr><% cols.forEach(function (c) { %><th><%= c %></th><% }) %><th></th></tr></thead>
          <tbody>
            <% rows.forEach(function (r) { %>
              <tr>
                <% cols.forEach(function (c) { %>
                  <td><% if (c === 'createdAt') { %><%= new Date(r[c]).toLocaleString('en-IN') %><% } else { %><%= r[c] %><% } %></td>
                <% }) %>
                <td><% if (isAdmin) { %><form method="post" action="/admin/<%= tab %>/<%= r.id %>/delete" data-confirm="Delete this entry?"><button class="btn btn-sm btn-danger">Delete</button></form><% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
