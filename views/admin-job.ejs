<%- include('partials/head') %>

<section class="section admin">
  <div class="container narrow">
    <a href="/admin?tab=jobs" class="back-link">← All jobs</a>
    <h1><%= title %></h1>
    <% if (errors.length) { %><p class="notice notice-err" role="alert">Please fix: <%= errors.join(', ') %></p><% } %>
    <form class="form form-card" method="post" action="/admin/jobs<%= job.id ? '/' + job.id : '' %>">
      <div class="form-grid">
        <label class="span-2">Job title*<input name="title" required value="<%= job.title || '' %>" placeholder="e.g. Senior Java Developer"></label>
        <label>Company / client*<input name="company" required value="<%= job.company || '' %>" placeholder="e.g. Fintech Client"></label>
        <label>Location*
          <select name="location" required>
            <option value="">Choose a location</option>
            <% jobLocations.forEach(function (l) { %><option<%= l === job.location ? ' selected' : '' %>><%= l %></option><% }) %>
          </select>
          <span class="muted small">Add cities in <a href="/admin?tab=settings#job-locations">Settings</a>.</span>
        </label>
        <label>Work mode
          <select name="mode"><% modes.forEach(function (m) { %><option<%= m === job.mode ? ' selected' : '' %>><%= m %></option><% }) %></select>
          <span class="muted small">Field work: travelling or on-the-ground roles. Client site: deployed at the client's office. Remote jobs reach job-alert subscribers in every city.</span>
        </label>
        <label>Job type
          <select name="type"><% jobTypes.forEach(function (t) { %><option<%= t === job.type ? ' selected' : '' %>><%= t %></option><% }) %></select>
          <span class="muted small">Temporary: a fixed short period. Daily wage / Gig: paid per day or per task. Apprenticeship: paid on-the-job training.</span>
        </label>
        <label>Category*
          <select name="category" required>
            <option value="">Choose a category</option>
            <% categoryGroups.forEach(function (g) { %><optgroup label="<%= g.label %>"><% g.categories.forEach(function (c) { %><option<%= c === job.category ? ' selected' : '' %>><%= c %></option><% }) %></optgroup><% }) %>
          </select>
          <span class="muted small">Add or rename categories in <a href="/admin?tab=settings#job-categories">Settings</a>.</span>
        </label>
        <label>Kind of work
          <select name="work">
            <option value="">Same as the category<%= job.category ? ' (' + workLabel(workOf({ category: job.category })) + ')' : '' %></option>
            <% workKinds.forEach(function (c) { %><option value="<%= c.key %>"<%= c.key === job.work ? ' selected' : '' %>><%= c.label %></option><% }) %>
          </select>
          <span class="muted small">Sets which tab the job appears under on Find Work. Change it for jobs that don't fit their category, e.g. a site supervisor in Construction.</span>
        </label>
        <label>Resume
          <select name="resume">
            <option value="">Same as the kind of work (required for office jobs)</option>
            <option value="required"<%= job.resume === 'required' ? ' selected' : '' %>>Required, with an email address</option>
            <option value="optional"<%= job.resume === 'optional' ? ' selected' : '' %>>Optional: quick apply with name and phone</option>
          </select>
          <span class="muted small">Quick apply suits jobs where most people don't have a resume or email. It also shows an "Apply on WhatsApp" button once your WhatsApp number is in Settings.</span>
        </label>
        <label>Experience<input name="experience" value="<%= job.experience || '' %>" placeholder="e.g. 3-5 years"></label>
        <% const pf = job.payForm || (job.pay ? { salaryMin: job.pay.min || '', salaryMax: job.pay.max || '', salaryPeriod: job.pay.period } : {}); %>
        <fieldset class="span-2 pay-fields">
          <legend>Pay <span class="muted small">(in rupees; leave both blank if not disclosed)</span></legend>
          <label>From ₹<input name="salaryMin" inputmode="numeric" value="<%= pf.salaryMin || '' %>" placeholder="e.g. 18000"></label>
          <label>Up to ₹<input name="salaryMax" inputmode="numeric" value="<%= pf.salaryMax || '' %>" placeholder="e.g. 24000"></label>
          <label>Per
            <select name="salaryPeriod">
              <% [['month', 'Month'], ['year', 'Year (CTC)'], ['day', 'Day'], ['hour', 'Hour']].forEach(function (o) { %><option value="<%= o[0] %>"<%= (pf.salaryPeriod || 'month') === o[0] ? ' selected' : '' %>><%= o[1] %></option><% }) %>
            </select>
          </label>
          <label>Note <span class="muted small">(optional)</span><input name="payNote" maxlength="120" value="<%= job.payNote || '' %>" placeholder="e.g. + PF & ESI, + incentives"></label>
          <span class="muted small span-all">Yearly pay of ₹1 lakh or more shows as LPA, e.g. 1400000 to 2000000 a year shows as ₹14 – 20 LPA.</span>
        </fieldset>
        <label>Education <span class="muted small">(optional)</span><input name="education" maxlength="200" value="<%= job.education || '' %>" placeholder="e.g. ITI / Diploma, or B.Com"></label>
        <label>Work schedule <span class="muted small">(optional)</span><input name="schedule" maxlength="200" value="<%= job.schedule || '' %>" placeholder="e.g. Day shift, Mon–Sat, 9 am – 6 pm"></label>
        <label>Shift<select name="shift"><option value="">Not specified</option><% ['Day', 'Night', 'Rotational', 'Flexible'].forEach(function (sh) { %><option<%= job.shift === sh ? ' selected' : '' %>><%= sh %></option><% }) %></select></label>
        <label>Working hours <span class="muted small">(optional)</span><input name="hours" maxlength="120" value="<%= job.hours || '' %>"></label>
        <label class="span-2">Overtime <span class="muted small">(optional; when it happens and how it is paid, e.g. "Up to 2 hours a day, paid at double the hourly rate")</span><input name="overtime" maxlength="200" value="<%= job.overtime || '' %>"></label>
        <label class="span-2">Costs the worker pays <span class="muted small">(optional; e.g. "None", "Uniform deposit ₹500, returned when you leave", "Room ₹1,500 a month if you use the hostel")</span><input name="workerCosts" maxlength="300" value="<%= job.workerCosts || '' %>"></label>
        <label>Openings <span class="muted small">(optional)</span><input name="openings" inputmode="numeric" maxlength="4" value="<%= job.openings || '' %>"></label>
        <label class="span-2">Workplace address <span class="muted small">(optional)</span><input name="address" maxlength="300" value="<%= job.address || '' %>"></label>
        <label class="span-2 check-row"><input type="checkbox" name="walkIn" value="1"<%= job.walkIn ? ' checked' : '' %>> <span>Walk-in interviews at this address</span></label>
        <label>Client <span class="muted small">(lets this client see the job in their portal)</span>
          <select name="employerId">
            <option value="">No client (Hireriv job)</option>
            <% clientOptions.forEach(function (c) { %><option value="<%= c.id %>"<%= c.id === job.employerId ? ' selected' : '' %>><%= c.company %> · <%= c.name %></option><% }) %>
          </select>
        </label>
        <label>Recruiter <span class="muted small">(owns this job and its applicants)</span>
          <select name="ownerId">
            <option value="">Unassigned</option>
            <% members.forEach(function (u) { %><option value="<%= u.id %>"<%= u.id === job.ownerId ? ' selected' : '' %>><%= u.name %> · <%= u.role %></option><% }) %>
          </select>
        </label>
        <label>Status
          <select name="status">
            <option value="open"<%= job.status !== 'closed' ? ' selected' : '' %>>Open – accepting applications</option>
            <option value="closed"<%= job.status === 'closed' ? ' selected' : '' %>>Closed – hidden from listings</option>
          </select>
          <% if (job.closedReason) { %><span class="muted small">Closed automatically: <%= job.closedReason.toLowerCase() %>.</span><% } %>
        </label>
        <label>Closes on <span class="muted small">(optional)</span>
          <input type="date" name="closesOn" value="<%= job.closesOn || '' %>">
          <span class="muted small">The last day to apply. The job closes by itself after this date. Leave blank to keep it open until you close it.</span>
        </label>
        <label class="span-2">Key skills <span class="muted small">(comma separated)</span><input name="skills" value="<%= (job.skills || []).join(', ') %>" placeholder="React, Node.js, AWS"></label>
        <label class="span-2">About the role*<textarea name="description" rows="3" required><%= job.description || '' %></textarea></label>
        <label class="span-2">Responsibilities <span class="muted small">(one per line)</span><textarea name="responsibilities" rows="5"><%= (job.responsibilities || []).join('\n') %></textarea></label>
        <label class="span-2">Qualifications and requirements <span class="muted small">(one per line, optional)</span><textarea name="qualifications" rows="3" placeholder="e.g. Valid two-wheeler licence"><%= (job.qualifications || []).join('\n') %></textarea></label>
        <label class="span-2">Who can apply <span class="muted small">(one per line, optional)</span><textarea name="eligibility" rows="2"><%= (job.eligibility || []).join('\n') %></textarea></label>
        <label class="span-2">Licences or certificates needed <span class="muted small">(one per line, optional, e.g. "Forklift licence", "Two-wheeler driving licence"; shown to candidates as must-haves, apart from the match score)</span><textarea name="mustHave" rows="2"><%= (job.mustHave || []).join('\n') %></textarea></label>
        <label class="span-2">Physical work <span class="muted small">(optional; only what the work really involves, e.g. "Lifting boxes up to 20 kg", "Standing for the whole shift")</span><input name="physical" maxlength="200" value="<%= job.physical || '' %>"></label>
        <label class="span-2 check-row"><input type="checkbox" name="immediate" value="1"<%= job.immediate ? ' checked' : '' %>> <span>Needs people who can start straight away</span></label>
        <label class="span-2">Benefits <span class="muted small">(one per line, optional)</span><textarea name="benefits" rows="3" placeholder="e.g. PF and ESI&#10;Free meals"><%= (job.benefits || []).join('\n') %></textarea></label>
      </div>
      <button class="btn btn-primary" type="submit"><%= job.id ? 'Save changes' : 'Publish job' %></button>
      <a class="btn btn-outline" href="/admin?tab=jobs">Cancel</a>
      <% if (job.id && translationStatus(job).length) { %>
        <p class="small muted">Translations (shown to candidates only once approved, next to the original):
          <% translationStatus(job).forEach(function (tr) { %><a href="/admin/jobs/<%= job.id %>/translations/<%= tr.code %>"><span lang="<%= tr.code %>"><%= tr.native %></span></a> <span class="pill"><%= { approved: 'Approved', outdated: 'Needs checking', draft: 'Draft', none: 'Not translated' }[tr.state] %></span> <% }) %>
        </p>
      <% } %>
    </form>
  </div>
</section>

<%- include('partials/foot') %>
