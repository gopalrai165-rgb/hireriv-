<%- include('partials/head') %>

<section class="section auth-section">
  <div class="container auth-wrap">
    <div class="form-card auth-card">
      <span class="eyebrow"><%= site.name %> team</span>
      <h1>Enter your code</h1>
      <p class="muted">Open your authenticator app and enter the 6-digit code for <%= site.name %>. Lost your phone? Enter one of your recovery codes instead.</p>
      <% if (errors.length) { %><p class="notice notice-err" role="alert"><%= errors.join(' ') %></p><% } %>
      <form class="form" method="post" action="/admin/login/code">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="form-grid">
          <label class="span-2">Code<input class="code-input" name="code" required autofocus autocomplete="one-time-code" inputmode="numeric" maxlength="12" autocapitalize="none" spellcheck="false"></label>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Sign in</button>
      </form>
      <p class="small auth-links">No phone and no recovery codes? Ask an Admin on your team to reset your two-step sign-in. <a href="/admin/login">Start again</a></p>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
