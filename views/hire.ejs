<%- include('partials/head') %>

<section class="page-hero">
  <span class="deco deco-spark" aria-hidden="true"></span><span class="deco deco-dots" aria-hidden="true"></span><span class="deco deco-squiggle" aria-hidden="true"></span>
  <div class="container split">
    <div>
      <span class="eyebrow">Hire a team</span>
      <h1>Hire screened candidates for IT and non-IT roles</h1>
      <p class="lead">Share your requirement and a Hireriv client partner will call you within one working day. No commitment until you're happy with the shortlist.</p>
      <ul class="checks">
        <li>A recruiter calls you back within one working day</li>
        <li>Every candidate screened by a recruiter before you see them</li>
        <li>Dedicated account manager and weekly updates</li>
        <li>Background verification and replacement guarantee</li>
      </ul>
      <div class="mini-stats">
        <% const guaranteeDays = site.billing ? site.billing.guaranteeDays : 90; %>
        <% if (guaranteeDays > 0) { %><div><b><%= guaranteeDays %> days</b><span>replacement guarantee</span></div><% } %>
      </div>
    </div>
    <div class="form-card" id="requirement">
      <h2>Tell us what you need</h2>
      <form class="form js-form" action="/api/hire" method="post" enctype="multipart/form-data">
        <% if (typeof from !== 'undefined' && from) { %><input type="hidden" name="from" value="<%= from %>"><% } %>
  <%- include('partials/honeypot') %>
        <div class="form-grid">
          <label>Company name*<input name="company" required autocomplete="organization"></label>
          <label>Company website<input name="companySite" inputmode="url" autocomplete="url" placeholder="www.yourcompany.com"></label>
          <label>Your name*<input name="name" required autocomplete="name"></label>
          <label>Phone*<input type="tel" name="phone" required autocomplete="tel"></label>
          <label class="span-2">Work email*<input type="email" name="email" required autocomplete="email"></label>
          <fieldset class="span-2 choice-row">
            <legend>IT or non-IT hiring?</legend>
            <% ['IT', 'Non-IT', 'Both'].forEach(function (f) { %><label class="check-row"><input type="radio" name="field" value="<%= f %>"<%= f === selectedField ? ' checked' : '' %>> <%= f %></label><% }) %>
          </fieldset>
          <label>Department<input name="department" maxlength="120" placeholder="e.g. Engineering, Sales, Warehouse"></label>
          <label>Number of hires
            <select name="headcount"><option>1</option><option>2-5</option><option>6-20</option><option>21-50</option><option>50+</option></select>
          </label>
          <label class="span-2">Roles you're hiring for*<input name="roles" required placeholder="e.g. 3 React developers, 1 QA lead"></label>
          <label>Permanent or contract?
            <select name="hiringType"><% hireOptions.forEach(function (o) { %><option<%= o === selectedService ? ' selected' : '' %>><%= o %></option><% }) %></select>
          </label>
          <label>City<input name="location" maxlength="120" placeholder="e.g. Pune, or Remote"></label>
          <label>Salary budget<input name="budget" maxlength="120" placeholder="e.g. ₹25,000 – 30,000 a month"></label>
          <label>Hiring deadline<input type="date" name="deadline" min="<%= new Date().toISOString().slice(0, 10) %>"></label>
          <label class="span-2">Job description <span class="muted small">(optional, PDF or Word, up to 5 MB)</span><input type="file" name="jd" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"></label>
          <label class="span-2">Additional requirements<textarea name="message" rows="3" placeholder="Must-have skills, shift timings, languages, joining date…"></textarea></label>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Submit requirement</button>
        <p class="muted small form-note">You get a confirmation email straight away. We use these details only to respond to your requirement. See our <a href="/privacy">Privacy Policy</a>.</p>
      </form>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Engagement models</span>
      <h2>Flexible ways to work with us</h2>
    </div>
    <div class="services-grid">
      <div class="service-card"><span class="service-icon"><svg class="i"><use href="#i-users"/></svg></span><h3>Permanent hiring</h3><p>Success-fee model: you pay only when a candidate joins. Ideal for core, long-term roles.</p></div>
      <div class="service-card"><span class="service-icon"><svg class="i"><use href="#i-clock"/></svg></span><h3>Contract staffing</h3><p>Talent on our payroll for a fixed term, with compliance and benefits handled by us.</p></div>
      <div class="service-card"><span class="service-icon"><svg class="i"><use href="#i-target"/></svg></span><h3>Executive search</h3><p>Retained, confidential search for CXO, VP and niche leadership roles.</p></div>
      <div class="service-card"><span class="service-icon"><svg class="i"><use href="#i-chart"/></svg></span><h3>Bulk &amp; RPO</h3><p>Dedicated recruiters embedded in your hiring process for volume or ongoing hiring.</p></div>
      <div class="service-card"><span class="service-icon"><svg class="i"><use href="#i-shield"/></svg></span><h3>Background checks</h3><p>Standalone verification for your own hires: employment, education, address and more.</p></div>
      <div class="service-card"><span class="service-icon"><svg class="i"><use href="#i-graduation"/></svg></span><h3>Training &amp; onboarding</h3><p>Industry-specific training to get new hires productive faster.</p></div>
    </div>
  </div>
</section>

<section class="section section-dark">
  <div class="container">
    <div class="section-head light">
      <span class="eyebrow">How it works</span>
      <h2>From brief to joining in four steps</h2>
    </div>
    <ol class="process process-4">
      <li class="process-step"><span class="step-num">01</span><h3>Share your brief</h3><p>Fill the form or call us. We'll set up a 20-minute requirement call.</p></li>
      <li class="process-step"><span class="step-num">02</span><h3>Get a shortlist</h3><p>Screened, assessed profiles with a recruiter note on each candidate.</p></li>
      <li class="process-step"><span class="step-num">03</span><h3>Interview</h3><p>We schedule rounds, collect feedback and keep candidates engaged.</p></li>
      <li class="process-step"><span class="step-num">04</span><h3>Hire &amp; onboard</h3><p>Offer negotiation, background checks and follow-up until day one.</p></li>
    </ol>
  </div>
</section>

<%- include('partials/employer-pitch') %>

<%- include('partials/foot') %>
