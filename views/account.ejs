<%- include('partials/head') %>

<section class="section admin portal">
  <div class="container">
    <div class="admin-head">
      <div>
        <span class="eyebrow">My account</span>
        <h1>Hi <%= String(profile.name || '').split(' ')[0] || 'there' %></h1>
        <p class="muted">Signed in as <%= email %></p>
      </div>
      <form method="post" action="/account/logout"><button class="btn btn-outline btn-sm" type="submit">Log out</button></form>
    </div>
    <% if (msg) { %><p class="notice" role="status"><%= msg %></p><% } %>

    <% if (contracts.length) { %>
      <section class="dash-card dash-wide app-list">
        <div class="dash-head"><h2>Your contracts</h2><span class="muted small">Log your days every week</span></div>
        <% contracts.forEach(function (c) { %>
          <article class="my-app">
            <div class="my-app-head">
              <div>
                <h3><%= c.jobTitle %> at <%= c.company %></h3>
                <p class="muted small"><%= c.contractEnd ? 'Contract to ' + formatDate(c.contractEnd) : 'Ongoing contract' %></p>
              </div>
              <a class="btn btn-primary btn-sm" href="/account/timesheets/<%= c.id %>">Timesheets</a>
            </div>
            <p class="small">
              <% if (c.rejected) { %><span class="pill st-rejected"><%= c.rejected %> sent back</span> <% } %>
              <% if (c.missing) { %><span class="pill st-screening"><%= c.missing %> week<%= c.missing === 1 ? '' : 's' %> not logged</span> <% } %>
              <% if (c.submitted) { %><span class="pill st-interview"><%= c.submitted %> waiting for approval</span><% } %>
              <% if (!c.rejected && !c.missing && !c.submitted) { %><span class="muted">All caught up.</span><% } %>
            </p>
          </article>
        <% }) %>
      </section>
    <% } %>

    <section class="dash-card dash-wide" id="jobs-for-you">
      <div class="dash-head"><h2>Jobs for you</h2><a class="small" href="/jobs">All jobs</a></div>
      <% if (!matches.length) { %>
        <p class="muted dash-empty">No matches yet. Add your key skills and city to <a href="#profile">your profile</a> and we'll show open jobs that fit.</p>
      <% } else { %>
        <ul class="match-list">
          <% matches.forEach(function (m) { %>
            <li>
              <div>
                <a href="<%= jobPath(m.job) %>"><b><%= m.job.title %></b></a>
                <span class="muted small"><%= m.job.company %> · <%= m.job.location %> · <%= m.job.type %><%= m.job.salary ? ' · ' + m.job.salary : '' %></span>
                <% if (m.matched.length) { %><span class="small">Your skills: <%= m.matched.join(', ') %></span><% } else if (m.near) { %><span class="small">Near you</span><% } %>
              </div>
              <a class="btn btn-outline btn-sm" href="<%= jobPath(m.job) %>#apply">View &amp; apply</a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <section class="dash-card dash-wide app-list">
      <div class="dash-head"><h2>Your applications</h2><a class="small" href="/jobs">Find more jobs</a></div>
      <% if (!apps.length) { %><p class="muted dash-empty">No applications found.</p><% } %>
      <% apps.forEach(function (a) { %>
        <article class="my-app">
          <div class="my-app-head">
            <div>
              <h3><% if (a.jobId && a.jobOpen) { %><a href="/jobs/<%= a.jobId %>"><%= a.jobTitle %></a><% } else { %><%= a.jobTitle %><% } %></h3>
              <p class="muted small">Applied <%= formatDate(a.createdAt) %><% if (a.hasResume) { %> · <a href="<%= signedLink('/account/resume/' + a.id) %>">Your resume</a><% } %></p>
            </div>
            <span class="pill <%= a.withdrawn || a.stage === 'Not selected' ? 'st-rejected' : a.stage === 'Hired' || a.stage === 'Offer' ? 'st-hired' : 'st-interview' %>"><%= a.stage %></span>
          </div>
          <% if (!a.withdrawn && a.stage !== 'Not selected') { %>
            <ol class="steps" aria-label="Progress">
              <% steps.forEach(function (s, i) { %><li class="<%= i < a.stepIndex ? 'done' : i === a.stepIndex ? 'current' : '' %>"<%= i === a.stepIndex ? ' aria-current="step"' : '' %>><span><%= s %></span></li><% }) %>
            </ol>
          <% } else if (a.stage === 'Not selected') { %>
            <p class="small muted">The team went ahead with other candidates for this role. Your profile stays in our talent pool for future matches.</p>
          <% } %>
          <% a.interviews.forEach(function (iv) { %>
            <div class="my-iv">
              <b>Interview: <%= formatIst(iv.at) %></b> · <%= iv.duration %> min · <%= iv.mode %>
              <% if (/^https:\/\//.test(iv.where)) { %> · <a href="<%= iv.where %>" target="_blank" rel="noopener noreferrer">Join link</a><% } else if (iv.where) { %> · <%= iv.where %><% } %>
              · <a href="/account/interviews/<%= a.id %>/<%= iv.id %>.ics">Add to calendar</a>
            </div>
          <% }) %>
          <% if (!a.withdrawn && !a.closedOut) { %>
            <form method="post" action="/account/applications/<%= a.id %>/withdraw" data-confirm="Withdraw your application for <%= a.jobTitle %>? This can't be undone."><button class="link-btn small withdraw">Withdraw application</button></form>
          <% } %>
        </article>
      <% }) %>
    </section>

    <div class="dash-grid">
      <section class="dash-card" id="profile">
        <div class="dash-head"><h2>Your profile</h2></div>
        <p class="muted small">Used for one-click applying and job matches. Keep it up to date and recruiters will match you to new roles faster. Changes apply to all your applications.</p>
        <form class="form" method="post" action="/account/profile">
          <div class="form-grid">
            <label>Full name<input name="name" maxlength="120" autocomplete="name" value="<%= profile.name || '' %>"></label>
            <label>Mobile number<input type="tel" name="phone" maxlength="20" autocomplete="tel" value="<%= profile.phone || '' %>"></label>
            <label class="span-2">Key skills<input name="skills" maxlength="500" value="<%= profile.skills || '' %>" placeholder="e.g. React, Node.js, AWS"></label>
            <label>Experience
              <select name="experience"><option value="">Select…</option><% experienceOptions.forEach(function (o) { %><option<%= o === profile.experience ? ' selected' : '' %>><%= o %></option><% }) %></select>
            </label>
            <label>Notice period
              <select name="noticePeriod"><option value="">Select…</option><% noticeOptions.forEach(function (o) { %><option<%= o === profile.noticePeriod ? ' selected' : '' %>><%= o %></option><% }) %></select>
            </label>
            <label class="span-2">Current city<input name="location" maxlength="120" value="<%= profile.location || '' %>"></label>
            <label class="span-2">LinkedIn / portfolio<input type="url" name="linkedin" maxlength="300" value="<%= profile.linkedin || '' %>" placeholder="https://"></label>
          </div>
          <button class="btn btn-primary" type="submit">Save profile</button>
        </form>
        <h3 class="dash-sub">Resume</h3>
        <% if (profile.resume) { %>
          <p class="small">On file since <%= formatDate(profile.resume.at) %> · <a href="<%= signedLink('/account/resume/' + profile.resume.appId) %>">Download</a></p>
        <% } else { %>
          <p class="small muted">No resume yet. Office jobs need one for one-click applying.</p>
        <% } %>
        <form class="form inline-upload" method="post" action="/account/resume" enctype="multipart/form-data">
          <label class="file-field"><%= profile.resume ? 'Replace resume' : 'Upload resume' %> <span class="muted small">(PDF, DOC or DOCX, max 5 MB)</span><input type="file" name="resume" accept=".pdf,.doc,.docx" required></label>
          <button class="btn btn-outline btn-sm" type="submit">Upload</button>
        </form>
      </section>

      <section class="dash-card" id="alerts">
        <div class="dash-head"><h2>Job alerts</h2></div>
        <p class="muted small">We email you the first time a matching job goes live.</p>
        <% if (alerts.length) { %>
          <ul class="alert-list">
            <% alerts.forEach(function (s) { %>
              <li>
                <span><b><%= s.category || 'All jobs' %></b> · <%= s.location || 'Any city' %><% if (!s.confirmed) { %> <span class="pill st-screening">Not confirmed</span><% } %></span>
                <form method="post" action="/account/alerts/<%= s.id %>/delete"><button class="link-btn small" type="submit" aria-label="Remove job alert for <%= s.category || 'all jobs' %> in <%= s.location || 'any city' %>">Remove</button></form>
              </li>
            <% }) %>
          </ul>
        <% } %>
        <form class="form" method="post" action="/account/alerts">
          <div class="form-grid">
            <label>Category<select name="category"><option value="">All categories</option><% categories.forEach(function (c) { %><option><%= c %></option><% }) %></select></label>
            <label>City<select name="location"><option value="">Any city</option><% locations.forEach(function (l) { %><option><%= l %></option><% }) %></select></label>
          </div>
          <button class="btn btn-outline btn-sm" type="submit">Add job alert</button>
        </form>
        <p class="small muted">Saved jobs are kept on this device: <a href="/saved">see your saved jobs</a>.</p>
      </section>

      <section class="dash-card">
        <div class="dash-head"><h2>Your data</h2></div>
        <p class="muted small">Download a copy of what we hold about you: your applications and details, their progress, interviews, emails we sent you, and your job alerts.</p>
        <p><a class="btn btn-outline btn-sm" href="/account/my-data.json" download>Download my data</a></p>
        <p class="muted small">You can delete your account and everything we hold about you: your profile, all applications, resumes, job alerts and newsletter subscription. This can't be undone.</p>
        <form class="form delete-data" method="post" action="/account/delete" data-confirm="Permanently delete all your data?">
          <label>Type DELETE to confirm<input name="confirm" autocomplete="off" required pattern="[Dd][Ee][Ll][Ee][Tt][Ee]"></label>
          <button class="btn btn-sm btn-danger" type="submit">Delete my data</button>
        </form>
      </section>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
