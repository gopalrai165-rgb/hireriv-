<%- include('partials/head') %>

<section class="section admin portal">
  <div class="container">
    <%- include('partials/account-nav', { heading: 'Hi ' + (String(profile.name || '').split(' ')[0] || 'there') }) %>
    <% if (welcome) { %>
      <section class="dash-card dash-wide welcome-card">
        <h2>Welcome! Your account is ready</h2>
        <p class="small">You can always sign in with a link we email you. Prefer a password? Set one now, and you can use either.</p>
        <p><a class="btn btn-primary btn-sm" href="/account/settings#password">Set a password</a> <a class="btn btn-outline btn-sm" href="/account/profile">Complete your profile</a></p>
      </section>
    <% } %>
    <%- include('partials/getting-started') %>
    <%- include('partials/profile-meter') %>

    <% if (contracts.length) { %>
      <section class="dash-card dash-wide app-list">
        <div class="dash-head"><h2>Your contracts</h2><span class="muted small">Log your days every week</span></div>
        <% contracts.forEach(function (c) { %>
          <article class="my-app">
            <div class="my-app-head">
              <div>
                <h3><%= c.jobTitle %> at <%= c.company %></h3>
                <p class="muted small"><%= c.contractEnd ? 'Contract to ' + formatDate(c.contractEnd) : 'Ongoing contract' %></p>
              </div>
              <a class="btn btn-primary btn-sm" href="/account/timesheets/<%= c.id %>">Timesheets</a>
            </div>
            <p class="small">
              <% if (c.rejected) { %><span class="pill st-rejected"><%= c.rejected %> sent back</span> <% } %>
              <% if (c.missing) { %><span class="pill st-screening"><%= c.missing %> week<%= c.missing === 1 ? '' : 's' %> not logged</span> <% } %>
              <% if (c.submitted) { %><span class="pill st-interview"><%= c.submitted %> waiting for approval</span><% } %>
              <% if (!c.rejected && !c.missing && !c.submitted) { %><span class="muted">All caught up.</span><% } %>
            </p>
          </article>
        <% }) %>
      </section>
    <% } %>

    <section class="dash-card dash-wide" id="jobs-for-you">
      <div class="dash-head"><h2>Jobs for you</h2><a class="small" href="/account/recommendations">All recommendations</a></div>
      <% const myState = candidate && candidate.profile ? stateJobsLink(candidate.profile.city) : null; %>
      <% if (myState && myState.count) { %><p class="small state-jobs-link"><a href="<%= myState.href %>">See all <%= myState.count %> open <%= myState.count === 1 ? 'job' : 'jobs' %> in <%= myState.name %></a>, your state, including cities you could move to.</p><% } %>
      <% if (!matches.length) { %>
        <p class="muted dash-empty">No matches yet. Add your key skills and the places you'd work to <a href="/account/profile">your profile</a> and we'll show open jobs that fit.</p>
      <% } else { %>
        <ul class="match-list">
          <% matches.forEach(function (m) { %>
            <li>
              <div>
                <a href="<%= jobPath(m.job) %>"><b><%= m.job.title %></b></a>
                <span class="muted small"><%= m.job.company %> · <%= m.job.location %> · <%= m.job.type %><%= m.job.salary ? ' · ' + m.job.salary : '' %></span>
                <span class="small"><% if (m.match.score !== null) { %><b><%= m.match.label %></b> (<%= m.match.score %>%)<% } %><%= m.match.skills.matched.length ? (m.match.score !== null ? ' · ' : '') + 'Your skills: ' + m.match.skills.matched.join(', ') : '' %><%= m.reasons.length ? ' · ' + m.reasons[0] : '' %></span>
              </div>
              <a class="btn btn-outline btn-sm" href="<%= jobPath(m.job) %>#apply">View &amp; apply</a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <% if (openOffers.length) { %>
    <section class="dash-card dash-wide offer-card" id="offers" aria-labelledby="offers-title">
      <div class="dash-head"><h2 id="offers-title"><svg class="i" aria-hidden="true"><use href="#i-check"/></svg> You have <%= openOffers.length === 1 ? 'a job offer' : openOffers.length + ' job offers' %></h2></div>
      <% openOffers.forEach(function (a) { var o = a.offer; %>
        <article class="offer-item">
          <h3><%= o.title %><% if (o.company) { %> <span class="muted">at <%= o.company %></span><% } %></h3>
          <dl class="offer-facts">
            <% if (o.salary) { %><div><dt>Pay</dt><dd>₹<%= o.salary.amount.toLocaleString('en-IN') %> a <%= o.salary.period %></dd></div><% } %>
            <div><dt>Joining date</dt><dd><%= o.joiningDate ? formatDate(o.joiningDate) : 'To be agreed' %></dd></div>
            <% if (o.respondBy) { %><div><dt>Reply by</dt><dd><%= formatDate(o.respondBy) %></dd></div><% } %>
          </dl>
          <p class="small muted">Read the offer letter and ask the company anything first. A genuine employer never asks you to pay for an offer, joining, training or a uniform.</p>
          <div class="offer-actions">
            <form method="post" action="/account/offers/<%= a.id %>/<%= o.id %>/accept" data-confirm="Accept the offer for <%= o.title %>? The company will be told straight away.">
              <button class="btn btn-primary" type="submit">Accept offer</button>
            </form>
            <details class="offer-decline">
              <summary class="btn btn-outline">Decline</summary>
              <form method="post" action="/account/offers/<%= a.id %>/<%= o.id %>/decline" class="form">
                <label>Reason (optional, shared with the company)<textarea name="note" rows="2" maxlength="500" placeholder="For example: I accepted another offer"></textarea></label>
                <button class="btn btn-outline btn-sm" type="submit">Decline the offer</button>
              </form>
            </details>
          </div>
        </article>
      <% }) %>
    </section>
    <% } %>

    <section class="dash-card dash-wide app-list" id="applications">
      <div class="dash-head"><h2>Your applications</h2><a class="small" href="/jobs">Find more jobs</a></div>
      <% if (!apps.length) { %><p class="muted dash-empty">You haven&#39;t applied for a job yet. Applying is free and takes a minute.</p><p><a class="btn btn-primary btn-sm" href="/jobs">Find jobs</a></p><% } %>
      <% apps.forEach(function (a) { %>
        <article class="my-app">
          <div class="my-app-head">
            <div>
              <h3><% if (a.job) { %><a href="<%= jobPath(a.job) %>"><%= a.jobTitle %></a><% } else { %><%= a.jobTitle %><% } %></h3>
              <p class="muted small">Applied <%= formatDate(a.createdAt) %><% if (!a.withdrawn) { %> · <% if (a.hasMessages) { %><a class="pill<%= a.unreadMessages ? ' pill-unseen' : '' %>" href="/account/messages/<%= a.id %>"><%= a.unreadMessages ? a.unreadMessages + ' new message' + (a.unreadMessages === 1 ? '' : 's') : 'Messages' %></a> · <% } %><% if (a.viewedAt) { %><span class="app-seen"><svg class="i" aria-hidden="true"><use href="#i-check"/></svg> Seen by the hiring team <%= formatDate(a.viewedAt) %></span><% } else { %>Not seen by the hiring team yet<% } %><% } %><% if (a.hasResume) { %> · <a href="<%= signedLink('/account/resume/' + a.id) %>">Your resume</a><% } %></p>
            </div>
            <span class="pill <%= a.withdrawn || a.stage === 'Not selected' ? 'st-rejected' : a.stage === 'Hired' || a.stage === 'Offer' ? 'st-hired' : 'st-interview' %>"><%= a.stage %></span>
          </div>
          <% if (!a.withdrawn && a.stage !== 'Not selected') { %>
            <ol class="steps" aria-label="Progress">
              <% steps.forEach(function (s, i) { %><li class="<%= i < a.stepIndex ? 'done' : i === a.stepIndex ? 'current' : '' %>"<%- i === a.stepIndex ? ' aria-current="step"' : '' %>><span><%= s %></span></li><% }) %>
            </ol>
          <% } else if (a.stage === 'Not selected') { %>
            <p class="small muted">The team went ahead with other candidates for this role. Your profile stays in our talent pool for future matches.</p>
          <% } %>
          <% if (a.offer && a.offer.status !== 'awaiting') { %>
            <p class="my-offer small <%= a.offer.status === 'accepted' ? 'is-accepted' : 'is-declined' %>"><b>Offer <%= a.offer.status %></b><% if (a.offer.answeredAt) { %> on <%= formatDate(a.offer.answeredAt) %><% } %><% if (a.offer.status === 'accepted') { %> · Joining <%= a.offer.joiningDate ? formatDate(a.offer.joiningDate) : 'date to be agreed' %><% } %></p>
          <% } else if (a.offer) { %>
            <p class="my-offer small"><a href="#offers"><b>Job offer waiting for your answer</b></a></p>
          <% } %>
          <% a.interviews.forEach(function (iv) { %>
            <div class="my-iv">
              <b>Interview: <%= formatIst(iv.at) %></b> · <%= iv.duration %> min · <%= iv.mode %>
              <% if (/^https:\/\//.test(iv.where)) { %> · <a href="<%= iv.where %>" target="_blank" rel="noopener noreferrer">Join link</a><% } else if (iv.where) { %> · <%= iv.where %><% } %>
              · <a href="/account/interviews/<%= a.id %>/<%= iv.id %>.ics">Add to calendar</a>
            </div>
          <% }) %>
          <% if (!a.withdrawn && !a.closedOut) { %>
            <form method="post" action="/account/applications/<%= a.id %>/withdraw" data-confirm="Withdraw your application for <%= a.jobTitle %>? This can't be undone."><button class="link-btn small withdraw">Withdraw application</button></form>
          <% } %>
        </article>
      <% }) %>
    </section>

    <section class="dash-card dash-wide" id="referrals">
      <div class="dash-head"><h2>Friends you referred</h2><a class="small" href="/jobs">Find a job to share</a></div>
      <% if (referrals.length) { %>
        <p class="muted small"><%= referrals.length %> <%= referrals.length === 1 ? 'friend has' : 'friends have' %> applied through your links.</p>
        <ul class="activity">
          <% referrals.slice(0, 10).forEach(function (r) { %><li><span class="activity-row"><span class="activity-text"><b><%= r.first %></b> applied for <%= r.jobTitle %></span><span class="muted small"><%= formatDate(r.at) %></span></span></li><% }) %>
        </ul>
      <% } else { %>
        <p class="muted small">Know someone looking for work? Open any job and tap "Refer a friend on WhatsApp". When a friend applies through your link, it shows here.</p>
      <% } %>
    </section>

    <div class="dash-grid">
      <section class="dash-card" id="profile">
        <div class="dash-head"><h2>Your profile</h2><a class="small" href="/account/profile">Edit</a></div>
        <dl class="profile-summary small">
          <div><dt>Name</dt><dd><%= profile.name || 'Not added' %></dd></div>
          <div><dt>Mobile</dt><dd><%= profile.phone || 'Not added' %></dd></div>
          <div><dt>City</dt><dd><%= profile.location || 'Not added' %></dd></div>
          <div><dt>Skills</dt><dd><%= profile.skills || 'Not added' %></dd></div>
        </dl>
        <h3 class="dash-sub">Resume</h3>
        <% if (profile.resume) { %>
          <p class="small">On file since <%= formatDate(profile.resume.at) %> · <a href="<%= signedLink(profile.resume.href) %>">Download</a> · <a href="/account/profile#resume">Manage resumes</a></p>
        <% } else { %>
          <p class="small muted">No resume yet. Office jobs need one for one-click applying.</p>
          <form class="form inline-upload" method="post" action="/account/resume" enctype="multipart/form-data">
            <label class="file-field">Upload resume <span class="muted small">(PDF, DOC or DOCX, max 5 MB)</span><input type="file" name="resume" accept=".pdf,.doc,.docx" required></label>
            <button class="btn btn-outline btn-sm" type="submit">Upload</button>
          </form>
        <% } %>
      </section>

      <section class="dash-card" id="alerts">
        <div class="dash-head"><h2>Job alerts</h2><a class="small" href="/account/saved-searches">Saved searches</a></div>
        <p class="muted small">We email you about new jobs that match. Save any search on Find Jobs to get alerts for it, daily, weekly or as soon as jobs are posted.</p>
        <% if (alerts.length) { %>
          <ul class="alert-list">
            <% alerts.forEach(function (s) { %>
              <li>
                <span><% if (s.filters) { %><b><%= s.name %></b><% if (s.alertEnabled === false) { %> <span class="pill st-rejected">Emails off</span><% } %><% } else { %><b><%= s.category || 'All jobs' %></b> · <%= s.location || 'Any city' %><% } %><% if (!s.confirmed) { %> <span class="pill st-screening">Not confirmed</span><% } %></span>
                <form method="post" action="/account/alerts/<%= s.id %>/delete"><button class="link-btn small" type="submit" aria-label="Remove job alert <%= s.filters ? s.name : 'for ' + (s.category || 'all jobs') + ' in ' + (s.location || 'any city') %>">Remove</button></form>
              </li>
            <% }) %>
          </ul>
        <% } %>
        <form class="form" method="post" action="/account/alerts">
          <div class="form-grid">
            <label>Category<select name="category"><option value="">All categories</option><% categories.forEach(function (c) { %><option><%= c %></option><% }) %></select></label>
            <label>City<select name="location"><option value="">Any city</option><% locations.forEach(function (l) { %><option><%= l %></option><% }) %></select></label>
          </div>
          <button class="btn btn-outline btn-sm" type="submit">Add job alert</button>
        </form>
        <p class="small muted">You have <%= savedCount %> saved <%= savedCount === 1 ? 'job' : 'jobs' %>: <a href="/account/saved">see them</a>.</p>
      </section>

    </div>
  </div>
</section>

<%- include('partials/foot') %>
