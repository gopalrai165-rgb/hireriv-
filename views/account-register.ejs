<% locals.translated = true; %>
<%- include('partials/head') %>

<section class="section auth-section">
  <div class="container auth-wrap register-wrap">
    <% if (done) { %>
      <div class="form-card auth-card">
        <span class="eyebrow"><%= t('account.eyebrow') %></span>
        <h1><%= t('account.checkEmail') %></h1>
        <p class="notice" role="status"><%= t('account.registerSent') %></p>
        <p class="muted small"><%= t('account.noLink') %> <a href="/account/login"><%= t('account.newLink') %></a>.</p>
        <a class="btn btn-outline btn-block" href="/jobs"><%= t('account.browseMeanwhile') %></a>
      </div>
    <% } else { %>
      <div class="register-intro">
        <span class="eyebrow"><%= t('account.eyebrow') %></span>
        <h1><%= t('account.registerTitle') %></h1>
        <p class="lead-sm"><%= t('account.registerLead') %></p>
        <ul class="checks">
          <li><%= t('account.point1') %></li>
          <li><%= t('account.point2') %></li>
          <li><%= t('account.point3') %></li>
          <li><%= t('account.point4') %></li>
          <li><%= t('account.point5') %></li>
          <li><%= t('account.point6') %></li>
        </ul>
        <p class="small muted"><%= t('account.haveAccount') %> <a href="/account/login<%= next ? '?next=' + encodeURIComponent(next) : '' %>"><%= t('account.signIn') %></a></p>
      </div>
      <div class="form-card auth-card">
        <% if (errors.length) { %><div class="notice notice-err" role="alert" tabindex="-1" data-error-summary><% errors.forEach(function (e) { %><p><%= tm(e) %></p><% }) %></div><% } %>
        <form class="form" method="post" action="/account/register" enctype="multipart/form-data">
          <%- include('partials/honeypot') %>
          <% if (next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
          <p class="small muted"><%= t('common.requiredNote') %></p>
          <div class="form-grid">
            <label class="span-2"><%= t('account.fullName') %>*<input name="name" required maxlength="120" autocomplete="name" value="<%= values.name || '' %>"></label>
            <label><%= t('account.email') %>*<input type="email" name="email" required maxlength="160" autocomplete="email" value="<%= values.email || '' %>"></label>
            <label><%= t('account.mobile') %>*<input type="tel" name="phone" required maxlength="20" autocomplete="tel" inputmode="tel" placeholder="98xxxxxxxx" value="<%= values.phone || '' %>"></label>
            <label><%= t('account.city') %><input name="location" maxlength="120" autocomplete="address-level2" value="<%= values.location || '' %>"></label>
            <label class="file-field"><%= t('account.resume') %> <span class="muted small"><%= t('account.resumeOptional') %></span><input type="file" name="resume" accept=".pdf,.doc,.docx"></label>
          </div>
          <details class="more-fields"<%= values.experience || values.noticePeriod || values.skills || values.linkedin ? ' open' : '' %>>
            <summary><%= t('account.addMore') %> <span class="muted small"><%= t('account.addMoreNote') %></span></summary>
            <div class="form-grid">
            <label><%= t('account.experience') %>
              <select name="experience"><option value=""><%= t('account.select') %></option><% experienceOptions.forEach(function (o) { %><option value="<%= o %>"<%= o === values.experience ? ' selected' : '' %>><%= tv('experience', o) %></option><% }) %></select>
            </label>
            <label><%= t('account.notice') %>
              <select name="noticePeriod"><option value=""><%= t('account.select') %></option><% noticeOptions.forEach(function (o) { %><option value="<%= o %>"<%= o === values.noticePeriod ? ' selected' : '' %>><%= tv('notice', o) %></option><% }) %></select>
            </label>
            <label class="span-2"><%= t('account.skills') %> <span class="muted small"><%= t('account.skillsNote') %></span><input name="skills" maxlength="500" placeholder="<%= t('account.skillsPlaceholder') %>" value="<%= values.skills || '' %>"></label>
            <label class="span-2"><%= t('account.linkedin') %> <span class="muted small"><%= t('common.optional') %></span><input type="url" name="linkedin" maxlength="300" placeholder="https://" value="<%= values.linkedin || '' %>"></label>
            </div>
          </details>
          <div class="form-grid">
            <p class="span-2 muted small"><%= t('account.useNote') %></p>
            <label class="span-2 check-row"><input type="checkbox" name="agree" value="1" required> <span><%- th('account.agree', { terms: html('<a href="/terms">' + esc(t('footer.terms')) + '</a>'), privacy: html('<a href="/privacy">' + esc(t('footer.privacy')) + '</a>') }) %></span></label>
            <label class="span-2 check-row"><input type="checkbox" name="considered" value="1"<%= values.considered === '1' ? ' checked' : '' %>> <span><%= t('account.considered', { site: site.name }) %> <span class="muted small"><%= t('common.optional') %></span></span></label>
            <label class="span-2 check-row"><input type="checkbox" name="whatsapp" value="1"> <span><%= t('account.whatsapp') %> <span class="muted small"><%= t('account.whatsappNote') %></span></span></label>
          </div>
          <button class="btn btn-primary btn-block" type="submit"><%= t('account.create') %></button>
          <p class="muted small form-note"><%= t('account.createNote') %></p>
        </form>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
