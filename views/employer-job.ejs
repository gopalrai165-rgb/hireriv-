<%- include('partials/head') %>

<section class="section admin portal">
  <div class="container">
    <%- include('partials/employer-nav', { heading: job.id ? 'Edit job' : 'Post a job', tab: 'jobs', errors: [] }) %>
    <% if (job.id) { %><p class="muted">Status: <b><%= { draft: 'Draft', pending: 'Waiting for review', open: 'Live', paused: 'Paused', closed: 'Closed', rejected: 'Needs changes' }[job.status] || job.status %></b> · <a href="/employer/jobs">Back to jobs</a></p><% } %>
    <% if (needsMobile) { %><p class="notice" role="status">Verify your mobile number in <a href="/employer/settings">Settings</a> before sending this job for review. You can save a draft now.</p><% } %>
    <% if (!approved) { %><p class="notice" role="status">Our team is still checking your company. Save drafts and send jobs for review now; they go live once your company is verified.</p><% } %>
    <% if (job.status === 'rejected' && job.rejectedReason) { %><p class="notice notice-err">What to change: <%= job.rejectedReason %></p><% } %>
    <% if (['open', 'paused'].includes(job.status)) { %><p class="notice">This job is <%= job.status === 'open' ? 'live' : 'paused' %>. Saving changes sends it for a quick check, and it's hidden until they're approved.</p><% } %>
    <% if (errors.length) { %><div class="notice notice-err" role="alert"><% errors.forEach(function (e) { %><p><%= e %></p><% }) %></div><% } %>

    <% if (can('jobs.create')) { %>
      <details class="form-card ai-panel" data-ai-draft>
        <summary><b>Draft the description with AI</b> <span class="muted small">(optional)</span></summary>
        <p class="small muted">Fill in the title and the basics below first. The draft uses only what you give: it never adds pay or benefits you didn't type. Nothing changes until you choose "Use this draft", and you can edit everything before saving. Hireriv still reviews the job.</p>
        <label>Anything else to include <span class="muted small">(the team, the place, a typical day; no personal details)</span><textarea name="aiNotes" rows="3" maxlength="1500"></textarea></label>
        <div class="row-actions"><button class="btn btn-outline btn-sm" type="button" data-ai-draft-go>Write a draft</button></div>
        <p class="small muted" data-ai-status role="status" aria-live="polite"></p>
        <div data-ai-result hidden></div>
      </details>
    <% } %>
    <form class="form form-card" method="post" action="<%= job.id ? '/employer/jobs/' + job.id : '/employer/jobs' %>">
      <div class="form-grid">
        <label class="span-2">Job title*<input name="title" required maxlength="120" value="<%= job.title || '' %>" placeholder="e.g. Warehouse Supervisor"></label>
        <label>Category*
          <select name="category" required>
            <option value="">Choose…</option>
            <% categoryGroups.forEach(function (g) { %><optgroup label="<%= g.label %>"><% g.categories.forEach(function (c) { %><option<%= job.category === c ? ' selected' : '' %>><%= c %></option><% }) %></optgroup><% }) %>
          </select>
        </label>
        <label>Kind of work
          <select name="work">
            <option value="">From the category</option>
            <% workKinds.forEach(function (w) { %><option value="<%= w.key %>"<%= job.work === w.key ? ' selected' : '' %>><%= w.label %></option><% }) %>
          </select>
        </label>
        <label>Number of openings<input name="openings" inputmode="numeric" maxlength="4" value="<%= job.openings || '' %>" placeholder="e.g. 3"></label>
        <label>City*
          <select name="location" required>
            <option value="">Choose…</option>
            <% jobLocations.forEach(function (l) { %><option<%= job.location === l ? ' selected' : '' %>><%= l %></option><% }) %>
          </select>
        </label>
        <label>Work arrangement<select name="mode"><% modes.forEach(function (m) { %><option<%= job.mode === m ? ' selected' : '' %>><%= m %></option><% }) %></select></label>
        <label>Employment type<select name="type"><% jobTypes.forEach(function (t) { %><option<%= job.type === t ? ' selected' : '' %>><%= t %></option><% }) %></select></label>
        <label>Experience<input name="experience" maxlength="60" value="<%= job.experience || '' %>" placeholder="e.g. 1-3 years, or Freshers welcome"></label>
        <label>Education <span class="muted small">(optional)</span><input name="education" maxlength="200" value="<%= job.education || '' %>" placeholder="e.g. 12th pass, ITI, B.Com"></label>
        <% const pf = job.payForm || (job.pay ? { salaryMin: job.pay.min || '', salaryMax: job.pay.max || '', salaryPeriod: job.pay.period } : {}); %>
        <fieldset class="span-2 pay-fields">
          <legend>Pay in rupees <span class="muted small">(leave blank and the job shows "Not disclosed")</span></legend>
          <label>From ₹<input name="salaryMin" inputmode="numeric" value="<%= pf.salaryMin || '' %>"></label>
          <label>Up to ₹<input name="salaryMax" inputmode="numeric" value="<%= pf.salaryMax || '' %>"></label>
          <label>Per<select name="salaryPeriod"><% [['month', 'Month'], ['year', 'Year (CTC)'], ['day', 'Day'], ['hour', 'Hour']].forEach(function (o) { %><option value="<%= o[0] %>"<%= (pf.salaryPeriod || 'month') === o[0] ? ' selected' : '' %>><%= o[1] %></option><% }) %></select></label>
          <label>Note<input name="payNote" maxlength="120" value="<%= job.payNote || '' %>" placeholder="e.g. + PF & ESI"></label>
        </fieldset>
        <label class="span-2">Workplace address <span class="muted small">(optional for remote jobs; shown on the listing)</span><input name="address" maxlength="300" value="<%= job.address || '' %>" placeholder="e.g. Plot 12, MIDC Industrial Area, Bhosari, Pune 411026"></label>
        <%- include('partials/job-needs-fields', { job: job }) %>
        <label>Shift
          <select name="shift"><option value="">Not specified</option><% shifts.forEach(function (sh) { %><option<%= job.shift === sh ? ' selected' : '' %>><%= sh %></option><% }) %></select>
        </label>
        <label>Working hours <span class="muted small">(optional)</span><input name="hours" maxlength="120" value="<%= job.hours || '' %>" placeholder="e.g. 9 am – 6 pm, 48 hours a week"></label>
        <label>Work days <span class="muted small">(optional)</span><input name="schedule" maxlength="200" value="<%= job.schedule || '' %>" placeholder="e.g. Mon–Sat, Sunday off"></label>
        <label class="span-2">Overtime <span class="muted small">(optional; when it happens and how it is paid, e.g. "Up to 2 hours a day, paid at double the hourly rate")</span><input name="overtime" maxlength="200" value="<%= job.overtime || '' %>"></label>
        <label class="span-2">Costs the worker pays <span class="muted small">(optional; e.g. "None", "Uniform deposit ₹500, returned when you leave", "Room ₹1,500 a month if you use the hostel")</span><input name="workerCosts" maxlength="300" value="<%= job.workerCosts || '' %>"></label>
        <label>Last day to apply <span class="muted small">(optional)</span><input type="date" name="closesOn" value="<%= job.closesOn || '' %>"></label>
        <label class="span-2">About the role*<textarea name="description" rows="3" required maxlength="2000"><%= job.description || '' %></textarea></label>
        <p class="span-2 muted small">Before a job goes for review it needs its main responsibilities, the pay or how pay is decided, and for industrial, field and service work the working hours or shift. Candidates decide on these.</p>
        <label class="span-2">Responsibilities* <span class="muted small">(one per line)</span><textarea name="responsibilities" rows="4"><%= (job.responsibilities || []).join('\n') %></textarea></label>
        <label class="span-2">Requirements <span class="muted small">(one per line)</span><textarea name="qualifications" rows="3"><%= (job.qualifications || []).join('\n') %></textarea></label>
        <label class="span-2">Key skills <span class="muted small">(comma separated)</span><input name="skills" value="<%= (job.skills || []).join(', ') %>"></label>
        <label class="span-2">Who can apply <span class="muted small">(one per line, e.g. age limits set by law)</span><textarea name="eligibility" rows="2"><%= (job.eligibility || []).join('\n') %></textarea></label>
        <label class="span-2">Licences or certificates needed <span class="muted small">(one per line, optional, e.g. "Forklift licence", "Two-wheeler driving licence"; shown to candidates as must-haves, apart from the match score)</span><textarea name="mustHave" rows="2"><%= (job.mustHave || []).join('\n') %></textarea></label>
        <label class="span-2">Physical work <span class="muted small">(optional; only what the work really involves, e.g. "Lifting boxes up to 20 kg", "Standing for the whole shift")</span><input name="physical" maxlength="200" value="<%= job.physical || '' %>"></label>
        <label class="span-2 check-row"><input type="checkbox" name="immediate" value="1"<%= job.immediate ? ' checked' : '' %>> <span>Needs people who can start straight away</span></label>
        <input type="hidden" name="hrCallShown" value="1">
        <label class="span-2 check-row"><input type="checkbox" name="hrCall" value="1"<%= job.hrCall === true || job.hrCall === '1' ? ' checked' : '' %>> <span>Let people who applied call or WhatsApp us <span class="muted small">(the confirmed mobile of the person who created this job, shown only to people who applied to it while it is live; untick to stop at any time)</span></span></label>
        <label class="span-2">Benefits <span class="muted small">(one per line)</span><textarea name="benefits" rows="3"><%= (job.benefits || []).join('\n') %></textarea></label>
      </div>
      <p class="muted small">Listings must be real vacancies with honest pay, and may never ask candidates for money or for Aadhaar or bank details to apply. Read the <a href="/job-posting-policy" target="_blank" rel="noopener">job posting rules</a>. The <%= site.name %> team checks every job before it goes live.</p>
      <div class="row-actions">
        <% if (!job.id || ['draft', 'rejected', 'closed'].includes(job.status)) { %>
          <button class="btn btn-primary" type="submit" name="action" value="publish">Send for review</button>
          <button class="btn btn-outline" type="submit" name="action" value="save">Save draft</button>
        <% } else { %>
          <button class="btn btn-primary" type="submit" name="action" value="save"><%= ['open', 'paused'].includes(job.status) ? 'Save and send for review' : 'Save changes' %></button>
        <% } %>
      </div>
    </form>
  </div>
</section>
<script src="/js/ai.js?v=<%= assetVersion %>" defer></script>

<%- include('partials/foot') %>
