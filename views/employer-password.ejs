<%- include('partials/head') %>

<section class="section auth-section">
  <div class="container auth-wrap">
    <div class="form-card auth-card">
      <span class="eyebrow"><%= emp.company %></span>
      <h1><%= kind === 'invite' ? 'Set up your account' : 'Choose a new password' %></h1>
      <p class="muted">Signing in as <b><%= emp.email %></b>. Use at least 10 characters; a short phrase is easiest to remember.</p>
      <% if (errors.length) { %><p class="notice notice-err" role="alert"><%= errors.join(' ') %></p><% } %>
      <form class="form" method="post">
        <input type="text" name="username" value="<%= emp.email %>" autocomplete="username" hidden>
        <div class="form-grid">
          <label class="span-2">New password<input type="password" name="password" required minlength="10" autocomplete="new-password"></label>
          <label class="span-2">Confirm password<input type="password" name="confirm" required minlength="10" autocomplete="new-password"></label>
        </div>
        <button class="btn btn-primary btn-block" type="submit"><%= kind === 'invite' ? 'Create account' : 'Save new password' %></button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
