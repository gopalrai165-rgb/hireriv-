<%- include('partials/head') %>

<section class="section auth-section">
  <div class="container auth-wrap">
    <div class="form-card auth-card">
      <span class="eyebrow">Job-seeker account</span>
      <h1><%= typeof heading !== 'undefined' ? heading : 'Sign in' %></h1>
      <p class="muted"><%= typeof intro !== 'undefined' ? intro : 'Continue as' %> <b><%= email %></b>.</p>
      <form class="form" method="post"><button class="btn btn-primary btn-block" type="submit"><%= typeof button !== 'undefined' ? button : 'Continue to my account' %></button></form>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
