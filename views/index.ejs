<%- include('partials/head') %>
<%# Sections for employers are in English only for now: lang="en" tells screen readers. %>
<% const enOnly = locale !== 'en' ? ' lang="en"' : ''; %>

<!-- HERO: search by job and place, near me -->
<section class="hero hero-seek">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow"><svg class="i" aria-hidden="true"><use href="#i-spark"/></svg> <%= t('home.eyebrow') %></span>
      <h1><%= t('home.seekTitle1') %> <span class="grad"><%= t('home.seekTitle2') %></span></h1>
      <p class="lead"><%= t('home.seekLead') %></p>
      <form class="hero-search hero-search-seek" action="/jobs" method="get" role="search">
        <div class="hs-field">
          <svg class="i" aria-hidden="true"><use href="#i-search"/></svg>
          <label class="sr-only" for="hero-q"><%= t('home.searchLabel') %></label>
          <input id="hero-q" name="q" type="search" placeholder="<%= t('home.searchPlaceholder') %>" enterkeyhint="search" autocomplete="off" data-suggest>
        </div>
        <div class="hs-field">
          <svg class="i" aria-hidden="true"><use href="#i-pin"/></svg>
          <label class="sr-only" for="hero-loc"><%= t('jobs.location') %></label>
          <select id="hero-loc" name="location">
            <option value=""><%= t('home.anyLocation') %></option>
            <% locations.forEach(function (l) { %><option><%= l %></option><% }) %>
          </select>
        </div>
        <button class="btn btn-accent" type="submit"><%= t('home.searchButton') %></button>
      </form>
      <div class="hero-near">
        <button type="button" class="btn btn-outline btn-sm" data-near-me data-near-form=".hero-search-seek" hidden><svg class="i" aria-hidden="true"><use href="#i-locate"/></svg> <%= t('near.jobsNearMe') %></button>
        <a class="small" href="/jobs#f-near"><%= t('near.byPin') %></a>
        <span class="near-status small" role="status" data-near-status></span>
      </div>
      <p class="hero-popular small"><%= t('home.popular') %>
        <% popularRoles.slice(0, 6).forEach(function (r) { %><a href="<%= r.href %>"><%= t('roles.' + r.key) %></a> <% }) %>
      </p>
      <ul class="hero-points small">
        <li><svg class="i ok" aria-hidden="true"><use href="#i-check"/></svg> <%= t('home.pointFree') %></li>
        <li><svg class="i ok" aria-hidden="true"><use href="#i-check"/></svg> <%= t('home.pointChecked') %></li>
        <li><svg class="i ok" aria-hidden="true"><use href="#i-check"/></svg> <%= t('home.pointHr') %></li>
      </ul>
      <p class="hero-employer small"><%= t('home.hiring') %> <a href="/hire"><%= t('home.hireTalent') %></a> · <a href="/hire?service=contract-staffing#requirement"><%= t('home.requestStaffing') %></a> · <a href="/post-a-job"><%= t('nav.postJob') %></a></p>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <span class="deco deco-dots"></span>
      <span class="deco deco-ring"></span>
      <span class="deco deco-spark"></span>
      <figure class="photo-arch"><img src="/img/photos/hero-team.webp" alt="" width="900" height="1040" fetchpriority="high"></figure>
      <div class="float-card fc-main">
        <div class="fc-head"><span class="job-logo">W</span><div><b>Warehouse Associate</b><span class="muted small">Logistics company · Pune</span></div></div>
        <ul class="fc-facts small"><li><svg class="i"><use href="#i-wallet"/></svg>₹18,000 – 22,000 a month</li><li><svg class="i"><use href="#i-pin"/></svg>~4 km away</li><li><svg class="i"><use href="#i-clock"/></svg>Day shift</li></ul>
        <div class="fc-actions"><span class="btn btn-primary btn-sm">Applied</span><span class="btn btn-whatsapp btn-sm"><svg class="i"><use href="#i-phone"/></svg>Call HR</span></div>
      </div>
      <div class="float-card fc-small fc-a"><svg class="i ok"><use href="#i-check"/></svg><div><b>Verified employer</b><span class="muted small">Checked by our team</span></div></div>
      <div class="float-card fc-small fc-b"><svg class="i sun"><use href="#i-clock"/></svg><div><b>Apply in one tap</b><span class="muted small">With your saved profile</span></div></div>
    </div>
  </div>
</section>

<!-- POPULAR ROLES -->
<section class="section section-tight" aria-labelledby="roles-title">
  <div class="container">
    <div class="section-head row">
      <div>
        <h2 id="roles-title"><%= t('home.rolesTitle') %></h2>
        <p><%= t('home.rolesText') %></p>
      </div>
      <a href="/categories" class="btn btn-outline"><%= t('home.allCategories') %> <svg class="i" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    <ul class="role-grid">
      <% popularRoles.forEach(function (r) { %>
        <li><a class="role-tile" href="<%= r.href %>">
          <span class="role-icon" aria-hidden="true"><svg class="i"><use href="#<%= r.icon %>"/></svg></span>
          <b><%= t('roles.' + r.key) %></b>
          <span class="muted small"><%= r.count ? t('home.jobCount', { count: r.count }) : t('home.seeJobs') %></span>
        </a></li>
      <% }) %>
    </ul>
  </div>
</section>

<!-- TOP CITIES -->
<section class="section section-tint section-tight" aria-labelledby="cities-title">
  <div class="container">
    <div class="section-head">
      <h2 id="cities-title"><%= t('home.citiesTitle') %></h2>
      <p><%= t('home.citiesText') %></p>
    </div>
    <ul class="city-grid">
      <% topCities.forEach(function (c) { %>
        <li><a class="city-tile" href="/jobs?location=<%= encodeURIComponent(c.name) %>">
          <span class="city-initial" aria-hidden="true"><%= c.name.charAt(0) %></span>
          <span><b><%= t('home.jobsIn', { city: c.name }) %></b><span class="muted small"><%= t('home.jobCount', { count: c.count }) %></span></span>
        </a></li>
      <% }) %>
    </ul>
  </div>
</section>

<!-- HOW IT WORKS (job seekers) -->
<section class="section section-tight" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head center">
      <h2 id="how-title"><%= t('home.howTitle') %></h2>
    </div>
    <ol class="how-steps">
      <li><span class="how-num" aria-hidden="true">1</span><svg class="i" aria-hidden="true"><use href="#i-locate"/></svg><b><%= t('home.how1Title') %></b><span class="small muted"><%= t('home.how1Text') %></span></li>
      <li><span class="how-num" aria-hidden="true">2</span><svg class="i" aria-hidden="true"><use href="#i-check"/></svg><b><%= t('home.how2Title') %></b><span class="small muted"><%= t('home.how2Text') %></span></li>
      <li><span class="how-num" aria-hidden="true">3</span><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg><b><%= t('home.how3Title') %></b><span class="small muted"><%= t('home.how3Text') %></span></li>
    </ol>
    <p class="center how-cta"><a class="btn btn-primary btn-lg" href="/account/register"><%= t('home.createProfile') %></a> <a class="btn btn-outline btn-lg" href="/account/login?with=phone"><%= t('home.signInMobile') %></a></p>
  </div>
</section>

<!-- STATS -->
<section class="stats"<%- enOnly %>>
  <div class="container stats-grid">
    <% site.stats.forEach(function (s) { %>
      <div class="stat">
        <b><span class="counter" data-target="<%= s.value %>"><%= s.value.toLocaleString('en-IN') %></span><%= s.suffix %></b>
        <span><%= s.label %></span>
      </div>
    <% }) %>
  </div>
</section>

<!-- JOB CATEGORIES -->
<section class="section" id="categories">
  <div class="container">
    <div class="section-head row">
      <div>
        <span class="eyebrow"><%= t('home.catEyebrow') %></span>
        <h2><%= t('home.catTitle') %></h2>
        <p><%= t('home.catText') %></p>
      </div>
      <a href="/categories" class="btn btn-outline"><%= t('home.allCategories') %> <svg class="i" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="cat-grid">
      <% groups.forEach(function (g) { %>
        <a class="cat-tile<%= ['office', 'skilled-field'].includes(g.key) ? ' cat-tile-wide' : '' %>" href="/jobs?group=<%= g.key %>">
          <span class="cat-icon" aria-hidden="true"><svg class="i"><use href="#<%= g.icon %>"/></svg></span>
          <span class="cat-body"><b><%= tv('group', g.key) === g.key ? g.label : tv('group', g.key) %></b><% if (g.text) { %><span class="muted small"><%= tv('groupText', g.key) === g.key ? g.text : tv('groupText', g.key) %></span><% } %></span>
          <span class="cat-count"><%= t('home.jobCount', { count: g.count }) %></span>
        </a>
      <% }) %>
    </div>
    <%- include('partials/job-landing-links') %>
  </div>
</section>

<!-- FEATURED JOBS -->
<section class="section section-tint">
  <div class="container">
    <div class="section-head row">
      <div>
        <span class="eyebrow"><%= t('home.featuredEyebrow') %></span>
        <h2><%= t('home.featuredTitle') %></h2>
      </div>
      <a href="/jobs" class="btn btn-outline"><%= t('home.viewAll') %> <svg class="i" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="jobs-grid">
      <% jobs.forEach(function (job) { %><%- include('partials/job-card', { job: job }) %><% }) %>
    </div>
  </div>
</section>

<!-- EMPLOYERS -->
<section class="section section-dark employer-band" id="employers"<%- enOnly %>>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">For employers</span>
      <h2>Hiring? We'll find the right people</h2>
      <p>From one manager to a hundred shop-floor staff: tell us who you need and a dedicated recruiter sends a screened shortlist.</p>
    </div>
    <div class="employer-grid">
      <% [
        ['/post-a-job', 'i-plus', 'Post a Job', 'Share the role and we start sourcing the same day.'],
        ['/hire#requirement', 'i-search', 'Find Candidates', 'Screened profiles from our talent pool, matched to your role.'],
        ['/services/bulk-rpo-hiring', 'i-users', 'Bulk Hiring', 'Ten to hundreds of hires for plants, warehouses, stores and BPOs.'],
        ['/services/permanent-staffing', 'i-briefcase', 'Permanent Recruitment', 'Full-time hires with a replacement guarantee.'],
        ['/services/contract-staffing', 'i-clock', 'Contract Staffing', 'Contract and temporary staff on our payroll, deployed fast.'],
      ].forEach(function (c) { %>
        <a class="employer-card" href="<%= c[0] %>">
          <span class="service-icon"><svg class="i"><use href="#<%= c[1] %>"/></svg></span>
          <h3><%= c[2] %></h3>
          <p><%= c[3] %></p>
        </a>
      <% }) %>
    </div>
    <p class="employer-more"><a href="/services" class="btn btn-primary">All staffing solutions <svg class="i"><use href="#i-arrow"/></svg></a> <a href="/employer/login">Already a client? Log in</a></p>
  </div>
</section>

<!-- INDUSTRIES -->
<section class="section" id="industries"<%- enOnly %>>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Specialised talent</span>
      <h2>Recruiters who know your industry</h2>
      <p>Specialist desks for twelve industries, plus HR, education, legal and admin roles.</p>
    </div>
    <div class="tabs" role="tablist">
      <% const industries = catalog.INDUSTRIES %>
      <% industries.forEach(function (ind, i) { %>
        <button role="tab" class="tab<%= i === 0 ? ' active' : '' %>" aria-selected="<%= i === 0 %>" aria-controls="panel-<%= ind.key %>" id="tab-<%= ind.key %>">
          <svg class="i"><use href="#<%= ind.icon %>"/></svg><%= ind.name %>
        </button>
      <% }) %>
    </div>
    <% industries.forEach(function (ind, i) { %>
      <div class="tab-panel<%= i === 0 ? ' active' : '' %>" role="tabpanel" id="panel-<%= ind.key %>" aria-labelledby="tab-<%= ind.key %>" <%= i === 0 ? '' : 'hidden' %>>
        <div>
          <h3><%= ind.name %></h3>
          <p><%= ind.text %></p>
          <div class="panel-links">
            <a href="/industries/<%= ind.slug %>" class="card-link">About this desk <svg class="i"><use href="#i-arrow"/></svg></a>
            <a href="/jobs?category=<%= encodeURIComponent(ind.name) %>" class="card-link">See open roles <svg class="i"><use href="#i-arrow"/></svg></a>
          </div>
        </div>
        <div>
          <p class="muted small upper">Trending roles</p>
          <div class="chips chips-lg"><% ind.roles.forEach(function (r) { %><span class="chip"><%= r %></span><% }) %></div>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<!-- PROCESS -->
<section class="section section-dark" id="process"<%- enOnly %>>
  <div class="container">
    <div class="section-head light">
      <span class="eyebrow">Our 6-stage filter</span>
      <h2>A shortlist you can trust, every time</h2>
      <p>Every profile passes through six checkpoints before it reaches you, so you spend time interviewing, not screening.</p>
    </div>
    <ol class="process">
      <% [
        ['Need analysis', 'We learn the role, the team and what success looks like in the first six months.'],
        ['Sourcing', 'Our database, referral network and targeted outreach surface the right people.'],
        ['Candidate evaluation', 'Skill assessments and structured screening calls check ability and fit.'],
        ['Interview presentation', 'You receive a curated shortlist with a recruiter note on every profile.'],
        ['Background checks', 'Employment, education and reference verification before any offer.'],
        ['Offer & closure', 'We manage negotiation, notice periods and follow up until day one.']
      ].forEach(function (p, i) { %>
        <li class="process-step reveal">
          <span class="step-num"><%= String(i + 1).padStart(2, '0') %></span>
          <h3><%= p[0] %></h3>
          <p><%= p[1] %></p>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<!-- TWO PATHS -->
<section class="section"<%- enOnly %>>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">How we help</span>
      <h2>One partner for both sides of the hire</h2>
      <p>Whether you're building a team or taking the next step in your career, we make the process faster, fairer and more human.</p>
    </div>
    <div class="paths">
      <div class="path-card path-employer reveal reveal-left">
        <figure class="path-photo"><img src="/img/photos/path-employer.webp" alt="" width="900" height="560" loading="lazy" decoding="async"></figure>
        <span class="path-icon"><svg class="i"><use href="#i-users"/></svg></span>
        <h3>For employers</h3>
        <p>Recruiter-assessed, AI-matched candidates delivered to your inbox, with a dedicated expert from brief to joining.</p>
        <ul class="checks">
          <li>Shortlists in as little as 72 hours</li>
          <li>Permanent, contract &amp; bulk hiring</li>
          <li>Background checks included</li>
          <li>Replacement guarantee on placements</li>
        </ul>
        <a href="/hire" class="btn btn-primary">Start hiring <svg class="i"><use href="#i-arrow"/></svg></a>
      </div>
      <div class="path-card path-candidate reveal reveal-right">
        <figure class="path-photo"><img src="/img/photos/path-candidate.webp" alt="" width="900" height="560" loading="lazy" decoding="async"></figure>
        <span class="path-icon"><svg class="i"><use href="#i-briefcase"/></svg></span>
        <h3>For job seekers</h3>
        <p>Personalised job recommendations, honest career advice and a recruiter who keeps you updated at every step.</p>
        <ul class="checks">
          <li>Remote, hybrid &amp; on-site roles</li>
          <li>Competitive salaries with top employers</li>
          <li>Interview preparation &amp; resume feedback</li>
          <li>Free for candidates, always</li>
        </ul>
        <a href="/jobs" class="btn btn-dark">Browse jobs <svg class="i"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </div>
</section>

<!-- WHY US -->
<section class="section"<%- enOnly %>>
  <div class="container why-grid">
    <div>
      <span class="eyebrow">Why Hireriv</span>
      <h2>Your extended HR department, without the overhead</h2>
      <p class="lead-sm">We take a consultative approach grounded in current market data, and we're accountable for results, not just CVs.</p>
      <div class="why-list">
        <div><svg class="i"><use href="#i-clock"/></svg><div><b>Faster time-to-hire</b><p>A ready talent pool and a proven process cut weeks from your hiring cycle.</p></div></div>
        <div><svg class="i"><use href="#i-wallet"/></svg><div><b>Lower hiring costs</b><p>Reduce admin, payroll and overtime costs by letting us run the process end to end.</p></div></div>
        <div><svg class="i"><use href="#i-phone"/></svg><div><b>A real person, always</b><p>A dedicated account manager who picks up the phone and keeps you updated, for clients and candidates alike.</p></div></div>
        <div><svg class="i"><use href="#i-shield"/></svg><div><b>Quality guaranteed</b><p>Free replacement if a placement doesn't work out within the guarantee period.</p></div></div>
      </div>
    </div>
    <div class="why-collage reveal reveal-right">
      <span class="deco deco-dots teal" aria-hidden="true"></span>
      <span class="deco deco-squiggle" aria-hidden="true"></span>
      <figure class="photo-arch photo-round"><img src="/img/photos/why-team.webp" alt="A recruiter and candidates working together at a laptop" width="800" height="960" loading="lazy" decoding="async"></figure>
      <figure class="why-small"><img src="/img/photos/why-hands.webp" alt="" width="500" height="500" loading="lazy" decoding="async"></figure>
      <figure class="quote-card">
        <svg class="i quote-mark"><use href="#i-quote"/></svg>
        <blockquote>Train people well enough so they can leave. Treat them well enough so they don't want to.</blockquote>
        <figcaption>Richard Branson</figcaption>
      </figure>
    </div>
  </div>
</section>


<!-- TESTIMONIALS (edited in Admin → Settings; hidden when there are none) -->
<% const testimonials = testimonialsFor(site); %>
<% if (testimonials.length) { %>
<section class="section section-testimonials"<%- enOnly %>>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Testimonials</span>
      <h2>What clients and candidates say</h2>
    </div>
    <div class="testimonials">
      <% testimonials.forEach(function (t) { %>
        <% const initials = t.name.split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0].toUpperCase(); }).join(''); %>
        <figure class="testimonial reveal">
          <div class="stars" role="img" aria-label="<%= t.rating %> out of 5"><%= '★'.repeat(t.rating) %><span class="stars-off"><%= '★'.repeat(5 - t.rating) %></span></div>
          <blockquote>“<%= t.quote %>”</blockquote>
          <figcaption><span class="avatar" aria-hidden="true"><%= initials %></span><div><b><%= t.name %></b><% if (t.detail) { %><span class="muted small"><%= t.detail %></span><% } %></div></figcaption>
        </figure>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- FAQ -->
<section class="section section-tint" id="faq"<%- enOnly %>>
  <div class="container faq-wrap">
    <div class="section-head left">
      <span class="eyebrow">FAQ</span>
      <h2>Questions, answered</h2>
      <p>Can't find what you're looking for? <a href="/contact">Talk to our team</a>.</p>
      <figure class="faq-photo"><img src="/img/photos/contact.webp" alt="" width="900" height="700" loading="lazy" decoding="async"></figure>
    </div>
    <div class="faq">
      <% [
        ['What makes Hireriv different from other staffing agencies?', 'We combine AI-assisted matching with a six-stage human screening process, specialist recruiters for each industry, and a dedicated account manager, so you get fewer, better profiles and a faster hire.'],
        ['Which industries do you specialise in?', 'Technology, Finance & Accounting, Banking & Insurance, Sales, Marketing & Creative, Healthcare & Pharma, Engineering & Manufacturing, Customer Support & BPO, Retail & E-commerce, Logistics & Operations, Construction & Facility Management, and Hospitality & Travel, plus HR, education, legal and admin roles.'],
        ['How quickly can you share candidates?', 'For most roles we share a first shortlist within 72 hours of the brief. Niche and leadership roles typically take one to two weeks.'],
        ['Do you only help with hiring, or offer end-to-end HR support?', 'Both. Beyond recruitment we offer contract staffing with payroll, background verification, onboarding and corporate training, so we can act as your extended HR team.'],
        ['What is the six-stage filter?', 'Need analysis, sourcing, candidate evaluation, interview presentation, background checks, and offer negotiation & closure. Every candidate passes all six before joining.'],
        ['Can you handle urgent or high-volume hiring?', 'Yes. Our bulk hiring and RPO teams run hiring drives for dozens to hundreds of roles, with clear SLAs and weekly reporting.'],
        ['Is it free for job seekers?', 'Always. Candidates never pay Hireriv for job placement, interview preparation or career advice.'],
        ['How do we get started?', 'Share your requirement on the Hire a Team page or call us. A client partner will set up a short brief call, agree on terms and start sourcing the same day.']
      ].forEach(function (f, i) { %>
        <details class="faq-item"<%= i === 0 ? ' open' : '' %>>
          <summary><%= f[0] %><svg class="i"><use href="#i-plus"/></svg></summary>
          <p><%= f[1] %></p>
        </details>
      <% }) %>
    </div>
  </div>
</section>

<!-- BLOG -->
<section class="section"<%- enOnly %>>
  <div class="container">
    <div class="section-head row">
      <div>
        <span class="eyebrow">News &amp; articles</span>
        <h2>From the Hireriv blog</h2>
      </div>
      <a href="/blog" class="btn btn-outline">All articles <svg class="i"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="posts-grid">
      <% posts.forEach(function (p) { %>
        <a class="post-card reveal" href="/blog/<%= p.slug %>">
          <div class="post-thumb thumb-<%= p.category.toLowerCase() %>"><span><%= p.category %></span></div>
          <div class="post-body">
            <span class="muted small"><%= formatDate(p.date) %></span>
            <h3><%= p.title %></h3>
            <p><%= p.excerpt %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-band"<%- enOnly %>>
  <div class="container cta-inner">
    <div>
      <h2>Ready to build your dream team?</h2>
      <p>Tell us what you need. We'll send the right people.</p>
    </div>
    <div class="cta-actions">
      <a href="/hire" class="btn btn-light btn-lg">Share a requirement</a>
      <a href="tel:<%= site.phone.replace(/\s/g, '') %>" class="btn btn-ghost-light btn-lg"><svg class="i"><use href="#i-phone"/></svg> Call us</a>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
