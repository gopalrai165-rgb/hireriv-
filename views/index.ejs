<%- include('partials/head') %>
<%# Sections for employers are in English only for now: lang="en" tells screen readers. %>
<% const enOnly = locale !== 'en' ? ' lang="en"' : ''; %>

<!-- HERO: who we are, job search, and a way in for employers -->
<section class="hero hero-seek">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1><%= t('home.brandTitle1') %> <span class="grad"><%= t('home.brandTitle2') %></span></h1>
      <p class="lead"><%= t('home.brandLead') %></p>
      <p class="hero-ctas"><a class="btn btn-primary" href="/jobs"><%= t('home.findJobs') %></a> <a class="btn btn-outline" href="/hire#requirement"><%= t('home.hireEmployees') %></a></p>
      <form class="hero-search hero-search-seek" action="/jobs" method="get" role="search" aria-label="<%= t('home.searchLabel') %>">
        <div class="hs-field">
          <svg class="i" aria-hidden="true"><use href="#i-search"/></svg>
          <label class="sr-only" for="hero-q"><%= t('home.searchLabel') %></label>
          <input id="hero-q" name="q" type="search" placeholder="<%= t('home.searchPlaceholder') %>" enterkeyhint="search" autocomplete="off" data-suggest>
        </div>
        <div class="hs-field">
          <svg class="i" aria-hidden="true"><use href="#i-pin"/></svg>
          <label class="sr-only" for="hero-loc"><%= t('jobs.location') %></label>
          <select id="hero-loc" name="location">
            <option value=""><%= t('home.anyLocation') %></option>
            <% locations.forEach(function (l) { %><option><%= l %></option><% }) %>
          </select>
        </div>
        <button class="btn btn-accent" type="submit"><%= t('home.searchButton') %></button>
      </form>
      <div class="hero-near">
        <button type="button" class="btn btn-outline btn-sm" data-near-me data-near-form=".hero-search-seek" hidden><svg class="i" aria-hidden="true"><use href="#i-locate"/></svg> <%= t('near.jobsNearMe') %></button>
        <a class="small" href="/jobs#f-near"><%= t('near.byPin') %></a>
        <span class="near-status small" role="status" data-near-status></span>
      </div>
      <ul class="hero-points small">
        <li><svg class="i ok" aria-hidden="true"><use href="#i-check"/></svg> <%= t('home.pointFree') %></li>
        <li><svg class="i ok" aria-hidden="true"><use href="#i-check"/></svg> <%= t('home.pointChecked') %></li>
      </ul>
    </div>
    <div class="hero-side">
      <div class="hero-visual" aria-hidden="true">
        <span class="deco deco-dots"></span>
        <span class="deco deco-ring"></span>
        <figure class="photo-arch"><img src="/img/photos/hero-team.webp" alt="" width="900" height="1040" fetchpriority="high"></figure>
      </div>
      <aside class="employer-ask"<%- enOnly %> aria-labelledby="employer-ask-h">
        <h2 id="employer-ask-h"><%= t('home.employerAsk') %></h2>
        <p><%= t('home.employerText') %></p>
        <a class="btn btn-accent btn-block" href="/hire#requirement"><%= t('home.employerButton') %></a>
        <p class="small"><a href="/post-a-job"><%= t('nav.postJob') %></a> · <a href="/services">Our services</a></p>
      </aside>
    </div>
  </div>
</section>

<!-- 1. LATEST VERIFIED JOBS (first, straight after the search) -->
<section class="section" id="latest-jobs">
  <div class="container">
    <div class="section-head row">
      <div>
        <span class="eyebrow"><%= t('home.featuredEyebrow') %></span>
        <h2><%= t('home.featuredTitle') %></h2>
      </div>
      <a href="/jobs" class="btn btn-outline"><%= t('home.viewAll') %> <svg class="i" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    <% if (jobs.length) { %>
    <div class="jobs-grid">
      <% jobs.forEach(function (job) { %><%- include('partials/job-card', { job: job }) %><% }) %>
      <% if (jobs.length < 3) { %>
      <%# A short row (one or two jobs) ends with a way to hear about the next ones, instead of empty space. %>
      <div class="job-card job-card-more">
        <span class="job-card-more-icon" aria-hidden="true"><svg class="i"><use href="#i-bell"/></svg></span>
        <p><b><%= t('home.noJobsTitle') %></b> <%= t('home.noJobsText') %></p>
        <p class="job-card-more-actions"><a class="btn btn-primary btn-sm" href="/jobs#alerts"><%= t('home.jobAlerts') %></a> <a class="btn btn-outline btn-sm" href="/account/register"><%= t('home.createProfile') %></a></p>
      </div>
      <% } %>
    </div>
    <% } else { %>
    <div class="empty">
      <p><b><%= t('home.noJobsTitle') %></b> <%= t('home.noJobsText') %></p>
      <p><a class="btn btn-primary" href="/account/register"><%= t('home.createProfile') %></a> <a class="btn btn-outline" href="/jobs#alerts"><%= t('home.jobAlerts') %></a></p>
    </div>
    <% } %>
  </div>
</section>

<!-- FIGURES: real ones from Settings, or what we offer -->
<%- include('partials/figures', { enOnly: enOnly }) %>

<!-- 2. JOB SEARCH: by role and by city -->
<section class="section section-tight" aria-labelledby="roles-title">
  <div class="container">
    <div class="section-head row">
      <div>
        <h2 id="roles-title"><%= t('home.searchTitle') %></h2>
        <p><%= t('home.searchText') %></p>
      </div>
      <a href="/jobs" class="btn btn-outline"><%= t('home.viewAll') %> <svg class="i" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    <ul class="role-grid role-grid-home">
      <% popularRoles.forEach(function (r) { %>
        <li><a class="role-tile" href="<%= r.href %>">
          <span class="role-icon" aria-hidden="true"><svg class="i"><use href="#<%= r.icon %>"/></svg></span>
          <span class="role-text">
            <b><%= t('roles.' + r.key) %></b>
            <span class="role-hint"><%= t('roleHints.' + r.key) %></span>
            <span class="role-count"><%= r.count ? t('home.jobCount', { count: r.count }) : t('home.seeJobs') %></span>
          </span>
          <svg class="i role-go" aria-hidden="true"><use href="#i-arrow"/></svg>
        </a></li>
      <% }) %>
    </ul>
  </div>
</section>

<section class="section section-tight section-flush" aria-labelledby="cities-title">
  <div class="container">
    <h3 id="cities-title" class="sub-head"><%= t('home.citiesTitle') %></h3>
    <ul class="city-grid">
      <% topCities.forEach(function (c) { %>
        <% const cityCount = c.count ? t('home.jobCount', { count: c.count }) : t('home.seeJobs'); %>
        <li><a class="city-tile" href="<%= c.href %>" aria-label="<%= t('home.jobsIn', { city: c.name }) %>, <%= cityCount %>">
          <span class="city-initial" aria-hidden="true"><svg class="i"><use href="#i-pin"/></svg></span>
          <span><b><%= c.name %></b><span class="muted small"><%= cityCount %></span></span>
          <svg class="i city-go" aria-hidden="true"><use href="#i-arrow"/></svg>
        </a></li>
      <% }) %>
    </ul>
  </div>
</section>

<!-- 3. POPULAR JOB CATEGORIES -->
<section class="section section-tint" id="categories">
  <div class="container">
    <div class="section-head row">
      <div>
        <span class="eyebrow"><%= t('home.catEyebrow') %></span>
        <h2><%= t('home.catTitle') %></h2>
        <p><%= t('home.catText') %></p>
      </div>
      <a href="/categories" class="btn btn-outline"><%= t('home.allCategories') %> <svg class="i" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="cat-grid">
      <% groups.forEach(function (g) { %>
        <a class="cat-tile<%= ['office', 'skilled-field'].includes(g.key) ? ' cat-tile-wide' : '' %>" href="/jobs?group=<%= g.key %>">
          <span class="cat-icon" aria-hidden="true"><svg class="i"><use href="#<%= g.icon %>"/></svg></span>
          <span class="cat-body"><b><%= tv('group', g.key) === g.key ? g.label : tv('group', g.key) %></b><% if (g.text) { %><span class="muted small"><%= tv('groupText', g.key) === g.key ? g.text : tv('groupText', g.key) %></span><% } %></span>
          <% if (g.count) { %><span class="cat-count"><%= t('home.jobCount', { count: g.count }) %></span><% } %>
        </a>
      <% }) %>
    </div>
    <%- include('partials/job-landing-links') %>
  </div>
</section>

<!-- 4. RECRUITMENT AND STAFFING SERVICES -->
<section class="section section-dark employer-band" id="employers"<%- enOnly %>>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">For employers</span>
      <h2>Recruitment and staffing services</h2>
      <p>Tell us who you need, from one developer to fifty warehouse staff, and a recruiter sends you screened candidates.</p>
    </div>
    <div class="employer-grid employer-grid-4">
      <% homeServices.forEach(function (c) { %>
        <a class="employer-card" href="<%= c.href %>">
          <figure class="employer-photo"><img src="/img/photos/<%= c.photo %>.webp" alt="" width="900" height="1000" loading="lazy" decoding="async"></figure>
          <span class="service-icon"><svg class="i"><use href="#<%= c.icon %>"/></svg></span>
          <h3><%= c.name %></h3>
          <p><%= c.text %></p>
        </a>
      <% }) %>
    </div>
    <p class="employer-more"><a href="/services" class="btn btn-primary">All staffing services <svg class="i"><use href="#i-arrow"/></svg></a> <a href="/employer/login">Already a client? Log in</a></p>
    <div class="employer-links">
    <p class="small employer-desks">Also: <% catalog.SERVICES.forEach(function (s, i) { %><a href="/services/<%= s.slug %>"><%= s.name %></a><%= i < catalog.SERVICES.length - 1 ? ' · ' : '' %><% }) %>.</p>
    <p class="small employer-desks">Specialist recruiters for: <% catalog.INDUSTRIES.forEach(function (ind, i) { %><a href="/industries/<%= ind.slug %>"><%= ind.name %></a><%= i < catalog.INDUSTRIES.length - 1 ? ' · ' : '' %><% }) %>.</p>
    </div>
  </div>
</section>

<!-- 5. WHY CHOOSE HIRERIV -->
<section class="section" aria-labelledby="why-title"<%- enOnly %>>
  <div class="container">
    <div class="section-head center">
      <h2 id="why-title">Why choose <%= site.name %></h2>
    </div>
    <ul class="why-grid">
      <% [
        ['i-check', 'Free for job seekers', 'No fee to register, apply or get a job. Ever.'],
        ['i-shield', 'Listings checked by our team', 'Every job is reviewed before it goes live, and you can report one that looks wrong.'],
        ['i-briefcase', 'IT and non-IT hiring', 'Developers and accountants to delivery, warehouse and support staff.'],
        ['i-users', 'One point of contact', 'Employers deal with one recruiter from the first call to the joining day.'],
        ['i-phone', 'Talk to a real person', 'Call or WhatsApp us, and call the HR of a job after you apply where they allow it.'],
        ['i-wallet', 'Clear terms for employers', 'You know the fee and the replacement terms before we start.'],
      ].forEach(function (w) { %>
        <li class="why-item"><span class="service-icon" aria-hidden="true"><svg class="i"><use href="#<%= w[0] %>"/></svg></span><div><b><%= w[1] %></b><span class="muted small"><%= w[2] %></span></div></li>
      <% }) %>
    </ul>
  </div>
</section>

<!-- 6. HOW HIRERIV WORKS -->
<section class="section section-tint" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head center">
      <h2 id="how-title">How <%= site.name %> works</h2>
    </div>
    <div class="how-cols">
      <div>
        <h3><%= t('home.howTitle') %></h3>
        <ol class="how-steps">
          <li><span class="how-num" aria-hidden="true">1</span><svg class="i" aria-hidden="true"><use href="#i-locate"/></svg><b><%= t('home.how1Title') %></b><span class="small muted"><%= t('home.how1Text') %></span></li>
          <li><span class="how-num" aria-hidden="true">2</span><svg class="i" aria-hidden="true"><use href="#i-check"/></svg><b><%= t('home.how2Title') %></b><span class="small muted"><%= t('home.how2Text') %></span></li>
          <li><span class="how-num" aria-hidden="true">3</span><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg><b><%= t('home.how3Title') %></b><span class="small muted"><%= t('home.how3Text') %></span></li>
        </ol>
      </div>
      <div<%- enOnly %>>
        <h3>Hire staff in three steps</h3>
        <ol class="how-steps">
          <li><span class="how-num" aria-hidden="true">1</span><svg class="i" aria-hidden="true"><use href="#i-mail"/></svg><b>Share your requirement</b><span class="small muted">Fill the short form or call us. A recruiter calls back to understand the role.</span></li>
          <li><span class="how-num" aria-hidden="true">2</span><svg class="i" aria-hidden="true"><use href="#i-users"/></svg><b>Get screened candidates</b><span class="small muted">We source, call and screen candidates, then send a shortlist with notes.</span></li>
          <li><span class="how-num" aria-hidden="true">3</span><svg class="i" aria-hidden="true"><use href="#i-briefcase"/></svg><b>Interview and hire</b><span class="small muted">We arrange interviews and follow up until your new hire joins.</span></li>
        </ol>
      </div>
    </div>
  </div>
</section>

<!-- 7. EMPLOYER ENQUIRY -->
<section class="section" id="enquiry" aria-labelledby="enquiry-title"<%- enOnly %>>
  <div class="container split enquiry-split">
    <div>
      <span class="eyebrow">Employer enquiry</span>
      <h2 id="enquiry-title">Need staff? Tell us in a minute</h2>
      <p>Share the basics and a recruiter will call you back within one working day. For a job description, budget and more details, use the <a href="/hire#requirement">full hiring form</a>.</p>
      <ol class="next-steps">
        <li><b>A recruiter calls you back</b><span>Within one working day, to understand the roles, pay and location.</span></li>
        <li><b>You get a quote</b><span>The fee and the replacement terms are agreed before any work starts. See the <a href="/service-terms">service terms</a>.</span></li>
        <li><b>You receive a shortlist</b><span>Screened candidates with notes, and we arrange the interviews.</span></li>
      </ol>
      <% if (realContact(site).whatsapp) { %><p><a class="btn btn-whatsapp" href="https://wa.me/<%= site.whatsapp %>?text=<%= encodeURIComponent('Hi ' + site.name + ', I would like to hire staff.') %>" rel="noopener"><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg> WhatsApp us</a></p><% } %>
    </div>
    <div class="form-card">
      <form class="form js-form" action="/api/hire" method="post">
        <input type="hidden" name="from" value="home">
        <input type="hidden" name="source" value="" data-source>
        <%- include('partials/honeypot') %>
        <div class="form-grid">
          <label>Company name*<input name="company" required autocomplete="organization"></label>
          <label>Your name*<input name="name" required autocomplete="name"></label>
          <label>Work email*<input type="email" name="email" required autocomplete="email"></label>
          <label>Phone*<input type="tel" name="phone" required autocomplete="tel"></label>
          <label class="span-2">Roles you're hiring for*<input name="roles" required placeholder="e.g. 5 delivery executives in Pune"></label>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Send enquiry</button>
        <p class="muted small form-note">We use these details only to respond to your enquiry. See our <a href="/privacy">Privacy Policy</a>.</p>
      </form>
    </div>
  </div>
</section>

<!-- 8. CANDIDATE REGISTRATION -->
<section class="cta-band" aria-labelledby="register-title">
  <div class="container cta-inner">
    <div>
      <h2 id="register-title"><%= t('home.registerTitle') %></h2>
      <p><%= t('home.registerText') %></p>
    </div>
    <div class="cta-actions">
      <a href="/account/register" class="btn btn-light btn-lg"><%= t('home.createProfile') %></a>
      <a href="/account/login?with=phone" class="btn btn-ghost-light btn-lg"><%= t('home.signInMobile') %></a>
    </div>
  </div>
</section>

<!-- 9. TESTIMONIALS: only real ones from Admin → Settings; hidden when there are none -->
<% const testimonials = testimonialsFor(site); %>
<% if (testimonials.length) { %>
<section class="section section-testimonials"<%- enOnly %>>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Testimonials</span>
      <h2>What clients and candidates say</h2>
    </div>
    <div class="testimonials">
      <% testimonials.forEach(function (t) { %>
        <% const initials = t.name.split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0].toUpperCase(); }).join(''); %>
        <figure class="testimonial reveal">
          <div class="stars" role="img" aria-label="<%= t.rating %> out of 5"><%= '★'.repeat(t.rating) %><span class="stars-off"><%= '★'.repeat(5 - t.rating) %></span></div>
          <blockquote>“<%= t.quote %>”</blockquote>
          <figcaption><span class="avatar" aria-hidden="true"><%= initials %></span><div><b><%= t.name %></b><% if (t.detail) { %><span class="muted small"><%= t.detail %></span><% } %></div></figcaption>
        </figure>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- 10. FAQS AND CONTACT DETAILS -->
<section class="section section-tint" id="faq"<%- enOnly %>>
  <div class="container faq-wrap">
    <div class="section-head left">
      <span class="eyebrow">FAQ</span>
      <h2>Questions, answered</h2>
      <% const real = realContact(site); const realPhone = real.phone, realWhatsapp = real.whatsapp, realAddress = real.address; %>
      <ul class="contact-lines">
        <% if (realPhone) { %><li><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg> <a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phone %></a></li><% } %>
        <% if (realWhatsapp) { %><li><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg> <a href="https://wa.me/<%= site.whatsapp %>" rel="noopener">WhatsApp us</a></li><% } %>
        <% if (site.email) { %><li><svg class="i" aria-hidden="true"><use href="#i-mail"/></svg> <a href="mailto:<%= site.email %>"><%= site.email %></a></li><% } %>
        <% if (realAddress) { %><li><svg class="i" aria-hidden="true"><use href="#i-pin"/></svg> <%= site.address %></li><% } %>
        <% if (site.hours) { %><li><svg class="i" aria-hidden="true"><use href="#i-clock"/></svg> <%= site.hours %></li><% } %>
      </ul>
      <p><a class="btn btn-outline" href="/contact">Contact us</a></p>
    </div>
    <div class="faq">
      <% [
        ['Is it free for job seekers?', 'Yes. Registering, applying and getting a job through ' + site.name + ' is always free. Nobody from ' + site.name + ' will ever ask you for money for a job; if anyone does, report it to us.'],
        ['How do I apply for a job?', 'Search for a job, open it and tap Apply. With a free profile you apply in one tap and can follow every application from your account.'],
        ['Are the jobs real?', 'Yes. Only real vacancies from employers are listed, and our team checks each one before it goes live. You can report any job that looks wrong.'],
        ['What kind of hiring do you help employers with?', 'IT recruitment, non-IT recruitment, bulk hiring and contract staffing across India, plus executive search, background verification and training.'],
        ['How quickly can you share candidates?', 'It depends on the role and the city. We agree a timeline with you at the start and keep you updated each week.'],
        ['How do employers get started?', 'Send the enquiry form above, use the full hiring form, or call or WhatsApp us. A recruiter calls you back to understand the role and agree the terms before any work starts.'],
      ].forEach(function (f, i) { %>
        <details class="faq-item"<%= i === 0 ? ' open' : '' %>>
          <summary><%= f[0] %><svg class="i"><use href="#i-plus"/></svg></summary>
          <p><%= f[1] %></p>
        </details>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
