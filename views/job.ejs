<%- include('partials/head') %>

<section class="page-hero page-hero-sm">
  <span class="deco deco-spark" aria-hidden="true"></span><span class="deco deco-dots" aria-hidden="true"></span><span class="deco deco-squiggle" aria-hidden="true"></span>
  <div class="container">
    <a href="/jobs" class="back-link">← All jobs</a>
    <div class="job-title-row">
      <div>
        <div class="chips"><span class="tag tag-<%= job.mode.toLowerCase().replace(/[^a-z]+/g, '-') %>"><%= job.mode %></span><span class="chip"><%= job.type %></span><span class="chip"><%= job.category %></span></div>
        <h1><%= job.title %></h1>
        <% const tl = typeof trustLabels !== 'undefined' ? trustLabels : null; const badge = tl && tl.company; %>
        <p class="lead"><% if (tl && tl.profileUrl) { %><a href="<%= tl.profileUrl %>"><%= job.company %></a><% } else { %><%= job.company %><% } %><% if (badge && badge.level === 'business') { %> <span class="verified" title="<%= badge.explain %>"><svg class="i" aria-hidden="true"><use href="#i-check"/></svg><%= badge.label %></span><% } else if (!badge && verifiedEmployer) { %> <span class="verified" title="A client account checked by the <%= site.name %> team"><svg class="i" aria-hidden="true"><use href="#i-check"/></svg>Verified employer</span><% } %></p>
      </div>
      <% if (live) { %><div class="job-actions"><button type="button" class="btn btn-outline btn-lg save-btn save-btn-lg" data-save-job="<%= job.id %>" aria-pressed="false"><svg class="i"><use href="#i-bookmark"/></svg><span class="save-label">Save job</span></button><a href="#apply" class="btn btn-primary btn-lg">Apply now</a></div><% } else { %><span class="pill st-rejected">No longer accepting applications</span><% } %>
    </div>
    <ul class="job-meta job-meta-lg">
      <li><svg class="i"><use href="#i-pin"/></svg><span class="sr-only">Location: </span><%= job.location %><%= stateName && stateName !== job.location ? ', ' + stateName : '' %></li>
      <% if (job.experience) { %><li><svg class="i"><use href="#i-briefcase"/></svg><span class="sr-only">Experience: </span><%= job.experience %></li><% } %>
      <li><svg class="i"><use href="#i-wallet"/></svg><span class="sr-only">Pay: </span><%= job.salary || 'Pay not disclosed' %></li>
      <li><svg class="i"><use href="#i-clock"/></svg>Posted <%= daysAgo(job.posted).toLowerCase() %></li>
      <% if (live && job.closesOn) { %><li><svg class="i"><use href="#i-clock"/></svg>Apply by <%= formatDate(job.closesOn) %></li><% } %>
    </ul>
    <% if (live) { %>
      <%# Shared links carry utm_source so Reports can show which shares bring applicants. %>
      <% const shareText = job.title + ' (' + job.location + ') – apply via ' + site.name + ': ' + canonical + '?utm_source=whatsapp'; %>
      <div class="share-row" data-share-url="<%= canonical %>?utm_source=share" data-share-title="<%= job.title %> – <%= site.name %>">
        <span class="share-label">Share this job</span>
        <a class="share-btn share-wa" href="https://wa.me/?text=<%= encodeURIComponent(shareText) %>" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp"><svg class="i"><use href="#i-whatsapp"/></svg><span>WhatsApp</span></a>
        <a class="share-btn share-li" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(canonical + '?utm_source=linkedin') %>" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn"><svg class="i"><use href="#i-linkedin"/></svg><span>LinkedIn</span></a>
        <button type="button" class="share-btn" data-copy-link aria-label="Copy link to this job"><svg class="i"><use href="#i-link"/></svg><span>Copy link</span></button>
        <button type="button" class="share-btn share-native" data-native-share hidden aria-label="More sharing options"><svg class="i"><use href="#i-share"/></svg><span>More</span></button>
      </div>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="container job-layout">
    <article class="job-body">
      <h2>About the role</h2>
      <p><%= job.description %></p>
      <% if (job.responsibilities.length) { %>
        <h2>What you'll do</h2>
        <ul class="checks"><% job.responsibilities.forEach(function (r) { %><li><%= r %></li><% }) %></ul>
      <% } %>
      <% if ((job.qualifications || []).length) { %>
        <h2>What you need</h2>
        <ul class="checks"><% job.qualifications.forEach(function (r) { %><li><%= r %></li><% }) %></ul>
      <% } %>
      <% if (job.skills.length) { %>
        <h2>Key skills</h2>
        <div class="chips chips-lg"><% job.skills.forEach(function (s) { %><span class="chip"><%= s %></span><% }) %></div>
      <% } %>
      <h2>Job details</h2>
      <dl class="job-facts">
        <div><dt>Employment type</dt><dd><%= job.type %></dd></div>
        <div><dt>Work arrangement</dt><dd><%= job.mode %></dd></div>
        <div><dt>Workplace</dt><dd><%= job.location %><%= stateName && stateName !== job.location ? ', ' + stateName : '' %></dd></div>
        <div><dt>Pay</dt><dd><%= job.salary || 'Not disclosed' %></dd></div>
        <div><dt>Experience</dt><dd><%= job.experience || 'Not specified' %></dd></div>
        <% if (job.education) { %><div><dt>Education</dt><dd><%= job.education %></dd></div><% } %>
        <% if (job.address) { %><div><dt>Address</dt><dd><%= job.address %><%= job.walkIn ? ' (walk-in interviews)' : '' %></dd></div><% } %>
        <% if (job.openings) { %><div><dt>Openings</dt><dd><%= job.openings %></dd></div><% } %>
        <% if (job.shift) { %><div><dt>Shift</dt><dd><%= job.shift %></dd></div><% } %>
        <% if (job.hours) { %><div><dt>Working hours</dt><dd><%= job.hours %></dd></div><% } %>
        <% if (job.schedule) { %><div><dt>Work schedule</dt><dd><%= job.schedule %></dd></div><% } %>
        <% if (job.overtime) { %><div><dt>Overtime</dt><dd><%= job.overtime %></dd></div><% } %>
        <% if (job.workerCosts) { %><div><dt>Costs you pay</dt><dd><%= job.workerCosts %></dd></div><% } %>
        <div><dt>Apply by</dt><dd><%= job.closesOn ? formatDate(job.closesOn) : 'Open until filled' %></dd></div>
      </dl>
      <% const needs = (job.mustHave || []).length || job.immediate || job.physical; %>
      <% if (needs) { %>
        <h2>Requirements</h2>
        <ul class="checks">
          <% (job.mustHave || []).forEach(function (r) { %><li><%= r %></li><% }) %>
          <% if (job.immediate) { %><li>Can start straight away</li><% } %>
          <% if (job.physical) { %><li>Physical work: <%= job.physical %></li><% } %>
        </ul>
      <% } %>
      <% if (match) { %>
        <section class="match-box" aria-labelledby="match-h">
          <h2 id="match-h">How you match</h2>
          <%- include('partials/match-explain', { m: match }) %>
          <p class="small">Something missing or out of date? <a href="/account/profile">Update your profile</a>. You can apply whatever the match says.</p>
        </section>
      <% } %>
      <% if ((job.eligibility || []).length) { %>
        <h2>Who can apply</h2>
        <ul class="checks"><% job.eligibility.forEach(function (b) { %><li><%= b %></li><% }) %></ul>
      <% } %>
      <% if ((job.benefits || []).length) { %>
        <h2>Benefits</h2>
        <ul class="checks"><% job.benefits.forEach(function (b) { %><li><%= b %></li><% }) %></ul>
      <% } %>
      <% if (job.createdBy === 'employer') { %>
      <h2>About applying</h2>
      <p>This job was posted by <%= job.company %> and checked by the <%= site.name %> team. Your application goes directly to the company's hiring team, who will contact you. It's free: <b>no genuine employer asks job seekers for money</b>. If anyone does, report this job below.</p>
      <% } else { %>
      <h2>Why apply through Hireriv?</h2>
      <p>You'll work with a dedicated recruiter who shares honest feedback, helps you prepare for each interview round and negotiates on your behalf. It's completely free for candidates: <b>we never ask job seekers for money</b>.</p>
      <% } %>
      <% if (tl && (tl.company || tl.listing)) { %>
      <section class="trust-labels" aria-labelledby="checks-head">
        <h2 id="checks-head">What we checked</h2>
        <ul class="checks">
          <% if (tl.company) { %><li><b><%= tl.company.label %>.</b> <%= tl.company.explain %></li><% } %>
          <% if (tl.listing) { %><li><b><%= tl.listing.label %>.</b> <%= tl.listing.explain %></li><% } %>
          <% if (tl.recruiter) { %><li><b><%= tl.recruiter.label %>.</b> <%= tl.recruiter.explain %></li><% } %>
        </ul>
        <p class="small muted"><%= tl.note %><% if (tl.profileUrl) { %> <a href="<%= tl.profileUrl %>">More about <%= job.company %></a>.<% } %></p>
      </section>
      <% } %>
      <details class="report-job" id="report">
        <summary>Report this job</summary>
        <p class="small muted">Does this listing look fake, ask for money, or have wrong details? Tell us and our team will check it within one working day.</p>
        <form class="form js-form" action="/api/jobs/<%= job.id %>/report" method="post">
          <%- include('partials/honeypot') %>
          <div class="form-grid">
            <label class="span-2">What's wrong?*
              <select name="reason" required>
                <option value="">Choose a reason…</option>
                <% reportReasons.forEach(function (r) { %><option><%= r %></option><% }) %>
              </select>
            </label>
            <label class="span-2">Details <span class="muted small">(optional)</span><textarea name="details" rows="3" maxlength="1000"></textarea></label>
            <label class="span-2">Your email <span class="muted small">(optional, if you'd like a reply)</span><input type="email" name="email" autocomplete="email"></label>
          </div>
          <button class="btn btn-outline btn-sm" type="submit">Send report</button>
        </form>
        <div class="notice" data-receipt hidden tabindex="-1" role="status"><p>Your reference is <b data-ref></b>. <a data-track href="#">Follow your report</a> (keep this link private).</p></div>
        <p class="small muted">If you have lost money or shared bank details, an OTP or a UPI PIN, report it at once on the National Cyber Crime Reporting Portal (<a href="https://cybercrime.gov.in" rel="noopener noreferrer" target="_blank">cybercrime.gov.in</a>) or call the helpline <a href="tel:1930">1930</a>, and tell your bank.</p>
      </details>
    </article>
    <aside class="form-card sticky" id="apply">
      <% if (isSample(job)) { %>
        <h2>Sample listing</h2>
        <p class="notice sample-note">This is an example that shows how jobs appear on <%= site.name %>. It isn't a real vacancy, so it isn't taking applications.</p>
        <a href="/jobs" class="btn btn-primary btn-block">See open jobs</a>
        <a href="/jobs#register" class="btn btn-outline btn-block">Send us your CV</a>
      <% } else if (!live) { %>
        <h2>This role is closed</h2>
        <p class="muted">We're no longer accepting applications for this job. Browse our open roles or send us your CV, and we'll match you to the next one.</p>
        <a href="/jobs" class="btn btn-primary btn-block">See open jobs</a>
      <% } else { %>
        <h2>Apply for this job</h2>
        <% if (msg) { %><p class="notice" role="status"><%= msg %></p><% } %>
        <% if (account && account.applied) { %>
          <p class="notice">You applied for this job on <%= formatDate(account.applied) %>.</p>
          <a href="/account" class="btn btn-primary btn-block">Track it in My account</a>
        <% } else if (account && !account.missing.length) { %>
          <div class="one-click">
            <p class="small muted">Apply with your saved profile:</p>
            <p><b><%= account.name %></b><br><span class="small"><%= account.email %> · <%= account.phone %><%= account.hasResume ? ' · resume on file' : '' %></span></p>
            <form method="post" action="/account/apply/<%= job.id %>"><button class="btn btn-primary btn-block" type="submit">Apply in one click</button></form>
            <p class="small muted">Something out of date? <a href="/account#profile">Update your profile</a> first.</p>
          </div>
        <% } else { %>
          <% if (account) { %><p class="notice small">Add <%= account.missing.join(' and ') %> to <a href="/account#profile">your profile</a> to apply in one click, or use the form below.</p><% } %>
          <%- include('partials/apply-form', { jobId: job.id, quick: quick, whatsappApply: whatsappApply }) %>
          <% if (!account) { %><p class="small muted one-click-hint">Have an account? <a href="/account/login">Sign in</a> to apply in one click. New? <a href="/account/register">Create one free</a>.</p><% } %>
        <% } %>
      <% } %>
    </aside>
  </div>
</section>

<% if (related.length) { %>
<section class="section section-tint">
  <div class="container">
    <div class="section-head row"><h2>Similar jobs</h2></div>
    <div class="jobs-grid">
      <% related.forEach(function (job) { %><%- include('partials/job-card', { job: job }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/foot') %>
