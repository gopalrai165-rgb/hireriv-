<%- include('partials/head') %>

<section class="section">
  <div class="container narrow offline-page" data-offline-page>
    <h1>You are offline</h1>
    <p class="lead">There's no internet connection right now, so this page can't load.</p>
    <ul class="plain-list">
      <li>Check that mobile data or Wi-Fi is on.</li>
      <li>Anything you were typing in a form is still in that page: go back and send it again once you're connected.</li>
      <li>Your applications, profile and messages are never stored on this device, so sign in again once you're back online to see them.</li>
    </ul>
    <p><button type="button" class="btn btn-primary btn-lg" data-retry>Try again</button></p>
  </div>
</section>

<%- include('partials/foot') %>
