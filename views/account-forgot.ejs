<%- include('partials/head') %>

<section class="section auth-section">
  <div class="container auth-wrap">
    <div class="form-card auth-card">
      <span class="eyebrow">Job-seeker account</span>
      <% if (sent) { %>
        <h1>Check your email</h1>
        <p class="notice" role="status">If there's an account for that address, a link to choose a new password is on its way. It works once and expires in 30 minutes.</p>
        <p class="small auth-links"><a href="/account/login">Back to sign in</a></p>
      <% } else { %>
        <h1>Reset your password</h1>
        <p class="muted">Enter your account's email and we'll send you a link to choose a new password.</p>
        <% if (errors.length) { %><p class="notice notice-err" role="alert"><%= errors.join(' ') %></p><% } %>
        <form class="form" method="post" action="/account/forgot">
          <div class="form-grid"><label class="span-2">Email<input type="email" name="email" required autocomplete="email"></label></div>
          <button class="btn btn-primary btn-block" type="submit">Email me a reset link</button>
        </form>
        <p class="small auth-links"><a href="/account/login">Back to sign in</a></p>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
