<% locals.translated = true; %>
<%- include('partials/head') %>

<section class="section auth-section">
  <div class="container auth-wrap">
    <div class="form-card auth-card">
      <span class="eyebrow"><%= t('account.eyebrow') %></span>
      <% if (sent) { %>
        <h1><%= t('account.checkEmail') %></h1>
        <p class="notice" role="status"><%= t('account.resetSent') %></p>
        <p class="small auth-links"><a href="/account/login"><%= t('account.backToSignIn') %></a></p>
      <% } else { %>
        <h1><%= t('account.resetTitle') %></h1>
        <p class="muted"><%= t('account.resetText') %></p>
        <% if (errors.length) { %><p class="notice notice-err" role="alert"><%= errors.map(function (e) { return tm(e); }).join(' ') %></p><% } %>
        <form class="form" method="post" action="/account/forgot">
          <div class="form-grid"><label class="span-2"><%= t('account.email') %><input type="email" name="email" required autocomplete="email"></label></div>
          <button class="btn btn-primary btn-block" type="submit"><%= t('account.resetButton') %></button>
        </form>
        <p class="small auth-links"><a href="/account/login"><%= t('account.backToSignIn') %></a></p>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
