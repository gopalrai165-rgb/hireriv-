<%- include('partials/head') %>
<% const real = realContact(site); %>

<section class="page-hero employers-hero">
  <span class="deco deco-spark" aria-hidden="true"></span>
  <div class="container split">
    <div>
      <span class="eyebrow">For employers</span>
      <h1>Hire the Right Talent. <span class="grad">Faster.</span></h1>
      <p class="lead">Your recruitment partner for skilled professionals, bulk hiring and staffing solutions across India.</p>
      <ul class="pill-row" aria-label="What we offer">
        <li><a href="/services/permanent-staffing">Permanent Hiring</a></li>
        <li><a href="/services/contract-staffing">Contract Staffing</a></li>
        <li><a href="/services/bulk-rpo-hiring">Bulk Recruitment</a></li>
      </ul>
    </div>
    <div class="callback-card">
      <h2>Need employees for your business?</h2>
      <p>Tell us your hiring requirements. Our team will contact you.</p>
      <a class="btn btn-accent btn-lg btn-block" href="#enquiry">Request a Callback</a>
      <a class="btn btn-outline btn-block" href="/company-profile">Our company profile (PDF)</a>
      <% if (real.whatsapp) { %>
        <a class="btn btn-whatsapp btn-block" href="https://wa.me/<%= real.whatsapp %>?text=<%= encodeURIComponent('Hi ' + site.name + ', I would like to hire employees.') %>" rel="noopener"><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg> Enquire on WhatsApp</a>
        <p class="small muted">Opens WhatsApp with a message to <%= site.name %>. Your WhatsApp number and name are shared with us only if you send it.</p>
      <% } %>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="svc-h">
  <div class="container">
    <div class="section-head center"><h2 id="svc-h">Our recruitment services</h2></div>
    <div class="services-grid services-grid-4">
      <% [['Find suitable long-term employees.'], ['Flexible workforce for business needs.'], ['Recruit multiple employees efficiently.'], ['Find experienced professionals.']].forEach(function (line, i) { const s = services[i]; %>
        <a class="service-card service-link" href="/services/<%= s.slug %>">
          <span class="service-icon"><svg class="i"><use href="#<%= s.icon %>"/></svg></span>
          <h3><%= ['Permanent Staffing', 'Contract Staffing', 'Bulk Hiring', 'Executive Search'][i] %></h3>
          <p><%= line[0] %></p>
          <span class="card-link">How it works and pricing <svg class="i"><use href="#i-arrow"/></svg></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section-tint" aria-labelledby="how-h">
  <div class="container">
    <div class="section-head center"><h2 id="how-h">How it works</h2></div>
    <ol class="how-steps">
      <li><span class="how-num" aria-hidden="true">1</span><svg class="i" aria-hidden="true"><use href="#i-mail"/></svg><b>Share your hiring requirements.</b></li>
      <li><span class="how-num" aria-hidden="true">2</span><svg class="i" aria-hidden="true"><use href="#i-users"/></svg><b>We shortlist suitable candidates.</b></li>
      <li><span class="how-num" aria-hidden="true">3</span><svg class="i" aria-hidden="true"><use href="#i-check"/></svg><b>You interview and select candidates.</b></li>
      <li><span class="how-num" aria-hidden="true">4</span><svg class="i" aria-hidden="true"><use href="#i-briefcase"/></svg><b>We support the recruitment process.</b></li>
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="price-h">
  <div class="container">
    <div class="section-head center">
      <h2 id="price-h">How pricing works</h2>
      <p>Every requirement is different, so we send you a written quote before any work starts.</p>
    </div>
    <div class="table-wrap guide-table">
      <table>
        <% const priced = pricedServices.some(function (p) { return priceOf(site, p.slug); }); %>
        <thead><tr><th>Service</th><th>How you pay</th><% if (priced) { %><th>Starting from</th><% } %></tr></thead>
        <tbody>
          <% pricedServices.forEach(function (p) { %>
            <tr><td><%= p.name %></td><td><%= p.how %></td><% if (priced) { %><td><%= priceOf(site, p.slug) || 'On request' %></td><% } %></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="center small">Replacement policy, payment terms and refunds: <a href="/service-terms">Service terms</a>.</p>
    <% if (priced) { %><p class="center muted small">Starting prices exclude GST. Your written quote depends on the roles, numbers and locations.</p><% } %>
    <p class="center"><a class="btn btn-primary" href="#enquiry">Request a Quote</a></p>
  </div>
</section>

<% if (recruitCities().length) { %>
<section class="section" aria-labelledby="cities-h">
  <div class="container center">
    <h2 id="cities-h" class="h3">Where we recruit</h2>
    <ul class="pill-row center-row"><% recruitCities().forEach(function (c) { %><li><a href="/recruitment-agency/<%= c.slug %>">Recruitment in <%= c.name %></a></li><% }) %></ul>
  </div>
</section>
<% } %>

<section class="section section-tint" id="enquiry" aria-labelledby="enquiry-h">
  <div class="container split enquiry-split">
    <div>
      <span class="eyebrow">Employer enquiry</span>
      <h2 id="enquiry-h">Let's discuss your hiring needs</h2>
      <p>Get in touch with the <%= site.name %> recruitment team. We call you back within one working day, and you get a confirmation email straight away.</p>
      <ul class="contact-lines">
        <% if (real.phone) { %><li><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg> <a href="tel:<%= real.phone.replace(/\s/g, '') %>"><%= real.phone %></a></li><% } %>
        <li><svg class="i" aria-hidden="true"><use href="#i-mail"/></svg> <a href="mailto:<%= site.email %>"><%= site.email %></a></li>
        <% if (site.hours) { %><li><svg class="i" aria-hidden="true"><use href="#i-clock"/></svg> <%= site.hours %></li><% } %>
      </ul>
    </div>
    <%- include('partials/employer-enquiry-form') %>
  </div>
</section>

<%- include('partials/foot') %>
