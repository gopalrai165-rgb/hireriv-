<%- include('partials/head') %>
<%# Only facts: the company details, background and team come from Admin → Settings → About the company. %>
<% const co = companyOf(site); const real = realContact(site); %>

<section class="page-hero">
  <span class="deco deco-spark" aria-hidden="true"></span>
  <div class="container split">
    <div>
      <span class="eyebrow">About us</span>
      <h1><%= site.name %> helps <span class="grad">employers and job seekers</span> find each other</h1>
      <p class="lead"><%= site.name %> is a recruitment and staffing service for IT and non-IT hiring across India, operated by <%= co.operator %>.</p>
      <div class="hero-ctas">
        <a href="/hire" class="btn btn-primary btn-lg">Hire a Team <svg class="i"><use href="#i-arrow"/></svg></a>
        <a href="/jobs" class="btn btn-outline btn-lg">Find Work</a>
      </div>
    </div>
    <div class="about-collage" aria-hidden="true">
      <span class="deco deco-ring"></span>
      <span class="deco deco-spark violet"></span>
      <figure><img src="/img/photos/about-team.webp" alt="" width="900" height="1000"></figure>
      <figure><img src="/img/photos/about-office.webp" alt="" width="600" height="600"></figure>
      <figure><img src="/img/photos/about-meeting.webp" alt="" width="600" height="600" loading="lazy"></figure>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="company-h">
  <div class="container split">
    <div>
      <span class="eyebrow">The company</span>
      <h2 id="company-h">Who we are</h2>
      <% if (co.story) { %>
        <% co.story.split(/\n\s*\n/).forEach(function (para) { %><p><%= para %></p><% }) %>
      <% } else { %>
        <p><%= site.name %> is run by <%= co.operator %>. We help employers fill IT and non-IT roles, through permanent recruitment, bulk hiring and contract staffing, and we help job seekers find real vacancies and apply for free.</p>
        <p>Every job on this site is checked by our team before it goes live, and job seekers never pay us anything.</p>
      <% } %>
    </div>
    <dl class="company-facts">
      <div><dt>Operated by</dt><dd><%= co.operator %></dd></div>
      <% if (co.cin) { %><div><dt>CIN</dt><dd><%= co.cin %></dd></div><% } %>
      <% if (site.billing && site.billing.gstin) { %><div><dt>GSTIN</dt><dd><%= site.billing.gstin %></dd></div><% } %>
      <% if (co.founded) { %><div><dt>Founded</dt><dd><%= co.founded %></dd></div><% } %>
      <% if (real.address) { %><div><dt>Office</dt><dd><%= real.address %><% if (site.hours) { %><br><span class="muted small"><%= site.hours %></span><% } %></dd></div><% } %>
      <div><dt>Email</dt><dd><a href="mailto:<%= site.email %>"><%= site.email %></a></dd></div>
      <% if (real.phone) { %><div><dt>Phone</dt><dd><a href="tel:<%= real.phone.replace(/\s/g, '') %>"><%= real.phone %></a></dd></div><% } %>
      <% if (real.whatsapp) { %><div><dt>WhatsApp</dt><dd><a href="https://wa.me/<%= real.whatsapp %>" rel="noopener">Chat with us</a></dd></div><% } %>
    </dl>
  </div>
</section>

<%- include('partials/figures') %>

<section class="section" aria-labelledby="do-h">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">What we do</span>
      <h2 id="do-h">Recruitment we can deliver today</h2>
    </div>
    <% if (co.capabilities.length) { %>
      <ul class="checks about-capabilities"><% co.capabilities.forEach(function (c) { %><li><%= c %></li><% }) %></ul>
    <% } %>
    <div class="services-grid">
      <% catalog.PRIORITY_SERVICES.forEach(function (s) { %>
        <a class="service-card service-link" href="/services/<%= s.slug %>"><span class="service-icon"><svg class="i"><use href="#<%= s.icon %>"/></svg></span><h3><%= s.name %></h3><p><%= s.card %></p></a>
      <% }) %>
    </div>
  </div>
</section>

<% if (co.team.length) { %>
<section class="section section-tint" aria-labelledby="team-h">
  <div class="container">
    <div class="section-head"><span class="eyebrow">Our team</span><h2 id="team-h">The people you will work with</h2></div>
    <ul class="team-grid">
      <% co.team.forEach(function (m) { %>
        <li class="team-card"><span class="avatar" aria-hidden="true"><%= m.name.split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0].toUpperCase(); }).join('') %></span><div><b><%= m.name %></b><span class="muted small"><%= m.role %></span><% if (m.bio) { %><p class="small"><%= m.bio %></p><% } %></div></li>
      <% }) %>
    </ul>
  </div>
</section>
<% } %>

<section class="section" aria-labelledby="values-h">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">How we work</span>
      <h2 id="values-h">What you can expect from us</h2>
    </div>
    <div class="services-grid">
      <div class="service-card"><span class="service-icon"><svg class="i"><use href="#i-users"/></svg></span><h3>Free for job seekers</h3><p>We never charge candidates. Anyone asking you for money for a job in our name is not us: report it.</p></div>
      <div class="service-card"><span class="service-icon"><svg class="i"><use href="#i-shield"/></svg></span><h3>Real jobs only</h3><p>Every listing is checked before it goes live, and we remove jobs that are filled or look wrong.</p></div>
      <div class="service-card"><span class="service-icon"><svg class="i"><use href="#i-chart"/></svg></span><h3>Clear terms</h3><p>Employers agree the fee and the replacement terms in writing before we start.</p></div>
    </div>
  </div>
</section>

<% const quotes = testimonialsFor(site); %>
<% if (quotes.length) { %>
<section class="section section-tint" aria-labelledby="feedback-h">
  <div class="container">
    <div class="section-head"><span class="eyebrow">Client feedback</span><h2 id="feedback-h">What clients and candidates say</h2></div>
    <div class="testimonials">
      <% quotes.forEach(function (q) { %><figure class="testimonial"><blockquote>“<%= q.quote %>”</blockquote><figcaption><b><%= q.name %></b><% if (q.detail) { %> <span class="muted small"><%= q.detail %></span><% } %></figcaption></figure><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="cta-band">
  <div class="container cta-inner">
    <div><h2>Let's work together</h2><p>Hiring, or looking for your next role? We'd love to hear from you.</p></div>
    <div class="cta-actions">
      <a href="/hire" class="btn btn-light btn-lg">Hire a Team</a>
      <a href="/jobs" class="btn btn-ghost-light btn-lg">Find Work</a>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
