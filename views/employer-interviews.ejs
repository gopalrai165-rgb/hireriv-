<%- include('partials/head') %>

<section class="section admin portal">
  <div class="container">
    <%- include('partials/employer-nav', { heading: 'Interviews', tab: 'interviews' }) %>

    <% if (todo) { %>
      <p class="small">Showing: <b><%= todo %></b> · <a href="/employer/interviews">Show all interviews</a></p>
      <% if (todoKey === 'feedback' && !due.length) { %><p class="muted dash-empty">Nothing waiting for your feedback.</p><% } %>
      <% if (todoKey === 'reschedule' && !upcoming.length) { %><p class="muted dash-empty">No candidate is waiting for a new time.</p><% } %>
    <% } %>
    <% if (due.length) { %>
      <section class="dash-card" id="feedback-due">
        <div class="dash-head"><h2>Feedback due <span class="muted">(<%= due.length %>)</span></h2><span class="muted small">Write it while the interview is fresh</span></div>
        <ul class="activity">
          <% due.forEach(function (iv) { %><li><a class="activity-row" href="/employer/applicants/<%= iv.appId %>#interviews"><span class="pill st-screening">Feedback due</span><span class="activity-text"><b><%= iv.candidate %></b> · <%= iv.jobTitle %><%= iv.interviewer ? ' · ' + iv.interviewer : '' %></span><span class="muted small"><%= formatIst(iv.at) %></span></a></li><% }) %>
        </ul>
      </section>
    <% } %>

    <% if (!todo || (todoKey === 'reschedule' && upcoming.length)) { %>
    <section class="dash-card">
      <div class="dash-head"><h2>Upcoming</h2><span class="muted small"><%= todoKey === 'reschedule' ? "Open the applicant to choose a new time; they'll be asked to confirm it" : "Schedule interviews from an applicant's page" %></span></div>
      <% if (!upcoming.length) { %><p class="muted dash-empty">No interviews booked.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="cards-on-phone">
            <thead><tr><th>When (India time)</th><th>Candidate</th><th>Job</th><th>Format</th><th>Interviewer</th><th>Candidate's answer</th></tr></thead>
            <tbody>
              <% upcoming.forEach(function (iv) { %>
                <tr><td><b><%= formatIst(iv.at) %></b><br><span class="muted small"><%= iv.duration %> minutes</span></td><td><a href="/employer/applicants/<%= iv.appId %>#interviews"><%= iv.candidate %></a></td><td><%= iv.jobTitle %></td><td><%= iv.mode %></td><td><%= iv.interviewer || '—' %></td><td><% if (iv.confirmation === 'reschedule-requested') { %><span class="pill st-on-hold">Asked for another time</span><% if (iv.candidateNote) { %><br><span class="small">“<%= iv.candidateNote %>”</span><% } %><% } else if (iv.confirmation === 'confirmed') { %><span class="pill st-hired">Confirmed</span><% } else if (iv.confirmation === 'awaiting') { %><span class="muted small">Not answered yet</span><% } %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <% if (past.length) { %>
      <section class="dash-card">
        <div class="dash-head"><h2>Past and cancelled</h2></div>
        <ul class="activity">
          <% past.forEach(function (iv) { const fs = iv.status === 'cancelled' ? null : feedbackSummary(iv); %><li><span class="activity-row"><span class="pill <%= iv.status === 'cancelled' ? 'st-rejected' : 'st-hired' %>"><%= iv.status === 'cancelled' ? 'Cancelled' : 'Finished' %></span><span class="activity-text"><a href="/employer/applicants/<%= iv.appId %>#interviews"><%= iv.candidate %></a><br><span class="small"><%= iv.jobTitle %><% if (fs) { %> · <b><%= fs.recommendation %></b>, <%= fs.avg %>/5<%= fs.count > 1 ? ' (' + fs.count + ' scorecards)' : '' %><% } else if (iv.status !== 'cancelled') { %> · <span class="muted">no feedback yet</span><% } %></span></span><span class="muted small"><%= formatIst(iv.at) %></span></span></li><% }) %>
        </ul>
      </section>
    <% } %>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
