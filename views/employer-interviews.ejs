<%- include('partials/head') %>

<section class="section admin portal">
  <div class="container">
    <%- include('partials/employer-nav', { heading: 'Interviews', tab: 'interviews' }) %>

    <section class="dash-card">
      <div class="dash-head"><h2>Upcoming</h2><span class="muted small">Schedule interviews from an applicant's page</span></div>
      <% if (!upcoming.length) { %><p class="muted dash-empty">No interviews booked.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="cards-on-phone">
            <thead><tr><th>When (India time)</th><th>Candidate</th><th>Job</th><th>Format</th><th>Interviewer</th></tr></thead>
            <tbody>
              <% upcoming.forEach(function (iv) { %>
                <tr><td><b><%= formatIst(iv.at) %></b><br><span class="muted small"><%= iv.duration %> minutes</span></td><td><a href="/employer/applicants/<%= iv.appId %>"><%= iv.candidate %></a></td><td><%= iv.jobTitle %></td><td><%= iv.mode %></td><td><%= iv.interviewer || '—' %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <% if (past.length) { %>
      <section class="dash-card">
        <div class="dash-head"><h2>Past and cancelled</h2></div>
        <ul class="activity">
          <% past.forEach(function (iv) { %><li><span class="activity-row"><span class="pill"><%= iv.status %></span><span class="activity-text"><a href="/employer/applicants/<%= iv.appId %>"><%= iv.candidate %></a> · <%= iv.jobTitle %></span><span class="muted small"><%= formatIst(iv.at) %></span></span></li><% }) %>
        </ul>
      </section>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
