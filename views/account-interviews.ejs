<%- include('partials/head') %>

<section class="section admin portal">
  <div class="container">
    <%- include('partials/account-nav', { heading: 'Interviews' }) %>
    <% offers.forEach(function (o) { %>
      <section class="dash-card dash-wide iv-choose" id="choose">
        <h2>Choose a time for your interview</h2>
        <p><b><%= o.jobTitle %></b><%= o.company ? ' at ' + o.company : '' %> · <%= o.f.mode %>, <%= o.f.duration %> minutes<%= o.f.where && o.f.mode !== 'Phone call' ? ' · ' + o.f.where : '' %></p>
        <% if (o.f.message) { %><p class="small muted"><%= o.f.message %></p><% } %>
        <form method="post" action="/account/interviews/<%= o.appId %>/choose">
          <input type="hidden" name="offerId" value="<%= o.offerId %>">
          <fieldset><legend class="small muted">Pick the one that suits you (India time)</legend>
            <% o.slots.forEach(function (at, i) { %><label class="iv-slot"><input type="radio" name="at" value="<%= at %>"<%= i === 0 ? ' required' : '' %>> <span><%= formatIst(at) %></span></label><% }) %>
          </fieldset>
          <button class="btn btn-primary" type="submit">Book this time</button>
        </form>
        <p class="small muted">None of these work? Reply to the employer's email or call them; never pay anyone to get an interview.</p>
      </section>
    <% }) %>
    <section class="dash-card dash-wide">
      <div class="dash-head"><h2>Coming up</h2></div>
      <p class="small">Getting ready? <a href="/interview-tips">Interview tips: what to bring, what they ask and what to say</a>.</p>
      <% if (!upcoming.length) { %>
        <p class="muted dash-empty">No interviews scheduled. When a recruiter books one, it appears here and we email you the details.</p>
      <% } else { %>
        <ul class="entry-list">
          <% upcoming.forEach(function (iv) { %>
            <li>
              <div>
                <b><%= iv.jobTitle %></b>
                <br><span><%= formatIst(iv.at) %> · <%= iv.duration %> min · <%= iv.mode %></span>
                <% if (/^https:\/\//.test(iv.where)) { %><br><a href="<%= iv.where %>" target="_blank" rel="noopener noreferrer">Join link</a><% } else if (iv.where) { %><br><span class="small"><%= iv.where %></span><% } %>
                <% if (iv.confirmation === 'awaiting') { %>
                  <br><span class="pill st-screening">Please confirm</span>
                <% } else if (iv.confirmation === 'reschedule-requested') { %>
                  <br><span class="pill st-on-hold">You asked for another time</span><% if (iv.candidateNote) { %> <span class="muted small">“<%= iv.candidateNote %>”</span><% } %>
                <% } else if (iv.confirmation === 'confirmed') { %>
                  <br><span class="pill st-hired">Confirmed</span>
                <% } %>
                <% if (iv.confirmation && iv.confirmation !== 'confirmed') { %>
                  <div class="row-actions iv-answer">
                    <form method="post" action="/account/interviews/<%= iv.appId %>/<%= iv.id %>/confirm"><button class="btn btn-primary btn-sm" type="submit">I'll be there</button></form>
                    <details><summary class="small">Ask for another time</summary>
                      <form class="form" method="post" action="/account/interviews/<%= iv.appId %>/<%= iv.id %>/reschedule">
                        <label class="small">Which days and times suit you?<input name="note" maxlength="300" required placeholder="e.g. Any weekday after 3 pm"></label>
                        <button class="btn btn-outline btn-sm" type="submit">Send</button>
                      </form>
                    </details>
                  </div>
                <% } %>
              </div>
              <a class="btn btn-outline btn-sm" href="/account/interviews/<%= iv.appId %>/<%= iv.id %>.ics">Add to calendar</a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
    <% if (past.length) { %>
      <section class="dash-card dash-wide">
        <div class="dash-head"><h2>Earlier</h2></div>
        <ul class="entry-list">
          <% past.forEach(function (iv) { %>
            <li><div><b><%= iv.jobTitle %></b><br><span class="muted small"><%= formatIst(iv.at) %> · <%= iv.status === 'cancelled' ? 'Cancelled' : 'Done' %></span></div></li>
          <% }) %>
        </ul>
      </section>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
