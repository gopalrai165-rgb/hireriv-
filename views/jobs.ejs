<%- include('partials/head') %>

<section class="page-hero">
  <span class="deco deco-spark" aria-hidden="true"></span><span class="deco deco-dots" aria-hidden="true"></span><span class="deco deco-squiggle" aria-hidden="true"></span>
  <div class="container">
    <span class="eyebrow">Find jobs</span>
    <h1>Find your next role</h1>
    <p class="lead">Hand-picked openings with verified employers. Apply in two minutes, and a real recruiter will get back to you.</p>
    <form class="job-filters" action="/jobs" method="get" role="search">
      <div class="filter-search">
        <svg class="i"><use href="#i-search"/></svg>
        <label class="sr-only" for="f-q">Keyword</label>
        <input id="f-q" name="q" value="<%= filters.q %>" placeholder="Job title, skill, company or keyword">
      </div>
      <label class="sr-only" for="f-loc">Location</label>
      <select id="f-loc" name="location">
        <option value="">All of India</option>
        <option value="Remote" <%= filters.location === 'Remote' ? 'selected' : '' %>>Remote / work from home</option>
        <optgroup label="States">
          <% states.forEach(function (st) { %><option value="<%= st %>" <%= filters.location === st ? 'selected' : '' %>><%= st %></option><% }) %>
        </optgroup>
        <optgroup label="Cities">
          <% locations.filter(function (l) { return l !== 'Remote'; }).forEach(function (l) { %><option value="<%= l %>" <%= filters.location === l ? 'selected' : '' %>><%= l %> (<%= locationCounts[l] || 0 %>)</option><% }) %>
        </optgroup>
      </select>
      <button class="btn btn-primary" type="submit">Search</button>
      <div class="filter-row">
        <details class="filter-cats"<%- filters.categories.length ? ' open' : '' %>>
          <summary>Categories<% if (filters.categories.length) { %> <span class="count"><%= filters.categories.length %></span><% } %></summary>
          <div class="filter-cats-panel">
            <% categoryGroups.forEach(function (g) { %>
              <fieldset>
                <legend><%= g.label %></legend>
                <% g.categories.forEach(function (c) { %><label class="check-row"><input type="checkbox" name="category" value="<%= c %>"<%= filters.categories.includes(c) ? ' checked' : '' %>> <span><%= c %> <span class="muted">(<%= categoryCounts[c] || 0 %>)</span></span></label><% }) %>
              </fieldset>
            <% }) %>
          </div>
        </details>
        <label class="sr-only" for="f-exp">Experience</label>
        <select id="f-exp" name="experience">
          <option value="">Any experience</option>
          <% experienceLevels.forEach(function (l) { %><option value="<%= l.key %>" <%= filters.experience === l.key ? 'selected' : '' %>><%= l.label %></option><% }) %>
        </select>
        <label class="sr-only" for="f-pay">Minimum pay</label>
        <select id="f-pay" name="minPay">
          <option value="">Any pay</option>
          <% minPayOptions.forEach(function (o) { %><option value="<%= o.value %>" <%= filters.minPay === o.value ? 'selected' : '' %>><%= o.label %></option><% }) %>
        </select>
        <label class="sr-only" for="f-type">Job type</label>
        <select id="f-type" name="type">
          <option value="">Any job type</option>
          <% jobTypes.forEach(function (t) { %><option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t %> (<%= typeCounts[t] || 0 %>)</option><% }) %>
        </select>
        <label class="sr-only" for="f-mode">Work arrangement</label>
        <select id="f-mode" name="mode">
          <option value="">Any work arrangement</option>
          <% modes.forEach(function (m) { %><option value="<%= m %>" <%= filters.mode === m ? 'selected' : '' %>><%= m %> (<%= modeCounts[m] || 0 %>)</option><% }) %>
        </select>
        <label class="sr-only" for="f-sort">Sort by</label>
        <select id="f-sort" name="sort">
          <option value="relevance" <%= sort === 'relevance' ? 'selected' : '' %>>Sort: most relevant</option>
          <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Sort: newest</option>
          <option value="salary" <%= sort === 'salary' ? 'selected' : '' %>>Sort: highest pay</option>
        </select>
      </div>
      <% if (filters.work) { %><input type="hidden" name="work" value="<%= filters.work %>"><% } %>
      <% if (filters.group) { %><input type="hidden" name="group" value="<%= filters.group %>"><% } %>
    </form>
    <% const withWork = function (key) { const q = Object.assign({}, filters, { work: key, category: filters.categories, categories: '', minPay: filters.minPay || '', sort: filters.sort }); return '/jobs?' + Object.keys(q).filter(function (k) { return q[k] && (!Array.isArray(q[k]) || q[k].length); }).map(function (k) { return [].concat(q[k]).map(function (v) { return k + '=' + encodeURIComponent(v); }).join('&'); }).join('&'); }; %>
    <nav class="work-tabs" aria-label="Kind of work">
      <a href="<%= withWork('').replace(/\?$/, '') %>"<%- !filters.work ? ' aria-current="page"' : '' %>>All work</a>
      <% workKinds.forEach(function (c) { %><a href="<%= withWork(c.key) %>" title="<%= c.examples %>"<%- filters.work === c.key ? ' aria-current="page"' : '' %>><%= c.label %> <span class="count"><%= workCounts[c.key] || 0 %></span></a><% }) %>
    </nav>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="results-head">
      <p><b><%= pager.total %></b> <%= pager.total === 1 ? 'job' : 'jobs' %> found<% if (group) { %> in <b><%= group.label %></b><% } %></p>
      <% if (active.length) { %><a href="/jobs" class="small">Clear all filters</a><% } %>
    </div>
    <% if (results.length) { %>
      <div class="jobs-grid">
        <% results.forEach(function (job) { %><%- include('partials/job-card', { job: job }) %><% }) %>
      </div>
      <%- include('partials/pager', { pager: pager, pagerLabel: 'Job result pages' }) %>
    <% } else { %>
      <div class="empty" role="status">
        <h3>No jobs match <%= active.length ? 'all of these filters' : 'right now' %></h3>
        <% if (active.length) { %>
          <p>Try removing a filter:</p>
          <ul class="active-filters">
            <% active.forEach(function (a) { %><li><a href="<%= a.href %>" aria-label="Remove filter: <%= a.label %>"><%= a.label %> <span aria-hidden="true">×</span></a></li><% }) %>
          </ul>
          <p><a href="/jobs" class="btn btn-outline btn-sm">Clear all filters</a></p>
        <% } %>
        <p>New roles come in every week. <a href="#alerts">Get a job alert</a>, or send us your CV below and we'll reach out when something fits.</p>
      </div>
    <% } %>
  </div>
</section>

<section class="section section-alert" id="alerts">
  <div class="container">
    <div class="alert-band">
      <div class="alert-copy">
        <span class="alert-icon"><svg class="i"><use href="#i-mail"/></svg></span>
        <div>
          <h2>Get new jobs by email</h2>
          <p class="muted">Be the first to apply. We'll email you as soon as a matching role is posted. No spam, unsubscribe any time.</p>
        </div>
      </div>
      <form class="form js-form alert-form" action="/api/job-alerts" method="post">
  <%- include('partials/honeypot') %>
        <label class="sr-only" for="a-email">Email</label>
        <input id="a-email" type="email" name="email" required autocomplete="email" placeholder="Your email">
        <label class="sr-only" for="a-cat">Category</label>
        <select id="a-cat" name="category">
          <option value="">All categories</option>
          <% categoryGroups.forEach(function (g) { %><optgroup label="<%= g.label %>"><% g.categories.forEach(function (c) { %><option <%= filters.category === c ? 'selected' : '' %>><%= c %></option><% }) %></optgroup><% }) %>
        </select>
        <label class="sr-only" for="a-loc">Location</label>
        <select id="a-loc" name="location">
          <option value="">Any location</option>
          <% locations.forEach(function (l) { %><option <%= filters.location === l ? 'selected' : '' %>><%= l %></option><% }) %>
        </select>
        <button class="btn btn-accent" type="submit">Create alert</button>
      </form>
    </div>
  </div>
</section>

<section class="section section-tint" id="register">
  <div class="container split">
    <div>
      <span class="eyebrow">Can't find the right role?</span>
      <h2>Submit your CV to our talent network</h2>
      <p class="lead-sm">Most of our roles are filled before they're ever advertised. Register once and our recruiters will match you with openings that fit your skills, salary expectations and preferred location.</p>
      <ul class="checks">
        <li>Free for candidates, always</li>
        <li>Resume and interview feedback from recruiters</li>
        <li>Your details are shared only with your consent</li>
      </ul>
    </div>
    <div class="form-card">
      <p class="small muted register-note">Want to apply in one click next time? <a href="/account/register">Create a free account</a> instead.</p>
      <%- include('partials/apply-form', { jobId: 'general' }) %>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
