<%- include('partials/head') %>

<section class="page-hero page-hero-search">
  <span class="deco deco-spark" aria-hidden="true"></span><span class="deco deco-dots" aria-hidden="true"></span><span class="deco deco-squiggle" aria-hidden="true"></span>
  <div class="container">
    <span class="eyebrow"><%= t('jobs.eyebrow') %></span>
    <h1><%= t('jobs.title') %></h1>
    <p class="lead"><%= t('jobs.lead') %></p>
    <form class="job-filters" action="/jobs" method="get" role="search">
      <div class="filter-search">
        <svg class="i" aria-hidden="true"><use href="#i-search"/></svg>
        <label class="sr-only" for="f-q"><%= t('jobs.keyword') %></label>
        <input id="f-q" name="q" type="search" autocomplete="off" data-suggest value="<%= filters.q %>" placeholder="<%= t('jobs.keywordPlaceholder') %>" aria-describedby="f-q-hint" enterkeyhint="search">
        <% if (voiceInput) { %><button type="button" class="voice-btn" data-voice-for="f-q" hidden aria-label="<%= t('jobs.voiceSearch') %>" title="<%= t('jobs.voiceSearch') %>"><svg class="i" aria-hidden="true"><use href="#i-mic"/></svg></button><% } %>
      </div>
      <label class="sr-only" for="f-loc"><%= t('jobs.location') %></label>
      <select id="f-loc" name="location">
        <option value=""><%= t('jobs.allIndia') %></option>
        <option value="Remote" <%= filters.location === 'Remote' ? 'selected' : '' %>><%= t('jobs.remote') %></option>
        <optgroup label="<%= t('jobs.states') %>">
          <% states.forEach(function (st) { %><option value="<%= st %>" <%= filters.location === st ? 'selected' : '' %>><%= st %></option><% }) %>
        </optgroup>
        <optgroup label="<%= t('jobs.cities') %>">
          <% locations.filter(function (l) { return l !== 'Remote'; }).forEach(function (l) { %><option value="<%= l %>" <%= filters.location === l ? 'selected' : '' %>><%= l %> (<%= locationCounts[l] || 0 %>)</option><% }) %>
        </optgroup>
      </select>
      <button class="btn btn-primary" type="submit"><%= t('jobs.search') %></button>
      <p class="filter-hint small" id="f-q-hint"><%= t('jobs.keywordHint') %></p>
      <% const placed = near && !near.error; const gps = placed && near.kind === 'gps'; %>
      <div class="near-row">
        <label for="f-near"><svg class="i" aria-hidden="true"><use href="#i-pin"/></svg> <%= t('near.label') %></label>
        <% if (gps) { %>
          <input type="hidden" name="near" value="<%= near.value %>">
          <span class="near-using"><%= t('near.usingLocation') %></span>
        <% } else { %>
          <input id="f-near" name="near" value="<%= filters.near %>" maxlength="40" placeholder="<%= t('near.placeholder') %>" autocomplete="postal-code" aria-describedby="f-near-hint"<%- near && near.error ? ' aria-invalid="true"' : '' %>>
        <% } %>
        <label class="sr-only" for="f-within"><%= t('near.within') %></label>
        <select id="f-within" name="within">
          <option value=""><%= t('near.anyDistance') %></option>
          <% radii.forEach(function (r) { %><option value="<%= r %>" <%= filters.within === r ? 'selected' : '' %>><%= t('near.withinKm', { km: r }) %></option><% }) %>
        </select>
        <button type="button" class="btn btn-outline btn-sm" data-near-me hidden><svg class="i" aria-hidden="true"><use href="#i-pin"/></svg> <%= t('near.useLocation') %></button>
        <span id="f-near-hint" class="sr-only"><%= t('near.hint') %></span>
      </div>
      <% if (near && near.error) { %><p class="notice notice-err small" role="alert"><%= t('near.' + near.error, { pin: near.pin || '' }) %></p><% } %>
      <p class="near-status small" role="status" data-near-status></p>
      <% const moreCount = filters.categories.length + ['experience', 'minPay', 'type', 'mode', 'shift', 'english', 'walkin', 'education', 'company'].filter(function (k) { return filters[k]; }).length + ((filters.skills || []).length ? 1 : 0) + (filters.perks || []).length + (filters.without || []).length; %>
      <details class="more-filters" open data-more-filters="<%= moreCount %>">
      <summary><%= t('jobs.filtersSummary') %><% if (moreCount) { %> <span class="count"><%= moreCount %></span><% } %></summary>
      <div class="filter-row">
        <details class="filter-cats"<%- filters.categories.length ? ' open' : '' %>>
          <summary><%= t('jobs.categories') %><% if (filters.categories.length) { %> <span class="count"><%= filters.categories.length %></span><% } %></summary>
          <div class="filter-cats-panel">
            <% categoryGroups.forEach(function (g) { %>
              <fieldset>
                <legend><%= tv('work', g.key) === g.key ? g.label : tv('work', g.key) %></legend>
                <% g.categories.forEach(function (c) { %><label class="check-row"><input type="checkbox" name="category" value="<%= c %>"<%= filters.categories.includes(c) ? ' checked' : '' %>> <span><%= tv('category', c) %> <span class="muted">(<%= categoryCounts[c] || 0 %>)</span></span></label><% }) %>
              </fieldset>
            <% }) %>
          </div>
        </details>
        <label class="sr-only" for="f-exp"><%= t('jobs.experience') %></label>
        <select id="f-exp" name="experience">
          <option value=""><%= t('jobs.anyExperience') %></option>
          <% experienceLevels.forEach(function (l) { %><option value="<%= l.key %>" <%= filters.experience === l.key ? 'selected' : '' %>><%= tv('level', l.key) === l.key ? l.label : tv('level', l.key) %></option><% }) %>
        </select>
        <label class="sr-only" for="f-pay"><%= t('jobs.minPay') %></label>
        <select id="f-pay" name="minPay">
          <option value=""><%= t('jobs.anyPay') %></option>
          <% minPayOptions.forEach(function (o) { %><option value="<%= o.value %>" <%= filters.minPay === o.value ? 'selected' : '' %>><%= o.label %></option><% }) %>
        </select>
        <label class="sr-only" for="f-type"><%= t('jobs.jobType') %></label>
        <select id="f-type" name="type">
          <option value=""><%= t('jobs.anyJobType') %></option>
          <% jobTypes.forEach(function (jt) { %><option value="<%= jt %>" <%= filters.type === jt ? 'selected' : '' %>><%= tv('type', jt) %> (<%= typeCounts[jt] || 0 %>)</option><% }) %>
        </select>
        <label class="sr-only" for="f-mode"><%= t('jobs.arrangement') %></label>
        <select id="f-mode" name="mode">
          <option value=""><%= t('jobs.anyArrangement') %></option>
          <% modes.forEach(function (m) { %><option value="<%= m %>" <%= filters.mode === m ? 'selected' : '' %>><%= tv('mode', m) %> (<%= modeCounts[m] || 0 %>)</option><% }) %>
        </select>
        <label class="sr-only" for="f-shift"><%= t('jobs.shift') %></label>
        <select id="f-shift" name="shift">
          <option value=""><%= t('jobs.anyShift') %></option>
          <% shifts.forEach(function (sh) { %><option value="<%= sh %>" <%= filters.shift === sh ? 'selected' : '' %>><%= t('jobs.shiftOption', { shift: tv('shift', sh) }) %></option><% }) %>
        </select>
        <label class="sr-only" for="f-english"><%= t('jobs.english') %></label>
        <select id="f-english" name="english">
          <option value=""><%= t('jobs.anyEnglish') %></option>
          <% englishLevels.forEach(function (l) { %><option value="<%= l.toLowerCase() %>" <%= filters.english === l.toLowerCase() ? 'selected' : '' %>><%= t('jobs.englishOption', { level: t('needs.english' + l) }) %></option><% }) %>
        </select>
        <label class="sr-only" for="f-education"><%= t('jobs.education') %></label>
        <select id="f-education" name="education">
          <option value=""><%= t('jobs.anyEducation') %></option>
          <% educationLevels.forEach(function (k) { %><option value="<%= k %>" <%= filters.education === k ? 'selected' : '' %>><%= t('jobs.educationOption', { level: t('needs.edu_' + k) }) %></option><% }) %>
        </select>
        <label class="check-row filter-check"><input type="checkbox" name="walkin" value="1"<%= filters.walkin ? ' checked' : '' %>> <span><%= t('jobs.walkInOnly') %></span></label>
        <fieldset class="filter-perks"><legend><%= t('jobs.perks') %> <span class="muted small">(<%= t('jobs.perksHint') %>)</span></legend>
          <% perkKeys.forEach(function (p) { %><label class="check-row filter-check"><input type="checkbox" name="perk" value="<%= p %>"<%= (filters.perks || []).includes(p) ? ' checked' : '' %>> <span><%= t('needs.perk_' + p) %></span></label><% }) %>
        </fieldset>
        <fieldset class="filter-perks"><legend><%= t('jobs.without') %> <span class="muted small">(<%= t('jobs.withoutHint') %>)</span></legend>
          <% itemKeys.forEach(function (k) { %><label class="check-row filter-check"><input type="checkbox" name="without" value="<%= k %>"<%= (filters.without || []).includes(k) ? ' checked' : '' %>> <span><%= t('needs.item_' + k) %></span></label><% }) %>
        </fieldset>
        <label class="sr-only" for="f-company"><%= t('jobs.company') %></label>
        <select id="f-company" name="company">
          <option value=""><%= t('jobs.anyCompany') %></option>
          <% companies.forEach(function (c) { %><option <%= filters.company && filters.company.toLowerCase() === c.toLowerCase() ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
        <label class="filter-skills"><span class="sr-only"><%= t('jobs.skills') %></span><input id="f-skills" name="skills" value="<%= (filters.skills || []).join(', ') %>" placeholder="<%= t('jobs.skillsPlaceholder') %>" maxlength="200" aria-describedby="f-skills-hint"></label>
        <span id="f-skills-hint" class="sr-only"><%= t('jobs.skillsHint') %></span>
        <label class="sr-only" for="f-sort"><%= t('jobs.sortBy') %></label>
        <select id="f-sort" name="sort">
          <option value="relevance" <%= sort === 'relevance' ? 'selected' : '' %>><%= t('jobs.sortRelevance') %></option>
          <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>><%= t('jobs.sortNewest') %></option>
          <option value="salary" <%= sort === 'salary' ? 'selected' : '' %>><%= t('jobs.sortPay') %></option>
          <% if (near && !near.error) { %><option value="distance" <%= sort === 'distance' ? 'selected' : '' %>><%= t('near.sortNearest') %></option><% } %>
        </select>
        <button class="btn btn-primary more-filters-apply" type="submit"><%= t('jobs.showJobs') %></button>
      </div>
      </details>
      <% if (filters.work) { %><input type="hidden" name="work" value="<%= filters.work %>"><% } %>
      <% if (filters.group) { %><input type="hidden" name="group" value="<%= filters.group %>"><% } %>
    </form>
    <% const withWork = function (key) { const q = Object.assign({}, filters, { work: key, category: filters.categories, categories: '', minPay: filters.minPay || '', sort: filters.sort }); return '/jobs?' + Object.keys(q).filter(function (k) { return q[k] && (!Array.isArray(q[k]) || q[k].length); }).map(function (k) { return [].concat(q[k]).map(function (v) { return k + '=' + encodeURIComponent(v); }).join('&'); }).join('&'); }; %>
    <nav class="work-tabs" aria-label="<%= t('jobs.kindOfWork') %>">
      <a href="<%= withWork('').replace(/\?$/, '') %>"<%- !filters.work ? ' aria-current="page"' : '' %>><%= t('jobs.allWork') %></a>
      <% workKinds.forEach(function (c) { %><a href="<%= withWork(c.key) %>" title="<%= tv('workExamples', c.key) === c.key ? c.examples : tv('workExamples', c.key) %>"<%- filters.work === c.key ? ' aria-current="page"' : '' %>><%= tv('work', c.key) === c.key ? c.label : tv('work', c.key) %> <span class="count"><%= workCounts[c.key] || 0 %></span></a><% }) %>
    </nav>
  </div>
</section>

<section class="section section-results">
  <div class="container">
    <div class="results-head">
      <p><%- th('jobs.found', { count: pager.total, num: html('<b>' + pager.total + '</b>') }) %><% if (group) { %> <%- th('jobs.foundIn', { group: html('<b>' + esc(tv('group', group.key) === group.key ? group.label : tv('group', group.key)) + '</b>') }) %><% } %></p>
      <div class="row-actions">
        <% if (canSaveSearch) { %>
          <form class="form save-search" method="post" action="/account/saved-searches">
            <% Object.keys(savedSearchQuery).forEach(function (k) { [].concat(savedSearchQuery[k]).filter(function (v) { return v !== '' && v !== null && v !== undefined && k !== 'sort'; }).forEach(function (v) { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }); }); %>
            <input type="hidden" name="frequency" value="daily">
            <button class="btn btn-outline btn-sm" type="submit"><svg class="i" aria-hidden="true"><use href="#i-bookmark"/></svg> <%= t('jobs.saveSearch') %></button>
          </form>
        <% } else { %>
          <a class="small" href="/account/login?next=<%= encodeURIComponent('/jobs') %>"><%= t('jobs.signInToSave') %></a>
        <% } %>
        <% if (active.length) { %><a href="/jobs" class="small"><%= t('jobs.clearAll') %></a><% } %>
      </div>
    </div>
    <% if (near && !near.error) { %><p class="muted small near-showing"><svg class="i" aria-hidden="true"><use href="#i-pin"/></svg> <%= t(filters.within ? 'near.showingWithin' : 'near.showing', { place: near.kind === 'gps' ? t('near.yourLocation') : near.label, km: filters.within }) %> <a href="<%= active.length && active[active.length - 1].href %>"><%= t('near.clear') %></a></p><% } %>
    <% if (understood && (understood.q || understood.place)) { %><p class="muted small"><%= understood.q ? t('jobs.translatedQuery', { q: understood.q }) : '' %><%= understood.place ? ' ' + t('jobs.translatedPlace', { place: understood.place }) : '' %></p><% } %>
    <% if (corrected) { %><p class="notice" role="status"><%- th('jobs.corrected', { from: corrected.from, to: html('<b>“' + esc(corrected.to) + '”</b>') }) %></p><% } %>
    <% if (results.length) { %>
      <div class="jobs-grid">
        <% results.forEach(function (job) { %><%- include('partials/job-card', { job: job }) %><% }) %>
      </div>
      <%- include('partials/pager', { pager: pager, pagerLabel: t('jobs.resultPages') }) %>
    <% } else { %>
      <div class="empty" role="status">
        <h3><%= active.length ? t('jobs.noneFiltered') : t('jobs.noneNow') %></h3>
        <% if (active.length) { %>
          <p><%= t('jobs.tryRemoving') %></p>
          <ul class="active-filters">
            <% active.forEach(function (a) { %><li><a href="<%= a.href %>" aria-label="<%= t('jobs.removeFilter', { label: a.label }) %>"><%= a.label %> <span aria-hidden="true">×</span></a></li><% }) %>
          </ul>
          <p><a href="/jobs" class="btn btn-outline btn-sm"><%= t('jobs.clearAll') %></a></p>
        <% } %>
        <p><%= t('jobs.newRoles') %> <a href="#alerts"><%= t('jobs.getAlert') %></a>, <%= t('jobs.orSendCv') %></p>
      </div>
    <% } %>
  </div>
</section>

<section class="section section-alert" id="alerts">
  <div class="container">
    <div class="alert-band">
      <div class="alert-copy">
        <span class="alert-icon"><svg class="i" aria-hidden="true"><use href="#i-mail"/></svg></span>
        <div>
          <h2><%= t('jobs.alertTitle') %></h2>
          <p class="muted"><%= t('jobs.alertText') %></p>
        </div>
      </div>
      <form class="form js-form alert-form" action="/api/job-alerts" method="post">
  <%- include('partials/honeypot') %>
        <label class="sr-only" for="a-email"><%= t('jobs.alertEmail') %></label>
        <input id="a-email" type="email" name="email" required autocomplete="email" placeholder="<%= t('jobs.alertEmailPlaceholder') %>">
        <label class="sr-only" for="a-cat"><%= t('jobs.alertCategory') %></label>
        <select id="a-cat" name="category">
          <option value=""><%= t('jobs.allCategories') %></option>
          <% categoryGroups.forEach(function (g) { %><optgroup label="<%= tv('work', g.key) === g.key ? g.label : tv('work', g.key) %>"><% g.categories.forEach(function (c) { %><option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= tv('category', c) %></option><% }) %></optgroup><% }) %>
        </select>
        <label class="sr-only" for="a-loc"><%= t('jobs.location') %></label>
        <select id="a-loc" name="location">
          <option value=""><%= t('jobs.anyLocation') %></option>
          <% locations.forEach(function (l) { %><option <%= filters.location === l ? 'selected' : '' %>><%= l %></option><% }) %>
        </select>
        <button class="btn btn-accent" type="submit"><%= t('jobs.createAlert') %></button>
      </form>
    </div>
  </div>
</section>

<section class="section section-tint" id="register">
  <div class="container split">
    <div>
      <span class="eyebrow"><%= t('jobs.cvEyebrow') %></span>
      <h2><%= t('jobs.cvTitle') %></h2>
      <p class="lead-sm"><%= t('jobs.cvLead') %></p>
      <ul class="checks">
        <li><%= t('jobs.cvPoint1') %></li>
        <li><%= t('jobs.cvPoint2') %></li>
        <li><%= t('jobs.cvPoint3') %></li>
      </ul>
    </div>
    <div class="form-card">
      <p class="small muted register-note"><%= t('jobs.cvAccount') %> <a href="/account/register"><%= t('jobs.cvAccountLink') %></a> <%= t('jobs.cvAccountAfter') %></p>
      <%- include('partials/apply-form', { jobId: 'general' }) %>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
